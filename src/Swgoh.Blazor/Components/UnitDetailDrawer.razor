@if (IsOpen)
{
    <div class="unit-detail-backdrop" @onclick="HandleCloseAsync">
        <aside class="unit-detail-drawer" role="dialog" aria-modal="true" aria-labelledby="unit-detail-title" @onclick:stopPropagation>
            <div class="unit-detail-topbar">
                <div>
                    <span class="eyebrow">@Eyebrow</span>
                    <small>@((Unit?.IsShip ?? Summary?.IsShip ?? false) ? "Nave" : "Personaje")</small>
                </div>
                <button type="button" class="unit-detail-close" aria-label="Cerrar detalle" @onclick="HandleCloseAsync">×</button>
            </div>

            <div class="unit-detail-hero">
                <div class="unit-detail-portrait-shell @((Unit?.IsShip ?? Summary?.IsShip ?? false) ? "unit-detail-portrait-ship" : string.Empty)">
                    <span class="unit-detail-portrait-fallback" aria-hidden="true">@Initial(Name)</span>
                    @if (PortraitUrl is not null)
                    {
                        <img class="unit-detail-portrait"
                             src="@PortraitUrl"
                             alt="Retrato de @Name"
                             loading="eager"
                             decoding="async"
                             referrerpolicy="no-referrer"
                             onerror="this.style.display='none'" />
                    }
                </div>
                <div class="unit-detail-identity">
                    <h2 id="unit-detail-title">@Name</h2>
                    <span>@DefinitionId</span>
                    @if (Unit is not null)
                    {
                        <div class="unit-detail-stars" aria-label="@Unit.Rarity estrellas">@RarityLabel(Unit.Rarity)</div>
                    }
                    else if (Summary?.IsGalacticLegend == true)
                    {
                        <span class="unit-detail-gl">Leyenda galáctica</span>
                    }
                </div>
            </div>

            @if (IsLoading)
            {
                <div class="unit-detail-loading"><span class="spinner"></span> Cargando ficha completa…</div>
            }

            <section class="unit-detail-section">
                <div class="unit-detail-section-heading">
                    <span class="section-kicker">Progreso</span>
                    <h3>Estado actual</h3>
                </div>
                <div class="unit-detail-stats">
                    <div><span>GP</span><strong>@GalacticPower.ToString("N0")</strong></div>
                    <div><span>Progreso</span><strong>@ProgressLabel</strong></div>
                    @if (Unit is not null)
                    {
                        <div><span>Nivel</span><strong>@Unit.Level</strong></div>
                        <div><span>Estrellas</span><strong>@Unit.Rarity/7</strong></div>
                        @if (!Unit.IsShip)
                        {
                            <div><span>Mods</span><strong>@Unit.EquippedModCount/6</strong></div>
                        }
                    }
                    <div><span>Zetas</span><strong>@ZetaCount</strong></div>
                    <div><span>Omicrons</span><strong>@OmicronCount</strong></div>
                </div>
            </section>

            @if (Unit?.Stats is not null)
            {
                <section class="unit-detail-section">
                    <div class="unit-detail-section-heading">
                        <span class="section-kicker">Stats reales</span>
                        <h3>Con mods aplicados</h3>
                    </div>
                    <div class="unit-detail-stats">
                        @if (Unit.Stats.Speed is decimal speed)
                        {
                            <div><span>Velocidad</span><strong>@FormatNumber(speed)</strong></div>
                        }
                        @if (Unit.Stats.Health is decimal health)
                        {
                            <div><span>Salud</span><strong>@FormatNumber(health)</strong></div>
                        }
                        @if (Unit.Stats.Protection is decimal protection)
                        {
                            <div><span>Protección</span><strong>@FormatNumber(protection)</strong></div>
                        }
                        @if (Unit.Stats.PhysicalDamage is decimal physicalDamage)
                        {
                            <div><span>Daño físico</span><strong>@FormatNumber(physicalDamage)</strong></div>
                        }
                        @if (Unit.Stats.SpecialDamage is decimal specialDamage)
                        {
                            <div><span>Daño especial</span><strong>@FormatNumber(specialDamage)</strong></div>
                        }
                        @if (Unit.Stats.Armor is decimal armor)
                        {
                            <div><span>Armadura</span><strong>@FormatPercentOrNumber(armor)</strong></div>
                        }
                        @if (Unit.Stats.Resistance is decimal resistance)
                        {
                            <div><span>Resistencia</span><strong>@FormatPercentOrNumber(resistance)</strong></div>
                        }
                        @if (Unit.Stats.Potency is decimal potency)
                        {
                            <div><span>Potencia</span><strong>@FormatPercent(potency)</strong></div>
                        }
                        @if (Unit.Stats.Tenacity is decimal tenacity)
                        {
                            <div><span>Tenacidad</span><strong>@FormatPercent(tenacity)</strong></div>
                        }
                        @if (Unit.Stats.CriticalDamage is decimal criticalDamage)
                        {
                            <div><span>Daño crítico</span><strong>@FormatPercent(criticalDamage)</strong></div>
                        }
                    </div>
                </section>
            }

            @if (Unit?.Mods is not null && !Unit.IsShip)
            {
                <section class="unit-detail-section unit-detail-tactical">
                    <div class="unit-detail-section-heading">
                        <span class="section-kicker">Mods</span>
                        <h3>Calidad táctica</h3>
                    </div>
                    <div class="unit-detail-stats">
                        <div><span>Equipados</span><strong>@Unit.Mods.EquippedCount/6</strong></div>
                        <div><span>6 puntos</span><strong>@Unit.Mods.SixDotCount</strong></div>
                        <div><span>Set velocidad</span><strong>@Unit.Mods.SpeedSetModCount</strong></div>
                        <div><span>Primaria velocidad</span><strong>@Unit.Mods.SpeedPrimaryCount</strong></div>
                        @if (Unit.Mods.SpeedBonus is decimal speedBonus)
                        {
                            <div><span>Velocidad en mods</span><strong>+@FormatNumber(speedBonus)</strong></div>
                        }
                    </div>
                    @if (!Unit.Mods.IsComplete)
                    {
                        <p class="unit-detail-context">El personaje no lleva los seis mods equipados; el optimizador penaliza ligeramente su preparación táctica.</p>
                    }
                </section>
            }

            @if (Unit is not null && Unit.Factions.Count > 0)
            {
                <section class="unit-detail-section">
                    <div class="unit-detail-section-heading">
                        <span class="section-kicker">Sinergias</span>
                        <h3>Facciones</h3>
                    </div>
                    <div class="unit-detail-factions">
                        @foreach (string faction in Unit.Factions)
                        {
                            <span>@faction</span>
                        }
                    </div>
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(ContextTitle) || TacticalNotes.Count > 0)
            {
                <section class="unit-detail-section unit-detail-tactical">
                    <div class="unit-detail-section-heading">
                        <span class="section-kicker">Contexto táctico</span>
                        <h3>@(string.IsNullOrWhiteSpace(ContextTitle) ? "Gran Arena" : ContextTitle)</h3>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Context))
                    {
                        <p class="unit-detail-context">@Context</p>
                    }
                    @if (TacticalNotes.Count > 0)
                    {
                        <div class="unit-detail-notes">
                            @foreach (string note in TacticalNotes)
                            {
                                <div><span>→</span><p>@note</p></div>
                            }
                        </div>
                    }
                </section>
            }

            <div class="unit-detail-actions">
                @if (RosterAllyCode is not null)
                {
                    <a class="ghost-button button-link" href="@($"/player/{RosterAllyCode.Value}")">Abrir roster</a>
                }
                @if (GacAllyCode is not null)
                {
                    <a class="secondary-button button-link" href="@($"/gac/{GacAllyCode.Value}")">Ir a War Room</a>
                }
            </div>
        </aside>
    </div>
}

@code {
    private const string AssetBaseUrl = "https://game-assets.swgoh.gg/textures/";

    [Parameter]
    public PlayerApiClient.RosterUnitViewModel? Unit { get; set; }

    [Parameter]
    public GacApiClient.BattleUnitViewModel? Summary { get; set; }

    [Parameter]
    public string Eyebrow { get; set; } = "Ficha de unidad";

    [Parameter]
    public string? ContextTitle { get; set; }

    [Parameter]
    public string? Context { get; set; }

    [Parameter]
    public IReadOnlyCollection<string> TacticalNotes { get; set; } = [];

    [Parameter]
    public long? RosterAllyCode { get; set; }

    [Parameter]
    public long? GacAllyCode { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private bool IsOpen => Unit is not null || Summary is not null;

    private string Name => Unit?.Name ?? Summary?.Name ?? "Unidad";

    private string DefinitionId => Unit?.DefinitionId ?? Summary?.DefinitionId ?? "—";

    private long GalacticPower => Unit?.GalacticPower ?? Summary?.GalacticPower ?? 0;

    private int ZetaCount => Unit?.ZetaCount ?? Summary?.ZetaCount ?? 0;

    private int OmicronCount => Unit?.OmicronCount ?? Summary?.OmicronCount ?? 0;

    private string ProgressLabel
    {
        get
        {
            if (Unit is not null)
            {
                return Unit.IsShip
                    ? $"{Unit.Rarity}★"
                    : Unit.RelicTier > 0 ? $"R{Unit.RelicTier}" : $"G{Unit.GearTier}";
            }

            if (Summary is null)
            {
                return "—";
            }

            return Summary.IsShip ? "Nave" : $"R{Summary.RelicTier}";
        }
    }

    private string? PortraitUrl => GetPortraitUrl(Unit?.ThumbnailName);

    private async Task HandleCloseAsync() => await OnClose.InvokeAsync();

    private static string? GetPortraitUrl(string? thumbnailName)
    {
        if (string.IsNullOrWhiteSpace(thumbnailName))
        {
            return null;
        }

        string assetName = thumbnailName.Trim();
        if (!assetName.EndsWith(".png", StringComparison.OrdinalIgnoreCase))
        {
            assetName += ".png";
        }

        return AssetBaseUrl + Uri.EscapeDataString(assetName);
    }

    private static string FormatNumber(decimal value) => Math.Round(value).ToString("N0");

    private static string FormatPercent(decimal value) => $"{(value <= 2m ? value * 100m : value):0.#}%";

    private static string FormatPercentOrNumber(decimal value) => value <= 2m
        ? FormatPercent(value)
        : FormatNumber(value);

    private static string Initial(string name) => string.IsNullOrWhiteSpace(name)
        ? "?"
        : char.ToUpperInvariant(name.Trim()[0]).ToString();

    private static string RarityLabel(int rarity) => new('★', Math.Clamp(rarity, 0, 7));
}
