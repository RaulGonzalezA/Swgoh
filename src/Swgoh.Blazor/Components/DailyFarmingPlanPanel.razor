@using Swgoh.Blazor.Clients
@using Swgoh.Blazor.State
@inject DailyFarmingPlanApiClient DailyFarmingClient
@inject PlayerPreferenceService PreferenceService

@if (!_loading && _plan is not null && (_plan.ActiveTargetCount > 0 || !Compact))
{
    <section class="daily-farm @(Compact ? "compact" : string.Empty)">
        <div class="daily-farm-heading">
            <div>
                <span class="section-kicker">Plan diario de farmeo</span>
                <h2>@(Compact ? "Qué gastar hoy" : "Qué hacer hoy con cada energía")</h2>
                <p>@_plan.Summary</p>
            </div>
            @if (!Compact)
            {
                <div class="daily-farm-summary">
                    <span><strong>@_plan.ActiveTargetCount</strong> objetivos</span>
                    <span><strong>@_plan.MissingResourceTypes</strong> déficits</span>
                    <span><strong>@_plan.FullyEstimatedTargetCount</strong> ETA completas</span>
                </div>
            }
        </div>

        @if (Compact)
        {
            <div class="daily-budget-compact">
                <strong>@_plan.CrystalBudget.ProfileLabel</strong>
                <span>@CompactBudgetSummary</span>
            </div>
        }
        else
        {
            <section class="daily-budget">
                <div class="daily-budget-heading">
                    <div>
                        <span class="section-kicker">Presupuesto de cristales</span>
                        <h3>@_plan.CrystalBudget.ProfileLabel</h3>
                        <p>El presupuesto es un máximo diario. El plan solo compra refreshes cuando existe una granja de energía modelada que los justifique.</p>
                    </div>
                    <div class="daily-budget-totals">
                        <span><strong>@_plan.CrystalBudget.CrystalsSpent</strong> gastar</span>
                        <span><strong>@_plan.CrystalBudget.CrystalsUnspent</strong> reservar</span>
                        <span><strong>+@_plan.CrystalBudget.EnergyGained</strong> energía</span>
                    </div>
                </div>

                <div class="daily-budget-controls" aria-label="Presupuesto diario de cristales">
                    @foreach (int preset in BudgetPresets)
                    {
                        <button type="button"
                                class="daily-budget-preset @(_crystalBudget == preset ? "selected" : string.Empty)"
                                @onclick="() => SetBudgetAsync(preset)">
                            @BudgetPresetLabel(preset)
                        </button>
                    }
                    <label class="daily-budget-custom">
                        <span>Personalizado</span>
                        <input type="number"
                               min="0"
                               max="5000"
                               step="50"
                               value="@_crystalBudget"
                               @onchange="OnCustomBudgetChangedAsync" />
                    </label>
                </div>

                @if (_plan.CrystalBudget.Refreshes.Count == 0)
                {
                    <div class="daily-farm-notice">
                        <strong>@(_crystalBudget == 0 ? "Perfil F2P" : "Cristales reservados")</strong>
                        <span>@(_crystalBudget == 0
                            ? "No se recomiendan refreshes de pago."
                            : "No hay un refresh justificable con los farms de energía que el modelo conoce ahora mismo.")</span>
                    </div>
                }
                else
                {
                    <div class="daily-refresh-grid">
                        @foreach (DailyFarmingPlanApiClient.RefreshRecommendationViewModel refresh in _plan.CrystalBudget.Refreshes)
                        {
                            <article>
                                <span>@refresh.ChannelLabel</span>
                                <strong>@refresh.RefreshCount refresh@(refresh.RefreshCount == 1 ? string.Empty : "es")</strong>
                                <small>@refresh.CrystalCost cristales · +@refresh.EnergyGained energía</small>
                                <small>@refresh.BaselineFreeEnergy gratis → @refresh.PlannedDailyEnergy planificados</small>
                                @if (refresh.NextRefreshCost is int nextCost)
                                {
                                    <small>Siguiente refresh: @nextCost cristales</small>
                                }
                                <p>@refresh.Reason</p>
                            </article>
                        }
                    </div>
                }
            </section>

            <div class="daily-energy-grid">
                @foreach (DailyFarmingPlanApiClient.EnergyBaselineViewModel baseline in _plan.EnergyBaselines)
                {
                    <article>
                        <span>@baseline.Label</span>
                        <strong>@baseline.BaselineFreeEnergy</strong>
                        <small>@baseline.RegenerationPerDay regen + @baseline.BonusEnergyPerDay bonus</small>
                    </article>
                }
            </div>
        }

        @if (!_plan.HasInventorySnapshot)
        {
            <div class="daily-farm-notice">
                <strong>Déficit todavía aproximado</strong>
                <span>Actualiza el inventario para convertir requisitos en faltantes exactos.</span>
            </div>
        }

        @if (!Compact && _plan.TargetEtas.Count > 0)
        {
            <section class="daily-eta">
                <div class="daily-eta-heading">
                    <div>
                        <span class="section-kicker">Previsión de objetivos</span>
                        <h3>Cuándo podrías llegar</h3>
                        <p>La fecha es conservadora y usa el presupuesto diario actual. Solo se considera completa cuando todos los bloqueos pendientes tienen una cadencia modelada.</p>
                    </div>
                    <div class="daily-eta-summary">
                        <span><strong>@_plan.ReadyNowTargetCount</strong> listos ahora</span>
                        <span><strong>@_plan.FullyEstimatedTargetCount</strong> con ETA completa</span>
                    </div>
                </div>

                <div class="daily-eta-grid">
                    @foreach (DailyFarmingPlanApiClient.TargetEtaViewModel target in _plan.TargetEtas)
                    {
                        <article class="@TargetEtaCss(target)">
                            <div class="daily-eta-title">
                                <span>@TargetEtaLabel(target)</span>
                                <h4>@target.Name</h4>
                            </div>

                            @if (target.ReadyNow)
                            {
                                <strong>Disponible ahora</strong>
                            }
                            else if (target.FullEstimateAvailable
                                && target.EstimatedDays is int days
                                && target.EstimatedCompletionAtUtc is DateTimeOffset completion)
                            {
                                <strong>~@days día@(days == 1 ? string.Empty : "s") · @FormatEtaDate(completion)</strong>
                            }
                            else if (target.KnownBottleneckCompletionAtUtc is DateTimeOffset knownDate)
                            {
                                <strong>Parte modelada: @FormatEtaDate(knownDate)</strong>
                            }
                            else
                            {
                                <strong>Sin fecha fiable todavía</strong>
                            }

                            <p>@target.Summary</p>
                            <small>
                                @target.ModeledBlockingResourceTypes bloqueos modelados ·
                                @target.UnknownBlockingResourceTypes sin ETA
                            </small>
                        </article>
                    }
                </div>
            </section>
        }

        <div class="daily-farm-actions">
            @foreach (DailyFarmingPlanApiClient.ActionViewModel action in VisibleActions)
            {
                <article class="daily-farm-action priority-@PriorityCss(action.Priority)">
                    <div class="daily-farm-rank">#@action.Rank</div>
                    <div class="daily-farm-action-main">
                        <div class="daily-farm-action-title">
                            <div>
                                <span>@action.ChannelLabel · @action.PrecisionLabel</span>
                                <h3>@action.Title</h3>
                            </div>
                            @if (action.Missing is long missing)
                            {
                                <strong>faltan @missing.ToString("N0")</strong>
                            }
                        </div>

                        <p>@action.Action</p>
                        <div class="daily-farm-facts">
                            <span><strong>Fuente:</strong> @action.Source</span>
                            @if (action.EnergyCostPerAttempt is int energyCost)
                            {
                                <span><strong>Coste:</strong> @energyCost energía/intento</span>
                            }
                            @if (action.BaselineFreeEnergy is int baseline)
                            {
                                <span><strong>Base diaria:</strong> @baseline gratis teóricos</span>
                            }
                            @if (action.ResourceId is not null)
                            {
                                <span><strong>Afecta:</strong> @action.AffectedTargetCount objetivo@(action.AffectedTargetCount == 1 ? string.Empty : "s")</span>
                            }
                            @if (action.SharedBottleneck)
                            {
                                <span class="daily-farm-shared">Cuello de botella compartido</span>
                            }
                        </div>

                        @if (!Compact)
                        {
                            <small class="daily-farm-stop">@action.StopCondition</small>
                        }
                    </div>
                </article>
            }
        </div>

        @if (Compact)
        {
            <a class="daily-farm-more" href="@($"/investments/{AllyCode}")">Abrir plan diario y presupuesto →</a>
        }
        else
        {
            <p class="daily-farm-limitation">@_plan.Limitation</p>
        }
    </section>
}
else if (!_loading && _error is not null && !Compact)
{
    <UiCard Kicker="Plan diario" Title="No se pudo calcular">
        <p>@_error</p>
    </UiCard>
}

@code {
    private static readonly int[] BudgetPresets = [0, 50, 150, 300];

    [Parameter, EditorRequired] public long AllyCode { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public long RefreshToken { get; set; }

    private bool _loading = true;
    private string? _error;
    private long? _loadedAllyCode;
    private long _loadedRefreshToken = long.MinValue;
    private int _crystalBudget;
    private int _loadedCrystalBudget = int.MinValue;
    private DailyFarmingPlanApiClient.DailyFarmingPlanViewModel? _plan;

    private IReadOnlyCollection<DailyFarmingPlanApiClient.ActionViewModel> VisibleActions =>
        _plan is null
            ? []
            : Compact
                ? [.. _plan.Actions.Take(3)]
                : _plan.Actions;

    private string CompactBudgetSummary => _plan?.CrystalBudget switch
    {
        null => string.Empty,
        { DailyCrystalBudget: 0 } => "sin refreshes de pago",
        { CrystalsSpent: 0 } budget => $"{budget.DailyCrystalBudget} cristales reservados · sin gasto justificado",
        var budget => $"{budget.CrystalsSpent} cristales · {budget.RefreshCount} refreshes · +{budget.EnergyGained} energía"
    };

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            int? savedBudget = await PreferenceService.GetDailyCrystalBudgetAsync(AllyCode);
            if (savedBudget is int budget && budget != _crystalBudget)
            {
                _crystalBudget = budget;
                await LoadAsync(force: true);
                StateHasChanged();
            }
        }
        catch (InvalidOperationException)
        {
            // Local preference is optional; the F2P default remains valid.
        }
    }

    private async Task LoadAsync(bool force = false)
    {
        if (!force
            && _loadedAllyCode == AllyCode
            && _loadedRefreshToken == RefreshToken
            && _loadedCrystalBudget == _crystalBudget)
        {
            return;
        }

        _loadedAllyCode = AllyCode;
        _loadedRefreshToken = RefreshToken;
        _loadedCrystalBudget = _crystalBudget;
        _loading = true;
        _error = null;
        try
        {
            _plan = await DailyFarmingClient.GetAsync(AllyCode, _crystalBudget);
        }
        catch (Exception exception)
        {
            _error = $"No se pudo cargar el plan diario: {exception.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SetBudgetAsync(int budget)
    {
        int normalized = Math.Clamp(budget, 0, 5_000);
        _crystalBudget = normalized;
        await PreferenceService.SetDailyCrystalBudgetAsync(AllyCode, normalized);
        await LoadAsync(force: true);
    }

    private async Task OnCustomBudgetChangedAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out int budget))
        {
            await SetBudgetAsync(budget);
        }
    }

    private static string BudgetPresetLabel(int budget) => budget switch
    {
        0 => "F2P",
        50 => "50 / día",
        150 => "150 / día",
        300 => "300 / día",
        _ => $"{budget} / día"
    };

    private static string FormatEtaDate(DateTimeOffset value) => value.ToString("dd/MM/yyyy");

    private static string TargetEtaLabel(DailyFarmingPlanApiClient.TargetEtaViewModel target) =>
        target.ReadyNow
            ? "Materiales cubiertos"
            : target.FullEstimateAvailable
                ? "ETA conservadora"
                : target.KnownBottleneckCompletionAtUtc is not null
                    ? "ETA parcial"
                    : "Pendiente de datos";

    private static string TargetEtaCss(DailyFarmingPlanApiClient.TargetEtaViewModel target) =>
        target.ReadyNow
            ? "ready"
            : target.FullEstimateAvailable
                ? "estimated"
                : "partial";

    private static string PriorityCss(string priority) => priority switch
    {
        "Crítica" => "critical",
        "Alta" => "high",
        "Media" => "medium",
        _ => "normal"
    };
}
