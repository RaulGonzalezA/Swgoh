@inherits LayoutComponentBase
@implements IDisposable
@using Swgoh.Blazor.State
@inject PlayerSessionState Session
@inject PlayerContextService PlayerContext
@inject NavigationManager Navigation

<div class="command-shell">
    <aside class="command-sidebar" aria-label="Navegación principal">
        <a class="command-brand" href="/" aria-label="SWGOH Assistant - inicio">
            <span class="command-brand-mark" aria-hidden="true">S</span>
            <span>
                <strong>SWGOH Assistant</strong>
                <small>Plan · Optimize · Win</small>
            </span>
        </a>

        <nav class="command-nav">
            <NavLink href="/" Match="NavLinkMatch.All">
                <span class="command-nav-icon" aria-hidden="true">⌂</span>
                <span>Inicio</span>
            </NavLink>

            <span class="command-nav-section">Juego</span>
            @if (NavigationAllyCode is long allyCode)
            {
                <NavLink href="@($"/player/{allyCode}")" Match="NavLinkMatch.All">
                    <span class="command-nav-icon" aria-hidden="true">R</span>
                    <span>Roster</span>
                </NavLink>
                <NavLink href="@($"/gac/{allyCode}")" Match="NavLinkMatch.All">
                    <span class="command-nav-icon" aria-hidden="true">G</span>
                    <span>GAC</span>
                </NavLink>
                <NavLink href="@($"/gac/{allyCode}/planner")" Match="NavLinkMatch.All">
                    <span class="command-nav-icon" aria-hidden="true">P</span>
                    <span>Planner</span>
                </NavLink>
                <NavLink href="@($"/gac/{allyCode}/strategy")" Match="NavLinkMatch.All">
                    <span class="command-nav-icon" aria-hidden="true">E</span>
                    <span>Estrategia</span>
                </NavLink>
                <NavLink href="@($"/gac/{allyCode}/round-optimizer")" Match="NavLinkMatch.All">
                    <span class="command-nav-icon" aria-hidden="true">O</span>
                    <span>Round Optimizer</span>
                </NavLink>
                <NavLink href="@($"/conquest/{allyCode}")" Match="NavLinkMatch.All">
                    <span class="command-nav-icon" aria-hidden="true">C</span>
                    <span>Conquista</span>
                </NavLink>
                <NavLink href="@($"/territory-battles/{allyCode}/rise-of-the-empire")" Match="NavLinkMatch.All">
                    <span class="command-nav-icon" aria-hidden="true">T</span>
                    <span>RotE</span>
                </NavLink>
            }
            else
            {
                <span class="command-nav-disabled"><span class="command-nav-icon">R</span>Roster</span>
                <span class="command-nav-disabled"><span class="command-nav-icon">G</span>GAC</span>
                <span class="command-nav-disabled"><span class="command-nav-icon">P</span>Planner</span>
                <span class="command-nav-disabled"><span class="command-nav-icon">E</span>Estrategia</span>
                <span class="command-nav-disabled"><span class="command-nav-icon">O</span>Round Optimizer</span>
                <span class="command-nav-disabled"><span class="command-nav-icon">C</span>Conquista</span>
                <span class="command-nav-disabled"><span class="command-nav-icon">T</span>RotE</span>
            }

            <span class="command-nav-section">Sistema</span>
            <NavLink href="/data" Match="NavLinkMatch.All">
                <span class="command-nav-icon" aria-hidden="true">D</span>
                <span>Datos</span>
            </NavLink>
            <NavLink href="/settings" Match="NavLinkMatch.All">
                <span class="command-nav-icon" aria-hidden="true">A</span>
                <span>Ajustes</span>
            </NavLink>
        </nav>

        <div class="command-sidebar-foot">
            @if (NavigationAllyCode is long sidebarAllyCode)
            {
                <span>@(Session.PlayerName ?? "Jugador activo")</span>
                <small>#@FormatAllyCode(sidebarAllyCode) · contexto persistente</small>
            }
            else
            {
                <span>Sin jugador activo</span>
                <small>Selecciona uno desde Inicio</small>
            }
        </div>
    </aside>

    <div class="command-main">
        <header class="command-topbar">
            <div>
                <span class="command-topbar-kicker">SWGOH Assistant</span>
                <strong>@(Session.PlayerName ?? "Centro de operaciones")</strong>
            </div>
            @if (NavigationAllyCode is long currentAllyCode)
            {
                @if (IsGacWarRoom)
                {
                    <a class="command-player-chip" href="@($"/gac/{currentAllyCode}/refresh")" title="Actualizar datos de Gran Arena">
                        <span>↻</span>
                        <small>Actualizar GAC</small>
                    </a>
                }
                <a class="command-player-chip" href="/settings" title="Jugador y ajustes">
                    <span>@PlayerInitials(Session.PlayerName)</span>
                    <small>#@FormatAllyCode(currentAllyCode)</small>
                </a>
            }
        </header>

        <main class="main-content">
            <article class="content command-content">@Body</article>
        </main>

        <footer class="command-footer">
            <span>SWGOH Assistant</span>
            <span>•</span>
            <span>Decisiones basadas en tu roster y tus resultados</span>
        </footer>
    </div>

    @if (_showMobileMore)
    {
        <div class="command-mobile-more" role="dialog" aria-label="Más navegación">
            <div class="command-mobile-more-head">
                <strong>Más</strong>
                <button type="button" @onclick="CloseMobileMore" aria-label="Cerrar">×</button>
            </div>
            @if (NavigationAllyCode is long moreAllyCode)
            {
                <NavLink href="@($"/gac/{moreAllyCode}/planner")" Match="NavLinkMatch.All" @onclick="CloseMobileMore">
                    <span class="command-nav-icon">P</span><span><strong>Planner</strong><small>Diseña y ejecuta la ronda</small></span>
                </NavLink>
                <NavLink href="@($"/gac/{moreAllyCode}/strategy")" Match="NavLinkMatch.All" @onclick="CloseMobileMore">
                    <span class="command-nav-icon">E</span><span><strong>Estrategia</strong><small>Plantillas y reservas GAC</small></span>
                </NavLink>
                <NavLink href="@($"/gac/{moreAllyCode}/round-optimizer")" Match="NavLinkMatch.All" @onclick="CloseMobileMore">
                    <span class="command-nav-icon">O</span><span><strong>Round Optimizer</strong><small>Optimiza defensa y ataque juntos</small></span>
                </NavLink>
                <NavLink href="@($"/territory-battles/{moreAllyCode}/rise-of-the-empire")" Match="NavLinkMatch.All" @onclick="CloseMobileMore">
                    <span class="command-nav-icon">T</span><span><strong>RotE</strong><small>Planetas, equipos y mejoras</small></span>
                </NavLink>
            }
            else
            {
                <span class="command-mobile-more-disabled">
                    <span class="command-nav-icon">P</span><span><strong>Planner</strong><small>Selecciona primero un jugador</small></span>
                </span>
                <span class="command-mobile-more-disabled">
                    <span class="command-nav-icon">E</span><span><strong>Estrategia</strong><small>Selecciona primero un jugador</small></span>
                </span>
                <span class="command-mobile-more-disabled">
                    <span class="command-nav-icon">O</span><span><strong>Round Optimizer</strong><small>Selecciona primero un jugador</small></span>
                </span>
                <span class="command-mobile-more-disabled">
                    <span class="command-nav-icon">T</span><span><strong>RotE</strong><small>Selecciona primero un jugador</small></span>
                </span>
            }
            <NavLink href="/data" Match="NavLinkMatch.All" @onclick="CloseMobileMore">
                <span class="command-nav-icon">D</span><span><strong>Datos</strong><small>Frescura y fuentes disponibles</small></span>
            </NavLink>
            <NavLink href="/settings" Match="NavLinkMatch.All" @onclick="CloseMobileMore">
                <span class="command-nav-icon">A</span><span><strong>Ajustes</strong><small>Jugador principal y preferencias</small></span>
            </NavLink>
        </div>
        <button class="command-mobile-more-backdrop" type="button" @onclick="CloseMobileMore" aria-label="Cerrar menú"></button>
    }

    <nav class="command-mobile-nav" aria-label="Navegación móvil">
        <NavLink href="/" Match="NavLinkMatch.All"><span>⌂</span><small>Inicio</small></NavLink>
        @if (NavigationAllyCode is long mobileAllyCode)
        {
            <NavLink href="@($"/player/{mobileAllyCode}")" Match="NavLinkMatch.All"><span>R</span><small>Roster</small></NavLink>
            <NavLink href="@($"/gac/{mobileAllyCode}")" Match="NavLinkMatch.All"><span>G</span><small>GAC</small></NavLink>
            <NavLink href="@($"/conquest/{mobileAllyCode}")" Match="NavLinkMatch.All"><span>C</span><small>Conquista</small></NavLink>
        }
        else
        {
            <span class="command-mobile-nav-disabled"><span>R</span><small>Roster</small></span>
            <span class="command-mobile-nav-disabled"><span>G</span><small>GAC</small></span>
            <span class="command-mobile-nav-disabled"><span>C</span><small>Conquista</small></span>
        }
        <button class="command-mobile-more-trigger @(MobileMoreActive ? "active" : string.Empty)" type="button" @onclick="ToggleMobileMore" aria-expanded="@_showMobileMore">
            <span>•••</span><small>Más</small>
        </button>
    </nav>
</div>

@code {
    private bool contextRestored;
    private bool _showMobileMore;

    private long? NavigationAllyCode => Session.AllyCode ?? TryGetRouteAllyCode(Navigation.Uri);

    private bool IsGacWarRoom
    {
        get
        {
            if (NavigationAllyCode is not long allyCode)
            {
                return false;
            }

            string path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
            return path.Equals($"/gac/{allyCode}", StringComparison.OrdinalIgnoreCase);
        }
    }

    private bool MobileMoreActive
    {
        get
        {
            string path = new Uri(Navigation.Uri).AbsolutePath;
            return path.Equals("/data", StringComparison.OrdinalIgnoreCase) ||
                   path.Equals("/settings", StringComparison.OrdinalIgnoreCase) ||
                   path.EndsWith("/planner", StringComparison.OrdinalIgnoreCase) ||
                   path.EndsWith("/strategy", StringComparison.OrdinalIgnoreCase) ||
                   path.EndsWith("/round-optimizer", StringComparison.OrdinalIgnoreCase) ||
                   path.EndsWith("/rise-of-the-empire", StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || contextRestored)
        {
            return;
        }

        contextRestored = true;
        await RestoreContextForCurrentLocationAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _showMobileMore = false;
        long? routeAllyCode = TryGetRouteAllyCode(args.Location);
        if (routeAllyCode is not long allyCode || Session.AllyCode == allyCode)
        {
            _ = InvokeAsync(StateHasChanged);
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await PlayerContext.ActivateAsync(allyCode);
            StateHasChanged();
        });
    }

    private async Task RestoreContextForCurrentLocationAsync()
    {
        long? routeAllyCode = TryGetRouteAllyCode(Navigation.Uri);
        if (routeAllyCode is long allyCode)
        {
            if (await PlayerContext.ActivateAsync(allyCode))
            {
                return;
            }
        }

        await PlayerContext.RestoreAsync();
    }

    private void ToggleMobileMore() => _showMobileMore = !_showMobileMore;

    private void CloseMobileMore() => _showMobileMore = false;

    private static long? TryGetRouteAllyCode(string location)
    {
        string[] segments = new Uri(location).AbsolutePath
            .Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (segments.Length < 2 ||
            (segments[0] is not "player" and not "gac" and not "conquest" and not "territory-battles"))
        {
            return null;
        }

        return long.TryParse(segments[1], out long allyCode) && allyCode is >= 100_000_000 and <= 999_999_999
            ? allyCode
            : null;
    }

    private static string PlayerInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "P";
        }

        string[] parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
    }

    private static string FormatAllyCode(long allyCode)
    {
        string value = allyCode.ToString("000000000");
        return $"{value[..3]}-{value[3..6]}-{value[6..]}";
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
