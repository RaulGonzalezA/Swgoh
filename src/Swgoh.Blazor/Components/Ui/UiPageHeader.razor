<header class="ui-page-header @Class">
    <div class="ui-page-header-copy">
        @if (!string.IsNullOrWhiteSpace(BackHref))
        {
            <a class="ui-back-link" href="@BackHref">← @(BackText ?? "Volver")</a>
        }
        @if (!string.IsNullOrWhiteSpace(Kicker))
        {
            <span class="ui-kicker">@Kicker</span>
        }
        <h1>@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p>@Description</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="ui-page-header-actions">@Actions</div>
    }
</header>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Kicker { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? BackHref { get; set; }

    [Parameter]
    public string? BackText { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }
}
