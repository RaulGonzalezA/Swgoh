<div class="planner-tactical-toolbar" aria-label="Orden y filtros del tablero rival">
    <div class="planner-tactical-sort">
        <label for="planner-sort">Orden</label>
        <select id="planner-sort" value="@Sort" @onchange="ChangeSortAsync">
            <option value="Recommended">Recomendado</option>
            <option value="Safest">Más seguro</option>
            <option value="Hardest">Más difícil</option>
            <option value="Zone">Zona</option>
            <option value="Unplanned">Sin plan primero</option>
        </select>
    </div>

    <div class="planner-tactical-filters" role="group" aria-label="Filtrar defensas">
        <button class="@AllClass" type="button" @onclick="ShowAllAsync">Todas</button>
        <button class="@LowClass" type="button" @onclick="ShowLowAsync">Riesgo bajo</button>
        <button class="@MediumClass" type="button" @onclick="ShowMediumAsync">Medio</button>
        <button class="@HighClass" type="button" @onclick="ShowHighAsync">Alto</button>
        <button class="@NoCounterClass" type="button" @onclick="ShowNoCounterAsync">Sin counter</button>
        <button class="@UnplannedClass" type="button" @onclick="ShowUnplannedAsync">Sin plan</button>
    </div>

    <span class="planner-tactical-count"><strong>@VisibleCount</strong> / @TotalCount visibles</span>
</div>

@code {
    [Parameter]
    public string Sort { get; set; } = "Recommended";

    [Parameter]
    public EventCallback<string> SortChanged { get; set; }

    [Parameter]
    public string Filter { get; set; } = "All";

    [Parameter]
    public EventCallback<string> FilterChanged { get; set; }

    [Parameter]
    public int VisibleCount { get; set; }

    [Parameter]
    public int TotalCount { get; set; }

    private string AllClass => FilterClass("All");
    private string LowClass => FilterClass("Low");
    private string MediumClass => FilterClass("Medium");
    private string HighClass => FilterClass("High");
    private string NoCounterClass => FilterClass("NoCounter");
    private string UnplannedClass => FilterClass("Unplanned");

    private Task ChangeSortAsync(ChangeEventArgs args) =>
        SortChanged.InvokeAsync(args.Value?.ToString() ?? "Recommended");

    private Task ShowAllAsync() => FilterChanged.InvokeAsync("All");
    private Task ShowLowAsync() => FilterChanged.InvokeAsync("Low");
    private Task ShowMediumAsync() => FilterChanged.InvokeAsync("Medium");
    private Task ShowHighAsync() => FilterChanged.InvokeAsync("High");
    private Task ShowNoCounterAsync() => FilterChanged.InvokeAsync("NoCounter");
    private Task ShowUnplannedAsync() => FilterChanged.InvokeAsync("Unplanned");

    private string FilterClass(string filter) =>
        string.Equals(Filter, filter, StringComparison.Ordinal) ? "active" : string.Empty;
}
