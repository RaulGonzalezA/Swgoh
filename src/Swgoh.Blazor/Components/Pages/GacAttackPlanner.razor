@page "/gac/{AllyCode:long}/planner"
@rendermode InteractiveServer
@inject PlayerApiClient PlayerClient
@inject GacPlannerApiClient PlannerClient

<PageTitle>Planificador GAC · SWGOH Planner</PageTitle>

<div class="page-heading-row planner-page-heading">
    <div>
        <a class="back-link" href="@($"/gac/{AllyCode}")">← War Room</a>
        <span class="eyebrow">GAC Attack Planner</span>
        <h1>Diseña la ronda antes de atacar</h1>
        @if (_planner is not null)
        {
            <p class="page-lead">
                vs @_planner.Opponent.OpponentName · @_planner.Opponent.Format · @_planner.Opponent.League
                @if (_planner.Opponent.RoundNumber is not null)
                {
                    <span> · Ronda @_planner.Opponent.RoundNumber</span>
                }
            </p>
        }
    </div>
    @if (_planner is not null)
    {
        <div class="heading-stat planner-heading-stat">
            <span>Cobertura</span>
            <strong>@PlannedCoverage/@_visibleDefenses.Count</strong>
            <small>@_planner.Plan.Conflicts.Count conflictos</small>
        </div>
    }
</div>

<nav class="player-subnav" aria-label="Secciones del jugador">
    <a href="@($"/player/{AllyCode}")">Roster</a>
    <a href="@($"/gac/{AllyCode}")">War Room</a>
    <a class="active" href="@($"/gac/{AllyCode}/planner")">Planificador</a>
</nav>

@if (_loading)
{
    <div class="loading-panel gac-loading">
        <span class="spinner"></span>
        <div><strong>Preparando el tablero</strong><small>Rosters, equipos guardados y ronda actual</small></div>
    </div>
}
else if (_error is not null)
{
    <div class="status-card status-error" role="alert">
        <span class="status-icon">!</span>
        <div><strong>No se ha podido abrir el planificador</strong><p>@_error</p></div>
    </div>
}
else if (_planner is null)
{
    <div class="empty-state empty-state-wide">
        <span class="empty-icon">P</span>
        <h2>No hay una ronda activa que planificar</h2>
        <p>@(_unavailableMessage ?? "Cuando se detecte un rival activo podrás preparar aquí toda la secuencia de ataques.")</p>
        <a class="secondary-button button-link" href="@($"/gac/{AllyCode}")">Volver a War Room</a>
    </div>
}
else
{
    <section class="planner-summary-grid" aria-label="Resumen del plan">
        <div><span>Mi defensa</span><strong>@_ownDefenses.Count</strong><small>equipos colocados</small></div>
        <div><span>Rival visible</span><strong>@_visibleDefenses.Count</strong><small>defensas registradas</small></div>
        <div><span>Ataques</span><strong>@ActiveAttacks</strong><small>@CompletedWins victorias</small></div>
        <div class="@(HasBlockingConflicts ? "planner-summary-alert" : string.Empty)">
            <span>Conflictos</span><strong>@_planner.Plan.Conflicts.Count</strong><small>@(HasBlockingConflicts ? "requieren revisión" : "plan consistente")</small>
        </div>
    </section>

    @if (_planner.Plan.Conflicts.Count > 0)
    {
        <section class="planner-conflict-strip" aria-label="Conflictos del plan">
            <div class="planner-conflict-heading">
                <span class="warning-symbol">!</span>
                <div><strong>Revisa el plan antes de atacar</strong><small>El servidor detecta unidades reutilizadas o ataques innecesarios.</small></div>
            </div>
            <div class="planner-conflict-list">
                @foreach (GacPlannerApiClient.ConflictViewModel conflict in _planner.Plan.Conflicts)
                {
                    <div class="planner-conflict-item planner-conflict-@conflict.Severity.ToLowerInvariant()">
                        <span>@(conflict.Severity == "Error" ? "Bloqueo" : "Aviso")</span>
                        <p>@conflict.Message</p>
                    </div>
                }
            </div>
        </section>
    }

    <section class="planner-workspace">
        <aside class="planner-library">
            <div class="planner-section-heading">
                <div><span class="section-kicker">Biblioteca</span><h2>Mis equipos</h2></div>
                <button class="ghost-button" type="button" @onclick="TogglePresetBuilder">@(_showPresetBuilder ? "Cerrar" : "+ Equipo")</button>
            </div>

            @if (_showPresetBuilder)
            {
                <div class="planner-builder-card">
                    <div class="planner-builder-title"><strong>Guardar equipo</strong><span>@_planner.Opponent.Format</span></div>
                    <label>
                        Nombre
                        <input placeholder="Ej. Leia ataque" @bind="_presetName" />
                    </label>
                    <div class="planner-form-row">
                        <label>
                            Uso
                            <select @bind="_presetUse">
                                <option value="Offense">Ataque</option>
                                <option value="Defense">Defensa</option>
                                <option value="Flexible">Flexible</option>
                            </select>
                        </label>
                        <label>
                            Tipo
                            <select value="@_presetType" @onchange="PresetTypeChanged">
                                <option value="Character">Personajes</option>
                                <option value="Fleet">Flota</option>
                            </select>
                        </label>
                    </div>
                    <label>
                        Líder
                        <select @bind="_presetLeaderId">
                            <option value="">Selecciona unidad…</option>
                            @foreach (PlayerApiClient.RosterUnitViewModel unit in PresetUnitOptions)
                            {
                                <option value="@unit.DefinitionId">@UnitOptionLabel(unit)</option>
                            }
                        </select>
                    </label>
                    <div class="planner-member-grid">
                        @for (int memberIndex = 0; memberIndex < PresetMemberSlotCount; memberIndex++)
                        {
                            int index = memberIndex;
                            <label>
                                @(memberIndex == 0 ? "Miembros" : " ")
                                <select value="@_presetMemberIds[index]" @onchange="eventArgs => SetPresetMember(index, eventArgs.Value?.ToString())">
                                    <option value="">@(PresetMembersRequired ? "Selecciona unidad…" : "Opcional…")</option>
                                    @foreach (PlayerApiClient.RosterUnitViewModel unit in PresetUnitOptions)
                                    {
                                        <option value="@unit.DefinitionId">@UnitOptionLabel(unit)</option>
                                    }
                                </select>
                            </label>
                        }
                    </div>
                    <button class="primary-button planner-full-button" type="button" @onclick="CreatePresetAsync" disabled="@(_saving || !CanCreatePreset)">
                        Guardar equipo
                    </button>
                </div>
            }

            <div class="planner-preset-filters">
                <button class="@PresetFilterClass("All")" type="button" @onclick="() => _presetFilter = "All"">Todos</button>
                <button class="@PresetFilterClass("Defense")" type="button" @onclick="() => _presetFilter = "Defense"">Defensa</button>
                <button class="@PresetFilterClass("Offense")" type="button" @onclick="() => _presetFilter = "Offense"">Ataque</button>
            </div>

            @if (FilteredPresets.Count == 0)
            {
                <div class="planner-mini-empty">Guarda tus equipos habituales para reutilizarlos en cada ronda.</div>
            }
            else
            {
                <div class="planner-preset-list">
                    @foreach (GacPlannerApiClient.TeamPresetViewModel preset in FilteredPresets)
                    {
                        <article class="planner-preset-card">
                            <div class="planner-preset-top">
                                <div>
                                    <span class="planner-use-pill planner-use-@preset.Use.ToLowerInvariant()">@FriendlyUse(preset.Use)</span>
                                    <strong>@preset.Name</strong>
                                </div>
                                <button class="planner-icon-button" type="button" title="Eliminar equipo" @onclick="() => DeletePresetAsync(preset.Id)">×</button>
                            </div>
                            <div class="planner-mini-squad">
                                @foreach (GacPlannerApiClient.PlannerUnitViewModel unit in preset.Squad.AllUnits)
                                {
                                    <div title="@unit.Name">
                                        @if (PortraitUrl(unit.ThumbnailName) is string imageUrl)
                                        {
                                            <img src="@imageUrl" alt="" loading="lazy" onerror="this.style.display='none'" />
                                        }
                                        <span>@Initial(unit.Name)</span>
                                    </div>
                                }
                            </div>
                            <small>@preset.Squad.Leader.Name · @(preset.Squad.IsFleet ? "Flota" : preset.Format)</small>
                        </article>
                    }
                </div>
            }
        </aside>

        <main class="planner-board">
            <section class="planner-board-section planner-own-defense-section">
                <div class="planner-section-heading">
                    <div><span class="section-kicker">Tu lado</span><h2>Mi defensa</h2></div>
                    <span class="count-badge">@_ownDefenses.Count</span>
                </div>
                <p class="planner-section-copy">Indica qué equipos has colocado. Sus unidades quedarán bloqueadas para cualquier ataque que diseñes.</p>

                <div class="planner-inline-editor">
                    <label>
                        Zona
                        <select @bind="_ownDefenseZone">
                            @foreach (string zone in ZoneOptions)
                            {
                                <option value="@zone">@zone</option>
                            }
                        </select>
                    </label>
                    <label class="planner-inline-editor-wide">
                        Equipo
                        <select @bind="_ownDefensePresetId">
                            <option value="">Selecciona equipo…</option>
                            @foreach (GacPlannerApiClient.TeamPresetViewModel preset in DefensePresetOptions)
                            {
                                <option value="@preset.Id.ToString()">@preset.Name · @FriendlyUse(preset.Use)</option>
                            }
                        </select>
                    </label>
                    <button class="secondary-button" type="button" @onclick="AddOwnDefenseAsync" disabled="@(_saving || string.IsNullOrWhiteSpace(_ownDefensePresetId))">Añadir</button>
                </div>

                @if (_ownDefenses.Count == 0)
                {
                    <div class="planner-board-empty">Todavía no has indicado tu defensa. Puedes planificar ataques igualmente, pero no podremos detectar si estás gastando una unidad colocada atrás.</div>
                }
                else
                {
                    <div class="planner-defense-list planner-own-defense-list">
                        @foreach (OwnDefenseDraft assignment in _ownDefenses)
                        {
                            GacPlannerApiClient.TeamPresetViewModel? preset = FindPreset(assignment.TeamPresetId);
                            if (preset is not null)
                            {
                                <article class="planner-defense-card planner-own-defense-card">
                                    <div class="planner-zone-pill">@assignment.Zone</div>
                                    <div class="planner-defense-main">
                                        <strong>@preset.Name</strong>
                                        <span>@SquadNames(preset.Squad)</span>
                                    </div>
                                    <button class="planner-icon-button" type="button" title="Quitar de defensa" @onclick="() => RemoveOwnDefenseAsync(assignment.Id)">×</button>
                                </article>
                            }
                        }
                    </div>
                }
            </section>

            <section class="planner-board-section planner-enemy-section">
                <div class="planner-section-heading">
                    <div><span class="section-kicker">Tablero rival</span><h2>Defensas visibles</h2></div>
                    <button class="ghost-button" type="button" @onclick="ToggleEnemyBuilder">@(_showEnemyBuilder ? "Cerrar" : "+ Defensa visible")</button>
                </div>
                <p class="planner-section-copy">Añade solo lo que ya has revelado en el juego. El resto del plan no se inventa: las recomendaciones se cruzan con los counters históricos disponibles.</p>

                @if (_showEnemyBuilder)
                {
                    <div class="planner-builder-card planner-enemy-builder">
                        <div class="planner-form-row">
                            <label>
                                Zona
                                <select @bind="_enemyZone">
                                    @foreach (string zone in ZoneOptions)
                                    {
                                        <option value="@zone">@zone</option>
                                    }
                                </select>
                            </label>
                            <label>
                                Tipo
                                <select value="@_enemyType" @onchange="EnemyTypeChanged">
                                    <option value="Character">Personajes</option>
                                    <option value="Fleet">Flota</option>
                                </select>
                            </label>
                        </div>
                        <label>
                            Etiqueta opcional
                            <input placeholder="Ej. Muro sur" @bind="_enemyLabel" />
                        </label>
                        <label>
                            Líder
                            <select @bind="_enemyLeaderId">
                                <option value="">Selecciona unidad rival…</option>
                                @foreach (PlayerApiClient.RosterUnitViewModel unit in EnemyUnitOptions)
                                {
                                    <option value="@unit.DefinitionId">@UnitOptionLabel(unit)</option>
                                }
                            </select>
                        </label>
                        <div class="planner-member-grid">
                            @for (int memberIndex = 0; memberIndex < EnemyMemberSlotCount; memberIndex++)
                            {
                                int index = memberIndex;
                                <label>
                                    @(memberIndex == 0 ? "Miembros" : " ")
                                    <select value="@_enemyMemberIds[index]" @onchange="eventArgs => SetEnemyMember(index, eventArgs.Value?.ToString())">
                                        <option value="">@(EnemyMembersRequired ? "Selecciona unidad…" : "Opcional…")</option>
                                        @foreach (PlayerApiClient.RosterUnitViewModel unit in EnemyUnitOptions)
                                        {
                                            <option value="@unit.DefinitionId">@UnitOptionLabel(unit)</option>
                                        }
                                    </select>
                                </label>
                            }
                        </div>
                        <button class="primary-button planner-full-button" type="button" @onclick="AddVisibleDefenseAsync" disabled="@(_saving || !CanAddVisibleDefense)">Añadir al tablero</button>
                    </div>
                }

                @if (_visibleDefenses.Count == 0)
                {
                    <div class="planner-board-empty planner-board-empty-large">
                        <strong>El tablero está vacío</strong>
                        <span>En cuanto veas una defensa rival, añádela aquí para empezar a encadenar counters.</span>
                    </div>
                }
                else
                {
                    <div class="planner-enemy-board">
                        @foreach (VisibleDefenseDraft defense in _visibleDefenses.OrderBy(item => item.Zone))
                        {
                            GacPlannerApiClient.VisibleDefenseViewModel? details = FindVisibleDefense(defense.Id);
                            GacPlannerApiClient.CounterHintViewModel? hint = FindCounterHint(defense.Id);
                            IReadOnlyCollection<AttackDraft> defenseAttacks = AttacksFor(defense.Id);
                            <article class="planner-enemy-card @(details?.Defeated == true ? "planner-enemy-defeated" : string.Empty)">
                                <div class="planner-enemy-card-top">
                                    <div>
                                        <span class="planner-zone-pill">@defense.Zone</span>
                                        <h3>@(details?.Squad.Leader.Name ?? UnitName(_opponentRoster, defense.LeaderDefinitionId))</h3>
                                        @if (!string.IsNullOrWhiteSpace(defense.Label))
                                        {
                                            <small>@defense.Label</small>
                                        }
                                    </div>
                                    <button class="planner-icon-button" type="button" title="Quitar defensa visible" @onclick="() => RemoveVisibleDefenseAsync(defense.Id)">×</button>
                                </div>

                                @if (details is not null)
                                {
                                    <div class="planner-large-squad">
                                        @foreach (GacPlannerApiClient.PlannerUnitViewModel unit in details.Squad.AllUnits)
                                        {
                                            <div class="planner-unit-token" title="@unit.Name">
                                                <div>
                                                    @if (PortraitUrl(unit.ThumbnailName) is string imageUrl)
                                                    {
                                                        <img src="@imageUrl" alt="" loading="lazy" onerror="this.style.display='none'" />
                                                    }
                                                    <span>@Initial(unit.Name)</span>
                                                </div>
                                                <small>@unit.Name</small>
                                                @if (unit.RelicTier is > 0)
                                                {
                                                    <em>R@unit.RelicTier</em>
                                                }
                                            </div>
                                        }
                                    </div>
                                }

                                @if (hint is not null)
                                {
                                    <div class="planner-counter-hint">
                                        <div class="planner-counter-hint-heading">
                                            <span>Counter sugerido</span>
                                            <strong>@FriendlyConfidence(hint.Confidence)</strong>
                                        </div>
                                        <p>@hint.Rationale</p>
                                        @if (hint.RecommendedTeam.Count > 0)
                                        {
                                            <div class="planner-hint-team">@string.Join(" · ", hint.RecommendedTeam.Select(unit => unit.Name))</div>
                                        }
                                        <div class="planner-hint-stats">
                                            @if (hint.WinRate is not null)
                                            {
                                                <span><strong>@Percent(hint.WinRate.Value)</strong> win</span>
                                            }
                                            @if (hint.OneShotRate is not null)
                                            {
                                                <span><strong>@Percent(hint.OneShotRate.Value)</strong> one-shot</span>
                                            }
                                            @if (hint.Uses is not null)
                                            {
                                                <span><strong>@hint.Uses</strong> muestras</span>
                                            }
                                        </div>
                                        @if (hint.RequiresDatacronVerification)
                                        {
                                            <small class="datacron-note">Verifica datacron y mods antes de confirmar.</small>
                                        }
                                        @if (hint.MatchingTeamPresetId is Guid matchingPresetId)
                                        {
                                            <button class="secondary-button planner-hint-action" type="button" @onclick="() => PlanAttackAsync(defense.Id, matchingPresetId)">Usar mi equipo coincidente</button>
                                        }
                                    </div>
                                }

                                <div class="planner-attack-designer">
                                    <div class="planner-attack-designer-title">
                                        <strong>Diseñar ataque</strong>
                                        <span>Intento @(NextAttempt(defense.Id))</span>
                                    </div>
                                    <div class="planner-attack-row">
                                        <select value="@SelectedAttackPreset(defense.Id)" @onchange="eventArgs => SetAttackPreset(defense.Id, eventArgs.Value?.ToString())">
                                            <option value="">Selecciona tu equipo…</option>
                                            @foreach (GacPlannerApiClient.TeamPresetViewModel preset in AttackPresetOptions(defense.IsFleet))
                                            {
                                                <option value="@preset.Id.ToString()">@preset.Name · @FriendlyUse(preset.Use)</option>
                                            }
                                        </select>
                                        <button class="secondary-button" type="button" @onclick="() => PlanSelectedAttackAsync(defense.Id)" disabled="@(_saving || string.IsNullOrWhiteSpace(SelectedAttackPreset(defense.Id)))">Planificar</button>
                                    </div>
                                </div>

                                @if (defenseAttacks.Count > 0)
                                {
                                    <div class="planner-attempt-list">
                                        @foreach (AttackDraft attack in defenseAttacks.OrderBy(item => item.Attempt))
                                        {
                                            GacPlannerApiClient.TeamPresetViewModel? attackTeam = FindPreset(attack.TeamPresetId);
                                            <div class="planner-attempt planner-attempt-@attack.Status.ToLowerInvariant()">
                                                <div>
                                                    <span>#@attack.Attempt · @FriendlyAttackStatus(attack.Status)</span>
                                                    <strong>@(attackTeam?.Name ?? "Equipo eliminado")</strong>
                                                </div>
                                                <div class="planner-attempt-actions">
                                                    @if (attack.Status == "Planned")
                                                    {
                                                        <button type="button" title="Victoria" @onclick="() => SetAttackStatusAsync(attack.Id, "Won")">✓</button>
                                                        <button type="button" title="Fallo" @onclick="() => SetAttackStatusAsync(attack.Id, "Failed")">×</button>
                                                        <button type="button" title="Cancelar" @onclick="() => SetAttackStatusAsync(attack.Id, "Cancelled")">—</button>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </article>
                        }
                    </div>
                }
            </section>
        </main>
    </section>

    @if (_saving)
    {
        <div class="planner-saving-toast"><span class="spinner"></span> Guardando plan…</div>
    }
}

@code {
    private const string AssetBaseUrl = "https://swgoh.gg/static/img/assets/";

    [Parameter]
    public long AllyCode { get; set; }

    private GacPlannerApiClient.PlannerViewModel? _planner;
    private readonly List<PlayerApiClient.RosterUnitViewModel> _playerRoster = [];
    private readonly List<PlayerApiClient.RosterUnitViewModel> _opponentRoster = [];
    private readonly List<OwnDefenseDraft> _ownDefenses = [];
    private readonly List<VisibleDefenseDraft> _visibleDefenses = [];
    private readonly List<AttackDraft> _attacks = [];
    private readonly Dictionary<Guid, string> _selectedAttackPresets = [];
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private string? _unavailableMessage;
    private string _presetFilter = "All";
    private bool _showPresetBuilder;
    private string _presetName = string.Empty;
    private string _presetUse = "Offense";
    private string _presetType = "Character";
    private string _presetLeaderId = string.Empty;
    private readonly string[] _presetMemberIds = new string[7];
    private string _ownDefenseZone = "Sur frontal";
    private string _ownDefensePresetId = string.Empty;
    private bool _showEnemyBuilder;
    private string _enemyZone = "Sur frontal";
    private string _enemyLabel = string.Empty;
    private string _enemyType = "Character";
    private string _enemyLeaderId = string.Empty;
    private readonly string[] _enemyMemberIds = new string[7];

    private static readonly string[] ZoneOptions =
    [
        "Sur frontal",
        "Norte frontal",
        "Sur trasera",
        "Norte trasera",
        "Flota"
    ];

    private int CharacterTeamSize => _planner?.Opponent.Format == "3v3" ? 3 : 5;
    private int PresetMemberSlotCount => _presetType == "Fleet" ? 7 : CharacterTeamSize - 1;
    private int EnemyMemberSlotCount => _enemyType == "Fleet" ? 7 : CharacterTeamSize - 1;
    private bool PresetMembersRequired => _presetType != "Fleet";
    private bool EnemyMembersRequired => _enemyType != "Fleet";
    private int PlannedCoverage => _visibleDefenses.Count(defense => _attacks.Any(attack =>
        attack.DefenseId == defense.Id && attack.Status is "Planned" or "Won"));
    private int ActiveAttacks => _attacks.Count(attack => attack.Status != "Cancelled");
    private int CompletedWins => _attacks.Count(attack => attack.Status == "Won");
    private bool HasBlockingConflicts => _planner?.Plan.Conflicts.Any(conflict => conflict.Severity == "Error") == true;

    private IReadOnlyCollection<GacPlannerApiClient.TeamPresetViewModel> FilteredPresets => _planner is null
        ? []
        : [.. _planner.Presets
            .Where(preset => _presetFilter == "All" || preset.Use == _presetFilter)
            .OrderBy(preset => preset.Name, StringComparer.OrdinalIgnoreCase)];

    private IReadOnlyCollection<GacPlannerApiClient.TeamPresetViewModel> DefensePresetOptions => _planner is null
        ? []
        : [.. _planner.Presets
            .Where(preset => preset.Use is "Defense" or "Flexible")
            .OrderBy(preset => preset.Use == "Defense" ? 0 : 1)
            .ThenBy(preset => preset.Name, StringComparer.OrdinalIgnoreCase)];

    private IReadOnlyCollection<PlayerApiClient.RosterUnitViewModel> PresetUnitOptions =>
        [.. _playerRoster
            .Where(unit => unit.IsShip == (_presetType == "Fleet"))
            .OrderByDescending(unit => unit.GalacticPower)
            .ThenBy(unit => unit.Name, StringComparer.OrdinalIgnoreCase)];

    private IReadOnlyCollection<PlayerApiClient.RosterUnitViewModel> EnemyUnitOptions =>
        [.. _opponentRoster
            .Where(unit => unit.IsShip == (_enemyType == "Fleet"))
            .OrderByDescending(unit => unit.GalacticPower)
            .ThenBy(unit => unit.Name, StringComparer.OrdinalIgnoreCase)];

    private bool CanCreatePreset =>
        !string.IsNullOrWhiteSpace(_presetName) &&
        !string.IsNullOrWhiteSpace(_presetLeaderId) &&
        SelectedMembers(_presetMemberIds, PresetMemberSlotCount, PresetMembersRequired).Count >= (PresetMembersRequired ? PresetMemberSlotCount : 1);

    private bool CanAddVisibleDefense =>
        !string.IsNullOrWhiteSpace(_enemyLeaderId) &&
        SelectedMembers(_enemyMemberIds, EnemyMemberSlotCount, EnemyMembersRequired).Count >= (EnemyMembersRequired ? EnemyMemberSlotCount : 1);

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        _unavailableMessage = null;
        try
        {
            GacPlannerApiClient.PlannerResult result = await PlannerClient.GetCurrentAsync(AllyCode);
            _planner = result.Planner;
            _unavailableMessage = result.Message;
            if (_planner is null)
            {
                return;
            }

            MapDraftsFromPlanner();
            IReadOnlyCollection<PlayerApiClient.RosterUnitViewModel> playerRoster = await LoadEntireRosterAsync(AllyCode);
            IReadOnlyCollection<PlayerApiClient.RosterUnitViewModel> opponentRoster =
                await LoadEntireRosterAsync(_planner.Opponent.OpponentAllyCode);
            _playerRoster.Clear();
            _playerRoster.AddRange(playerRoster);
            _opponentRoster.Clear();
            _opponentRoster.AddRange(opponentRoster);
        }
        catch (HttpRequestException exception)
        {
            _error = exception.Message.Contains("400", StringComparison.Ordinal)
                ? "Algún dato del plan no es válido. Revisa los equipos y vuelve a intentarlo."
                : "La API no está disponible en este momento.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<IReadOnlyCollection<PlayerApiClient.RosterUnitViewModel>> LoadEntireRosterAsync(long allyCode)
    {
        var units = new List<PlayerApiClient.RosterUnitViewModel>();
        int page = 1;
        int totalPages;
        do
        {
            PlayerApiClient.RosterPageViewModel? result = await PlayerClient.GetRosterAsync(
                allyCode,
                page,
                pageSize: 100,
                orderBy: "GalacticPower",
                direction: "Descending");
            if (result is null)
            {
                break;
            }

            units.AddRange(result.Items);
            totalPages = result.TotalPages;
            page++;
        }
        while (page <= totalPages);

        return units;
    }

    private void MapDraftsFromPlanner()
    {
        if (_planner is null)
        {
            return;
        }

        _ownDefenses.Clear();
        _ownDefenses.AddRange(_planner.Plan.OwnDefenses.Select(item =>
            new OwnDefenseDraft(item.Id, item.Zone, item.Team.Id)));
        _visibleDefenses.Clear();
        _visibleDefenses.AddRange(_planner.Plan.VisibleDefenses.Select(item =>
            new VisibleDefenseDraft(
                item.Id,
                item.Zone,
                item.Label,
                item.Squad.Leader.DefinitionId,
                [.. item.Squad.Members.Select(unit => unit.DefinitionId)],
                item.Squad.IsFleet)));
        _attacks.Clear();
        _attacks.AddRange(_planner.Plan.Attacks.Select(item =>
            new AttackDraft(
                item.Id,
                item.DefenseId,
                item.Team.Id,
                item.Attempt,
                item.Status,
                item.Notes)));
    }

    private async Task SavePlanAsync()
    {
        if (_planner is null)
        {
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            var request = new GacPlannerApiClient.SavePlanRequest(
                [.. _ownDefenses.Select(item => new GacPlannerApiClient.SaveOwnDefenseRequest(
                    item.Id == Guid.Empty ? null : item.Id,
                    item.Zone,
                    item.TeamPresetId))],
                [.. _visibleDefenses.Select(item => new GacPlannerApiClient.SaveVisibleDefenseRequest(
                    item.Id == Guid.Empty ? null : item.Id,
                    item.Zone,
                    item.Label,
                    item.LeaderDefinitionId,
                    item.MemberDefinitionIds,
                    item.IsFleet))],
                [.. _attacks.Select(item => new GacPlannerApiClient.SaveAttackRequest(
                    item.Id == Guid.Empty ? null : item.Id,
                    item.DefenseId,
                    item.TeamPresetId,
                    item.Attempt,
                    item.Status,
                    item.Notes))]);
            GacPlannerApiClient.PlannerResult result = await PlannerClient.SaveCurrentAsync(AllyCode, request);
            if (result.Planner is null)
            {
                _unavailableMessage = result.Message;
                return;
            }

            _planner = result.Planner;
            MapDraftsFromPlanner();
        }
        catch (HttpRequestException)
        {
            _error = "No se ha podido guardar el plan. Revisa que los equipos tengan el tamaño correcto y no repitan unidades.";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task CreatePresetAsync()
    {
        if (_planner is null || !CanCreatePreset)
        {
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            IReadOnlyCollection<string> members = SelectedMembers(
                _presetMemberIds,
                PresetMemberSlotCount,
                PresetMembersRequired);
            await PlannerClient.CreatePresetAsync(
                AllyCode,
                new GacPlannerApiClient.SavePresetRequest(
                    _presetName.Trim(),
                    _planner.Opponent.Format,
                    _presetUse,
                    _presetLeaderId,
                    members,
                    _presetType == "Fleet"));
            await ReloadPlannerAsync();
            ResetPresetBuilder();
        }
        catch (HttpRequestException)
        {
            _error = "No se ha podido guardar el equipo. Comprueba que no repites unidades y que todas pertenecen a tu roster.";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeletePresetAsync(Guid id)
    {
        _saving = true;
        _error = null;
        try
        {
            await PlannerClient.DeletePresetAsync(AllyCode, id);
            await ReloadPlannerAsync();
        }
        catch (HttpRequestException)
        {
            _error = "Ese equipo está siendo usado en el plan actual. Quita primero sus asignaciones.";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ReloadPlannerAsync()
    {
        GacPlannerApiClient.PlannerResult result = await PlannerClient.GetCurrentAsync(AllyCode);
        _planner = result.Planner;
        _unavailableMessage = result.Message;
        MapDraftsFromPlanner();
    }

    private async Task AddOwnDefenseAsync()
    {
        if (!Guid.TryParse(_ownDefensePresetId, out Guid presetId))
        {
            return;
        }

        _ownDefenses.Add(new OwnDefenseDraft(Guid.Empty, _ownDefenseZone, presetId));
        _ownDefensePresetId = string.Empty;
        await SavePlanAsync();
    }

    private async Task RemoveOwnDefenseAsync(Guid id)
    {
        _ownDefenses.RemoveAll(item => item.Id == id);
        await SavePlanAsync();
    }

    private async Task AddVisibleDefenseAsync()
    {
        if (!CanAddVisibleDefense)
        {
            return;
        }

        IReadOnlyCollection<string> members = SelectedMembers(
            _enemyMemberIds,
            EnemyMemberSlotCount,
            EnemyMembersRequired);
        _visibleDefenses.Add(new VisibleDefenseDraft(
            Guid.Empty,
            _enemyZone,
            string.IsNullOrWhiteSpace(_enemyLabel) ? null : _enemyLabel.Trim(),
            _enemyLeaderId,
            members,
            _enemyType == "Fleet"));
        await SavePlanAsync();
        ResetEnemyBuilder();
    }

    private async Task RemoveVisibleDefenseAsync(Guid id)
    {
        _visibleDefenses.RemoveAll(item => item.Id == id);
        _attacks.RemoveAll(item => item.DefenseId == id);
        _selectedAttackPresets.Remove(id);
        await SavePlanAsync();
    }

    private async Task PlanSelectedAttackAsync(Guid defenseId)
    {
        if (!_selectedAttackPresets.TryGetValue(defenseId, out string? value) || !Guid.TryParse(value, out Guid presetId))
        {
            return;
        }

        await PlanAttackAsync(defenseId, presetId);
    }

    private async Task PlanAttackAsync(Guid defenseId, Guid presetId)
    {
        _attacks.Add(new AttackDraft(
            Guid.Empty,
            defenseId,
            presetId,
            NextAttempt(defenseId),
            "Planned",
            null));
        _selectedAttackPresets.Remove(defenseId);
        await SavePlanAsync();
    }

    private async Task SetAttackStatusAsync(Guid attackId, string status)
    {
        int index = _attacks.FindIndex(item => item.Id == attackId);
        if (index < 0)
        {
            return;
        }

        AttackDraft current = _attacks[index];
        _attacks[index] = current with { Status = status };
        await SavePlanAsync();
    }

    private void TogglePresetBuilder() => _showPresetBuilder = !_showPresetBuilder;
    private void ToggleEnemyBuilder() => _showEnemyBuilder = !_showEnemyBuilder;

    private void PresetTypeChanged(ChangeEventArgs eventArgs)
    {
        _presetType = eventArgs.Value?.ToString() == "Fleet" ? "Fleet" : "Character";
        _presetLeaderId = string.Empty;
        Array.Fill(_presetMemberIds, string.Empty);
    }

    private void EnemyTypeChanged(ChangeEventArgs eventArgs)
    {
        _enemyType = eventArgs.Value?.ToString() == "Fleet" ? "Fleet" : "Character";
        _enemyLeaderId = string.Empty;
        Array.Fill(_enemyMemberIds, string.Empty);
        _enemyZone = _enemyType == "Fleet" ? "Flota" : "Sur frontal";
    }

    private void SetPresetMember(int index, string? value) => _presetMemberIds[index] = value ?? string.Empty;
    private void SetEnemyMember(int index, string? value) => _enemyMemberIds[index] = value ?? string.Empty;

    private void SetAttackPreset(Guid defenseId, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            _selectedAttackPresets.Remove(defenseId);
            return;
        }

        _selectedAttackPresets[defenseId] = value;
    }

    private string SelectedAttackPreset(Guid defenseId) =>
        _selectedAttackPresets.TryGetValue(defenseId, out string? value) ? value : string.Empty;

    private void ResetPresetBuilder()
    {
        _presetName = string.Empty;
        _presetUse = "Offense";
        _presetLeaderId = string.Empty;
        Array.Fill(_presetMemberIds, string.Empty);
        _showPresetBuilder = false;
    }

    private void ResetEnemyBuilder()
    {
        _enemyLabel = string.Empty;
        _enemyLeaderId = string.Empty;
        Array.Fill(_enemyMemberIds, string.Empty);
        _showEnemyBuilder = false;
    }

    private IReadOnlyCollection<GacPlannerApiClient.TeamPresetViewModel> AttackPresetOptions(bool isFleet) => _planner is null
        ? []
        : [.. _planner.Presets
            .Where(preset => preset.Squad.IsFleet == isFleet)
            .OrderBy(preset => preset.Use == "Offense" ? 0 : preset.Use == "Flexible" ? 1 : 2)
            .ThenBy(preset => preset.Name, StringComparer.OrdinalIgnoreCase)];

    private GacPlannerApiClient.TeamPresetViewModel? FindPreset(Guid id) =>
        _planner?.Presets.FirstOrDefault(preset => preset.Id == id);

    private GacPlannerApiClient.VisibleDefenseViewModel? FindVisibleDefense(Guid id) =>
        _planner?.Plan.VisibleDefenses.FirstOrDefault(defense => defense.Id == id);

    private GacPlannerApiClient.CounterHintViewModel? FindCounterHint(Guid id) =>
        _planner?.Plan.CounterHints.FirstOrDefault(hint => hint.DefenseId == id);

    private IReadOnlyCollection<AttackDraft> AttacksFor(Guid defenseId) =>
        [.. _attacks.Where(attack => attack.DefenseId == defenseId)];

    private int NextAttempt(Guid defenseId) => _attacks
        .Where(attack => attack.DefenseId == defenseId)
        .Select(attack => attack.Attempt)
        .DefaultIfEmpty(0)
        .Max() + 1;

    private string PresetFilterClass(string value) => _presetFilter == value ? "active" : string.Empty;

    private static IReadOnlyCollection<string> SelectedMembers(string[] source, int count, bool required)
    {
        string[] selected =
        [
            .. source.Take(count).Where(value => !string.IsNullOrWhiteSpace(value))
        ];
        return required && selected.Length != count ? [] : selected;
    }

    private static string UnitOptionLabel(PlayerApiClient.RosterUnitViewModel unit) => unit.IsShip
        ? $"{unit.Name} · {unit.GalacticPower:N0} GP"
        : $"{unit.Name} · {(unit.RelicTier > 0 ? $"R{unit.RelicTier}" : $"G{unit.GearTier}")} · {unit.GalacticPower:N0} GP";

    private static string UnitName(
        IReadOnlyCollection<PlayerApiClient.RosterUnitViewModel> roster,
        string definitionId) => roster.FirstOrDefault(unit =>
            string.Equals(unit.DefinitionId, definitionId, StringComparison.OrdinalIgnoreCase))?.Name ?? definitionId;

    private static string SquadNames(GacPlannerApiClient.PlannerSquadViewModel squad) =>
        string.Join(" · ", squad.AllUnits.Select(unit => unit.Name));

    private static string FriendlyUse(string use) => use switch
    {
        "Defense" => "Defensa",
        "Offense" => "Ataque",
        "Flexible" => "Flexible",
        _ => use
    };

    private static string FriendlyAttackStatus(string status) => status switch
    {
        "Planned" => "Planificado",
        "Won" => "Victoria",
        "Failed" => "Fallo",
        "Cancelled" => "Cancelado",
        _ => status
    };

    private static string FriendlyConfidence(string confidence) => confidence switch
    {
        "High" => "Alta",
        "Medium" => "Media",
        "Low" => "Baja",
        _ => confidence
    };

    private static string Percent(decimal value)
    {
        decimal normalized = value <= 1 ? value * 100 : value;
        return $"{Math.Clamp(normalized, 0, 100):0.#}%";
    }

    private static string? PortraitUrl(string? thumbnailName)
    {
        if (string.IsNullOrWhiteSpace(thumbnailName))
        {
            return null;
        }

        string assetName = thumbnailName.Trim();
        if (!assetName.EndsWith(".png", StringComparison.OrdinalIgnoreCase))
        {
            assetName += ".png";
        }

        return AssetBaseUrl + Uri.EscapeDataString(assetName);
    }

    private static string Initial(string name) => string.IsNullOrWhiteSpace(name)
        ? "?"
        : char.ToUpperInvariant(name.Trim()[0]).ToString();

    private sealed record OwnDefenseDraft(Guid Id, string Zone, Guid TeamPresetId);

    private sealed record VisibleDefenseDraft(
        Guid Id,
        string Zone,
        string? Label,
        string LeaderDefinitionId,
        IReadOnlyCollection<string> MemberDefinitionIds,
        bool IsFleet);

    private sealed record AttackDraft(
        Guid Id,
        Guid DefenseId,
        Guid TeamPresetId,
        int Attempt,
        string Status,
        string? Notes);
}
