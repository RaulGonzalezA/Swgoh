@using Swgoh.Blazor.Clients
@inject GacAttackExecutionApiClient ExecutionClient

<section id="gac-execution" class="gac-execution-panel" aria-labelledby="gac-execution-title">
    <div class="gac-execution-heading">
        <div>
            <span class="section-kicker">GAC War Room 3.0</span>
            <h2 id="gac-execution-title">Ejecuta la ronda y reoptimiza en vivo</h2>
            <p>Cada resultado consume equipo y datacron, conserva el estado real de la defensa y reconstruye automáticamente todo el plan pendiente con los recursos que quedan.</p>
        </div>
        <div class="gac-execution-summary">
            <span><strong>@PlannedAttacks.Count</strong> preparados</span>
            <span><strong>@WonAttacks</strong> victorias</span>
            <span><strong>@FailedAttacks</strong> fallos</span>
            @if (KnownBannerAverage is decimal bannerAverage)
            {
                <span><strong>@bannerAverage.ToString("0.#")</strong> banners med.</span>
            }
        </div>
    </div>

    @if (LastExecution is not null)
    {
        <div class="gac-execution-result gac-execution-result-@LastExecution.Execution.Status.ToLowerInvariant()">
            <div>
                <span>@(LastExecution.Execution.Status == "Won" ? "✓ Resultado registrado" : "× Fallo registrado")</span>
                <strong>@ExecutionLabel(LastExecution.Execution)</strong>
                @if (LastExecution.Execution.IsCleanup)
                {
                    <span class="gac-live-badge">Cleanup</span>
                }
                @if (LastExecution.Execution.PreloadedTurnMeter)
                {
                    <span class="gac-live-badge danger">TM precargado</span>
                }
            </div>
            @if (LastExecution.Execution.Status == "Failed")
            {
                <small>@LastExecution.Execution.EnemySurvivors.Count enemigo(s) siguen vivos. El siguiente cálculo ya usa esa defensa reducida.</small>
            }
            else
            {
                <small>El resultado ya forma parte de tu aprendizaje personal y el plan ha sido recalculado.</small>
            }
        </div>

        @if (LastExecution.Replan is { } replan)
        {
            <div class="gac-war-room-replan @(replan.Applied ? "applied" : "preview")">
                <div>
                    <span class="section-kicker">Replanificación en vivo</span>
                    <strong>@(replan.Applied ? "Plan pendiente reconstruido" : "Replanificación calculada")</strong>
                    <small>
                        @(replan.Applied
                            ? $"Se reconstruyeron {replan.ReplacedPendingAttacks} ataque(s) pendientes con el nuevo óptimo."
                            : "El resultado se guardó, pero el plan pendiente anterior sigue activo.")
                    </small>
                </div>
                <div class="gac-war-room-replan-metrics">
                    <span><strong>@replan.PreviousPendingAttacks</strong> antes</span>
                    <span><strong>@replan.CurrentPendingAttacks</strong> ahora</span>
                    <span><strong>@replan.CoveredDefenses</strong> cubiertas</span>
                    <span class="@(replan.UncoveredDefenses > 0 ? "warning" : string.Empty)"><strong>@replan.UncoveredDefenses</strong> sin counter</span>
                </div>
            </div>
        }

        @if (LastExecution.PostCommitWarnings.Count > 0)
        {
            <div class="gac-war-room-warnings" role="status">
                @foreach (string warning in LastExecution.PostCommitWarnings)
                {
                    <span>! @warning</span>
                }
            </div>
        }

        @if (LastExecution.NextRecommendation is not null)
        {
            GacPlannerApiClient.OptimizationRecommendationViewModel next = LastExecution.NextRecommendation;
            GacPlannerApiClient.VisibleDefenseViewModel? nextDefense = Planner.Plan.VisibleDefenses.FirstOrDefault(item => item.Id == next.DefenseId);
            GacPlannerApiClient.TeamPresetViewModel? nextTeam = Planner.Presets.FirstOrDefault(item => item.Id == next.TeamPresetId);
            <article class="gac-next-action">
                <div class="gac-next-action-copy">
                    <span class="section-kicker">Siguiente ataque recomendado</span>
                    <h3>@next.DefenseName → @next.TeamName</h3>
                    <p>@next.Rationale</p>
                    <div class="gac-next-action-meta">
                        <span>Score <strong>@next.Score.ToString("0.#")</strong></span>
                        <span>Win est. <strong>@next.EstimatedWinProbability.ToString("0.#")%</strong></span>
                        <span>Riesgo <strong>@FriendlyRisk(next.Risk)</strong></span>
                        <span>Confianza <strong>@FriendlyConfidence(next.Confidence)</strong></span>
                        @if (next.PersonalSamples > 0)
                        {
                            <span>Tu histórico <strong>@next.PersonalWins/@next.PersonalSamples</strong></span>
                        }
                        @if (next.PersonalAverageBanners is decimal personalBanners)
                        {
                            <span>Tus banners <strong>@personalBanners.ToString("0.#")</strong></span>
                        }
                    </div>
                </div>
                @if (nextDefense is not null && nextTeam is not null)
                {
                    <div class="gac-execution-matchup compact">
                        <div class="gac-execution-squad">
                            <small>Rival</small>
                            <div class="rich-squad">
                                @{ bool nextRivalLeader = true; }
                                @foreach (GacPlannerApiClient.PlannerUnitViewModel unit in nextDefense.Squad.AllUnits)
                                {
                                    PlayerApiClient.RosterUnitViewModel? rosterUnit = FindOpponentRosterUnit(unit.DefinitionId);
                                    <RichUnitPortrait Name="@unit.Name"
                                                      ThumbnailName="@unit.ThumbnailName"
                                                      RelicTier="@(rosterUnit?.RelicTier ?? unit.RelicTier)"
                                                      Speed="@rosterUnit?.Stats?.Speed"
                                                      EquippedMods="@(rosterUnit?.Mods?.EquippedCount ?? rosterUnit?.EquippedModCount)"
                                                      SixDotMods="@rosterUnit?.Mods?.SixDotCount"
                                                      ModSpeedBonus="@rosterUnit?.Mods?.SpeedBonus"
                                                      IsLeader="@nextRivalLeader"
                                                      Compact="true" />
                                    nextRivalLeader = false;
                                }
                            </div>
                        </div>
                        <span class="gac-execution-arrow">→</span>
                        <div class="gac-execution-squad">
                            <small>Tu equipo</small>
                            <div class="rich-squad">
                                @{ bool nextOwnLeader = true; }
                                @foreach (GacPlannerApiClient.PlannerUnitViewModel unit in nextTeam.Squad.AllUnits)
                                {
                                    PlayerApiClient.RosterUnitViewModel? rosterUnit = FindOwnRosterUnit(unit.DefinitionId);
                                    <RichUnitPortrait Name="@unit.Name"
                                                      ThumbnailName="@unit.ThumbnailName"
                                                      RelicTier="@(rosterUnit?.RelicTier ?? unit.RelicTier)"
                                                      Speed="@rosterUnit?.Stats?.Speed"
                                                      EquippedMods="@(rosterUnit?.Mods?.EquippedCount ?? rosterUnit?.EquippedModCount)"
                                                      SixDotMods="@rosterUnit?.Mods?.SixDotCount"
                                                      ModSpeedBonus="@rosterUnit?.Mods?.SpeedBonus"
                                                      IsLeader="@nextOwnLeader"
                                                      Compact="true" />
                                    nextOwnLeader = false;
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(next.StrategicRationale))
                {
                    <p class="gac-war-room-strategy">@next.StrategicRationale</p>
                }
                @if (next.FutureDefensesAtRisk > 0)
                {
                    <div class="gac-war-room-preserve-note">
                        Preserva piezas: este counter protege @next.FutureDefensesAtRisk defensa(s) futura(s) frente a alternativas más caras.
                    </div>
                }
                @if (ReservedAfterNext.Count > 0)
                {
                    <div class="gac-war-room-reserved">
                        <span>Reserva después de este ataque</span>
                        @foreach (GacPlannerApiClient.AttackViewModel reserved in ReservedAfterNext)
                        {
                            GacPlannerApiClient.VisibleDefenseViewModel? reservedDefense = Planner.Plan.VisibleDefenses.FirstOrDefault(item => item.Id == reserved.DefenseId);
                            <small>@reserved.Team.Name → @(reservedDefense?.Label ?? reservedDefense?.Squad.Leader.Name ?? "Defensa rival")</small>
                        }
                    </div>
                }
            </article>
        }
        else
        {
            <div class="gac-execution-empty compact"><strong>No queda otro ataque calculable.</strong><span>La ronda visible está limpia o no quedan equipos compatibles disponibles.</span></div>
        }
    }

    @if (SelectedAttack is not null)
    {
        GacPlannerApiClient.AttackViewModel selectedAttack = SelectedAttack;
        GacPlannerApiClient.VisibleDefenseViewModel? selectedDefense = Planner.Plan.VisibleDefenses.FirstOrDefault(item => item.Id == selectedAttack.DefenseId);
        <div class="gac-execution-editor">
            <div class="gac-execution-editor-heading">
                <div>
                    <span>@(selectedAttack.IsCleanup ? "Cleanup" : "Ataque") · intento #@selectedAttack.Attempt</span>
                    <strong>@selectedAttack.Team.Name</strong>
                    <small>@(selectedDefense?.Label ?? selectedDefense?.Squad.Leader.Name ?? "Defensa rival")</small>
                </div>
                <button class="text-button" type="button" @onclick="CloseEditor">Cerrar</button>
            </div>

            @if (selectedDefense is not null)
            {
                <div class="gac-execution-matchup">
                    <div class="gac-execution-squad">
                        <small>Defensa rival</small>
                        <div class="rich-squad">
                            @{ bool selectedRivalLeader = true; }
                            @foreach (GacPlannerApiClient.PlannerUnitViewModel unit in selectedDefense.Squad.AllUnits)
                            {
                                PlayerApiClient.RosterUnitViewModel? rosterUnit = FindOpponentRosterUnit(unit.DefinitionId);
                                <RichUnitPortrait Name="@unit.Name"
                                                  ThumbnailName="@unit.ThumbnailName"
                                                  RelicTier="@(rosterUnit?.RelicTier ?? unit.RelicTier)"
                                                  Speed="@rosterUnit?.Stats?.Speed"
                                                  EquippedMods="@(rosterUnit?.Mods?.EquippedCount ?? rosterUnit?.EquippedModCount)"
                                                  SixDotMods="@rosterUnit?.Mods?.SixDotCount"
                                                  ModSpeedBonus="@rosterUnit?.Mods?.SpeedBonus"
                                                  IsLeader="@selectedRivalLeader" />
                                selectedRivalLeader = false;
                            }
                        </div>
                    </div>
                    <span class="gac-execution-arrow">→</span>
                    <div class="gac-execution-squad">
                        <small>Tu ataque</small>
                        <div class="rich-squad">
                            @{ bool selectedOwnLeader = true; }
                            @foreach (GacPlannerApiClient.PlannerUnitViewModel unit in selectedAttack.Team.Squad.AllUnits)
                            {
                                PlayerApiClient.RosterUnitViewModel? rosterUnit = FindOwnRosterUnit(unit.DefinitionId);
                                <RichUnitPortrait Name="@unit.Name"
                                                  ThumbnailName="@unit.ThumbnailName"
                                                  RelicTier="@(rosterUnit?.RelicTier ?? unit.RelicTier)"
                                                  Speed="@rosterUnit?.Stats?.Speed"
                                                  EquippedMods="@(rosterUnit?.Mods?.EquippedCount ?? rosterUnit?.EquippedModCount)"
                                                  SixDotMods="@rosterUnit?.Mods?.SixDotCount"
                                                  ModSpeedBonus="@rosterUnit?.Mods?.SpeedBonus"
                                                  IsLeader="@selectedOwnLeader" />
                                selectedOwnLeader = false;
                            }
                        </div>
                    </div>
                </div>
            }

            <div class="gac-execution-form">
                <div class="gac-result-toggle" role="group" aria-label="Resultado del ataque">
                    <button type="button" class="@(ExecutionStatus == "Won" ? "active won" : string.Empty)" @onclick="SelectWon">✓ Gané</button>
                    <button type="button" class="@(ExecutionStatus == "Failed" ? "active failed" : string.Empty)" @onclick="SelectFailed">× Fallé</button>
                </div>
                <label>
                    <span>Banners</span>
                    <input type="number" min="0" max="100" @bind="ExecutionBanners" placeholder="Opcional" />
                    <small>Se guardan en tu histórico personal para futuras recomendaciones.</small>
                </label>
                <label class="gac-execution-notes">
                    <span>Nota</span>
                    <input maxlength="500" @bind="ExecutionNotes" placeholder="Datacron, RNG, error de turno…" />
                    <small>Opcional. Si la dejas vacía se conserva la nota del planificador.</small>
                </label>
                <button class="primary-button" type="button" @onclick="SubmitExecutionAsync" disabled="@ExecutionBusy">
                    @(ExecutionBusy ? "Registrando y reconstruyendo ronda…" : "Guardar resultado y reconstruir ronda")
                </button>
            </div>

            @if (ExecutionStatus == "Failed" && selectedDefense is not null)
            {
                <div class="gac-live-state-editor">
                    <div class="gac-live-state-heading">
                        <div>
                            <span class="section-kicker">Estado que queda</span>
                            <strong>Marca los enemigos que siguen vivos</strong>
                            <small>El siguiente counter se calculará únicamente contra estas unidades.</small>
                        </div>
                        <span class="gac-live-count">@RemainingEnemyUnits.Count / @selectedDefense.Squad.AllUnits.Count vivos</span>
                    </div>
                    <div class="gac-survivor-grid">
                        @foreach (GacPlannerApiClient.PlannerUnitViewModel unit in selectedDefense.Squad.AllUnits)
                        {
                            bool survives = RemainingEnemyUnits.Contains(unit.DefinitionId);
                            <button type="button"
                                    class="gac-survivor-chip @(survives ? "selected" : "defeated")"
                                    aria-pressed="@survives"
                                    @onclick="() => ToggleSurvivor(unit.DefinitionId)">
                                <span>@(survives ? "✓" : "×")</span>
                                @unit.Name
                            </button>
                        }
                    </div>
                    <label class="gac-preload-toggle">
                        <input type="checkbox" @bind="ExecutionPreloadedTurnMeter" />
                        <span><strong>TM precargado</strong><small>Actívalo si el combate dejó medidor de turno acumulado en la defensa.</small></span>
                    </label>
                </div>
            }

            @if (ExecutionError is not null)
            {
                <div class="status-card status-error" role="alert"><span class="status-icon">!</span><div><strong>No se pudo registrar el resultado</strong><p>@ExecutionError</p></div></div>
            }
        </div>
    }

    @if (PlannedAttacks.Count == 0)
    {
        <div class="gac-execution-empty">
            <strong>No tienes ataques planificados pendientes.</strong>
            <span>Aplica una propuesta del optimizador o planifica un ataque manual para empezar el modo ejecución.</span>
        </div>
    }
    else
    {
        <div class="gac-execution-list">
            @foreach (GacPlannerApiClient.AttackViewModel attack in PlannedAttacks)
            {
                GacPlannerApiClient.VisibleDefenseViewModel? defense = Planner.Plan.VisibleDefenses.FirstOrDefault(item => item.Id == attack.DefenseId);
                <article class="gac-execution-card @(SelectedAttackId == attack.Id ? "selected" : string.Empty)">
                    <div class="gac-execution-card-copy">
                        @{
                            int warRoomOrder = WarRoomOrder(attack);
                            string orderLabel = warRoomOrder == int.MaxValue ? string.Empty : $"Orden #{warRoomOrder} · ";
                        }
                        <span>@orderLabel@(defense?.Zone ?? "Zona") · @(attack.IsCleanup ? "cleanup" : "intento") #@attack.Attempt</span>
                        <strong>@(defense?.Label ?? defense?.Squad.Leader.Name ?? "Defensa") → @attack.Team.Name</strong>
                        @if (!string.IsNullOrWhiteSpace(attack.Notes))
                        {
                            <small>@attack.Notes</small>
                        }
                        @if (!string.IsNullOrWhiteSpace(attack.DatacronId))
                        {
                            <small class="gac-war-room-datacron">DC reservado: @attack.DatacronId</small>
                        }
                    </div>
                    <div class="gac-execution-card-team rich-squad">
                        @{ bool cardLeader = true; }
                        @foreach (GacPlannerApiClient.PlannerUnitViewModel unit in attack.Team.Squad.AllUnits)
                        {
                            PlayerApiClient.RosterUnitViewModel? rosterUnit = FindOwnRosterUnit(unit.DefinitionId);
                            <RichUnitPortrait Name="@unit.Name"
                                              ThumbnailName="@unit.ThumbnailName"
                                              RelicTier="@(rosterUnit?.RelicTier ?? unit.RelicTier)"
                                              Speed="@rosterUnit?.Stats?.Speed"
                                              EquippedMods="@(rosterUnit?.Mods?.EquippedCount ?? rosterUnit?.EquippedModCount)"
                                              SixDotMods="@rosterUnit?.Mods?.SixDotCount"
                                              ModSpeedBonus="@rosterUnit?.Mods?.SpeedBonus"
                                              IsLeader="@cardLeader"
                                              Compact="true" />
                            cardLeader = false;
                        }
                    </div>
                    <button class="secondary-button" type="button" @onclick="() => OpenEditor(attack.Id)">Registrar resultado</button>
                </article>
            }
        </div>
    }

    @if (CompletedAttacks.Count > 0)
    {
        <div class="gac-execution-history">
            <h3>Resultados de esta ronda</h3>
            @foreach (GacPlannerApiClient.AttackViewModel attack in CompletedAttacks)
            {
                GacPlannerApiClient.VisibleDefenseViewModel? defense = Planner.Plan.VisibleDefenses.FirstOrDefault(item => item.Id == attack.DefenseId);
                <div class="gac-execution-history-row">
                    <span class="gac-history-status gac-history-@attack.Status.ToLowerInvariant()">@(attack.Status == "Won" ? "✓" : "×")</span>
                    <div>
                        <strong>@attack.Team.Name</strong>
                        <small>@(defense?.Label ?? defense?.Squad.Leader.Name ?? "Defensa") · intento #@attack.Attempt</small>
                        @if (attack.Status == "Failed")
                        {
                            <small class="gac-live-history-detail">
                                @attack.EnemySurvivors.Count superviviente(s)@(attack.PreloadedTurnMeter ? " · TM precargado" : string.Empty)
                            </small>
                        }
                    </div>
                    <div class="gac-history-meta">
                        @if (attack.IsCleanup)
                        {
                            <span class="gac-live-badge">Cleanup</span>
                        }
                        <span>@(attack.Banners is int banners ? $"{banners} banners" : "sin banners")</span>
                    </div>
                </div>
            }
        </div>
    }
</section>
