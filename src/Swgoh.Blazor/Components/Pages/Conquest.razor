@page "/conquest/{AllyCode:long}"
@rendermode InteractiveServer

<PageTitle>Conquista · SWGOH Planner</PageTitle>

<section class="conquest-hero">
    <div>
        <span class="eyebrow">Conquest Assistant</span>
        <h1>Convierte las hazañas pendientes en un plan de batallas.</h1>
        <p>Guarda el progreso, controla la stamina, prepara tus discos y encuentra equipos que avancen varias hazañas sin agotar tus mejores personajes.</p>
    </div>
    <nav class="conquest-nav" aria-label="Navegación del jugador">
        <a href="@($"/player/{AllyCode}")">Roster</a>
        <a href="@($"/gac/{AllyCode}")">GAC</a>
        <a class="active" href="@($"/conquest/{AllyCode}")">Conquista</a>
    </nav>
</section>

@if (Loading)
{
    <div class="status-card">
        <span class="spinner" aria-hidden="true"></span>
        <div><strong>Cargando Conquista</strong><p>Recuperando progreso, stamina, discos y roster…</p></div>
    </div>
}
else if (Error is not null)
{
    <div class="status-card status-error" role="alert">
        <span class="status-icon">!</span>
        <div><strong>No se ha podido cargar Conquista</strong><p>@Error</p></div>
    </div>
}
else
{
    <section class="conquest-summary">
        <div class="metric-card metric-primary">
            <span class="metric-label">Hazañas</span>
            <strong>@CompletedFeatCount / @Feats.Count</strong>
            <small>completadas</small>
        </div>
        <div class="metric-card">
            <span class="metric-label">Puntos cerrados</span>
            <strong>@EarnedFeatPoints</strong>
            <small>de hazañas completadas</small>
        </div>
        <div class="metric-card">
            <span class="metric-label">Puntos pendientes</span>
            <strong>@AvailableFeatPoints</strong>
            <small>todavía disponibles</small>
        </div>
        <div class="metric-card">
            <span class="metric-label">Preparación</span>
            <strong>@CharacterCount</strong>
            <small>@TrackedStaminaCount stamina · @DataDisks.Count discos · @DiskLoadouts.Count presets</small>
        </div>
    </section>

    <section class="conquest-panel">
        <div class="conquest-panel-heading">
            <div>
                <span class="section-kicker">Evento</span>
                <h2>Conquista actual</h2>
            </div>
            <button class="primary-button" @onclick="SavePlanAsync" disabled="@Saving">
                @(Saving ? "Guardando…" : "Guardar progreso")
            </button>
        </div>

        <div class="conquest-form-grid">
            <label>
                <span>Identificador</span>
                <input @bind="EventId" placeholder="conquest-2026-09" />
            </label>
            <label>
                <span>Nombre</span>
                <input @bind="EventName" placeholder="Conquista actual" />
            </label>
            <label>
                <span>Dificultad</span>
                <select @bind="Difficulty">
                    <option value="Easy">Fácil</option>
                    <option value="Normal">Normal</option>
                    <option value="Hard">Difícil</option>
                </select>
            </label>
        </div>
    </section>

    <section class="conquest-panel conquest-stamina-panel">
        <div class="conquest-panel-heading">
            <div>
                <span class="section-kicker">Stamina</span>
                <h2>Reserva los personajes que vas a necesitar después</h2>
                <p>Las unidades no configuradas se consideran al 100%. El optimizador penaliza gastar equipos agotados o dejarlos por debajo de tu reserva.</p>
            </div>
            <button class="secondary-button" @onclick="ToggleStaminaEditor">
                @(ShowStaminaEditor ? "Cerrar" : "+ Ajustar personaje")
            </button>
        </div>

        <div class="conquest-stamina-settings">
            <label>
                <span>Coste esperado / batalla</span>
                <div class="conquest-stamina-number"><input type="number" min="1" max="100" @bind="StaminaCostPerBattle" /><b>%</b></div>
                <small>Configurable para no depender de una regla fija.</small>
            </label>
            <label>
                <span>Reserva mínima</span>
                <div class="conquest-stamina-number"><input type="number" min="0" max="100" @bind="ReserveFloorPercent" /><b>%</b></div>
                <small>Por debajo de este nivel aumenta el coste de oportunidad.</small>
            </label>
            <div class="conquest-stamina-stat">
                <span>Seguimiento manual</span>
                <strong>@TrackedStaminaCount</strong>
                <small>personajes por debajo del 100%</small>
            </div>
        </div>

        @if (ShowStaminaEditor)
        {
            <div class="conquest-stamina-editor">
                <label class="conquest-stamina-unit-select">
                    <span>Personaje</span>
                    <select @bind="StaminaUnitDefinitionId">
                        <option value="">Selecciona personaje…</option>
                        @foreach (PlayerApiClient.RosterUnitViewModel unit in CharacterOptions)
                        {
                            <option value="@unit.DefinitionId">@unit.Name · @ProgressLabel(unit) · @GetCurrentStamina(unit.DefinitionId)%</option>
                        }
                    </select>
                </label>
                <label>
                    <span>Stamina actual</span>
                    <div class="conquest-stamina-number"><input type="number" min="0" max="100" @bind="StaminaPercent" /><b>%</b></div>
                </label>
                <div class="conquest-stamina-presets" aria-label="Atajos de stamina">
                    @foreach (int preset in new[] { 100, 80, 60, 40, 20, 0 })
                    {
                        <button type="button" class="ghost-button" @onclick="() => SetStaminaPreset(preset)">@preset%</button>
                    }
                </div>
                <button class="primary-button" type="button" @onclick="SetStamina" disabled="@(!CanSetStamina)">Aplicar</button>
            </div>
        }

        @if (TrackedStaminaUnits.Count > 0)
        {
            <div class="conquest-stamina-list">
                @foreach (PlayerApiClient.RosterUnitViewModel unit in TrackedStaminaUnits)
                {
                    int current = GetCurrentStamina(unit.DefinitionId);
                    int after = GetExpectedPostBattleStamina(unit.DefinitionId);
                    <article class="conquest-stamina-card @StaminaCss(current)">
                        <RichUnitPortrait Name="@unit.Name"
                                          ThumbnailName="@unit.ThumbnailName"
                                          RelicTier="@unit.RelicTier"
                                          Speed="@unit.Stats?.Speed"
                                          EquippedMods="@(unit.Mods?.EquippedCount ?? unit.EquippedModCount)"
                                          SixDotMods="@unit.Mods?.SixDotCount"
                                          ModSpeedBonus="@unit.Mods?.SpeedBonus"
                                          Compact="true" />
                        <div class="conquest-stamina-card-copy">
                            <strong>@unit.Name</strong>
                            <span>@current% ahora → @after% tras otra victoria</span>
                            @if (after < ReserveFloorPercent)
                            {
                                <small>Quedaría por debajo de la reserva del @ReserveFloorPercent%.</small>
                            }
                        </div>
                        <button class="text-button danger" type="button" @onclick="() => RemoveStamina(unit.DefinitionId)">100%</button>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="conquest-stamina-empty">Todo el roster se considera al 100% hasta que ajustes algún personaje.</div>
        }
    </section>

    <section class="conquest-panel conquest-disks-panel">
        <div class="conquest-panel-heading">
            <div>
                <span class="section-kicker">Discos de datos</span>
                <h2>Guarda el inventario una vez y reutiliza presets</h2>
                <p>El bonus de planificación es un peso configurable para comparar presets; no intenta reproducir una fórmula interna del juego.</p>
            </div>
            <div class="conquest-disk-heading-actions">
                <button class="secondary-button" type="button" @onclick="ToggleDiskEditor">@(ShowDiskEditor ? "Cerrar disco" : "+ Disco")</button>
                <button class="secondary-button" type="button" @onclick="ToggleLoadoutEditor" disabled="@(DataDisks.Count == 0)">@(ShowLoadoutEditor ? "Cerrar preset" : "+ Preset")</button>
            </div>
        </div>

        <div class="conquest-disk-settings">
            <label>
                <span>Capacidad disponible</span>
                <input type="number" min="1" max="100" @bind="DiskCapacityLimit" />
                <small>Se valida al guardar cada preset.</small>
            </label>
            <div class="conquest-disk-stat"><span>Inventario</span><strong>@DataDisks.Count</strong><small>discos registrados</small></div>
            <div class="conquest-disk-stat"><span>Presets</span><strong>@DiskLoadouts.Count</strong><small>combinaciones reutilizables</small></div>
        </div>

        @if (ShowDiskEditor)
        {
            <div class="conquest-disk-builder">
                <label class="conquest-wide"><span>Nombre</span><input @bind="NewDiskName" placeholder="Ej. Ofensiva para Jedi" /></label>
                <label><span>Coste de capacidad</span><input type="number" min="1" max="100" @bind="NewDiskCapacityCost" /></label>
                <label><span>Bonus planificador</span><input type="number" min="0" max="25" step="0.5" @bind="NewDiskPlannerBonus" /></label>
                <label>
                    <span>Aplica a</span>
                    <select @bind="NewDiskTargetType">
                        <option value="AnyTeam">Cualquier equipo</option>
                        <option value="Faction">Facción</option>
                        <option value="SpecificUnits">Unidad concreta</option>
                    </select>
                </label>
                @if (NewDiskTargetType == "Faction")
                {
                    <label>
                        <span>Facción</span>
                        <select @bind="NewDiskFaction">
                            <option value="">Selecciona facción…</option>
                            @foreach (string faction in FactionOptions)
                            {
                                <option value="@faction">@faction</option>
                            }
                        </select>
                    </label>
                }
                else if (NewDiskTargetType == "SpecificUnits")
                {
                    <label>
                        <span>Unidad</span>
                        <select @bind="NewDiskSpecificUnitId">
                            <option value="">Selecciona unidad…</option>
                            @foreach (PlayerApiClient.RosterUnitViewModel unit in CharacterOptions)
                            {
                                <option value="@unit.DefinitionId">@unit.Name · @ProgressLabel(unit)</option>
                            }
                        </select>
                    </label>
                }
                <label><span>Mínimo que debe cumplir</span><input type="number" min="1" max="5" @bind="NewDiskMinimumMatchingUnits" /></label>
                <label>
                    <span>Hazaña a la que ayuda</span>
                    <select @bind="NewDiskSupportedFeatId">
                        <option value="">Ninguna específica</option>
                        @foreach (FeatDraft feat in Feats.Where(feat => !feat.IsComplete))
                        {
                            <option value="@feat.Id">@feat.Name</option>
                        }
                    </select>
                </label>
                <label class="conquest-wide"><span>Notas</span><input @bind="NewDiskNotes" placeholder="Efecto real, uso previsto, jefe…" /></label>
                <div class="conquest-builder-action"><button class="primary-button" type="button" @onclick="AddDataDisk" disabled="@(!CanAddDisk)">Añadir disco</button></div>
            </div>
        }

        @if (DataDisks.Count == 0)
        {
            <div class="conquest-empty"><strong>No hay discos registrados.</strong><p>Añade los que realmente usas; después podrás agruparlos en presets y el optimizador escogerá el mejor para cada equipo.</p></div>
        }
        else
        {
            <div class="conquest-disk-grid">
                @foreach (DataDiskDraft disk in DataDisks.OrderBy(disk => disk.CapacityCost).ThenBy(disk => disk.Name))
                {
                    <article class="conquest-disk-card">
                        <div class="conquest-disk-card-heading"><div><span>@disk.CapacityCost cap</span><h3>@disk.Name</h3></div><strong>+@disk.PlannerBonus.ToString("0.#")</strong></div>
                        <p>@DiskTargetLabel(disk)</p>
                        <small>@SupportedFeatLabel(disk)</small>
                        @if (!string.IsNullOrWhiteSpace(disk.Notes))
                        {
                            <small>@disk.Notes</small>
                        }
                        <button class="text-button danger" type="button" @onclick="() => RemoveDataDisk(disk.Id)">Eliminar</button>
                    </article>
                }
            </div>
        }

        @if (ShowLoadoutEditor && DataDisks.Count > 0)
        {
            <div class="conquest-loadout-builder">
                <div class="conquest-loadout-builder-heading">
                    <label><span>Nombre del preset</span><input @bind="NewLoadoutName" placeholder="Ej. Farm hazañas" /></label>
                    <div class="conquest-loadout-capacity @(SelectedLoadoutCapacity > DiskCapacityLimit ? "over" : string.Empty)"><strong>@SelectedLoadoutCapacity / @DiskCapacityLimit</strong><span>capacidad</span></div>
                </div>
                <div class="conquest-loadout-disk-picker">
                    @foreach (DataDiskDraft disk in DataDisks)
                    {
                        <label class="@(IsLoadoutDiskSelected(disk.Id) ? "selected" : string.Empty)">
                            <input type="checkbox" checked="@IsLoadoutDiskSelected(disk.Id)" @onchange="_ => ToggleLoadoutDisk(disk.Id)" />
                            <span><strong>@disk.Name</strong><small>@disk.CapacityCost cap · +@disk.PlannerBonus.ToString("0.#")</small></span>
                        </label>
                    }
                </div>
                <button class="primary-button" type="button" @onclick="AddDiskLoadout" disabled="@(!CanAddLoadout)">Guardar preset</button>
            </div>
        }

        @if (DiskLoadouts.Count > 0)
        {
            <div class="conquest-loadout-list">
                @foreach (DiskLoadoutDraft loadout in DiskLoadouts)
                {
                    int usedCapacity = GetLoadoutCapacity(loadout);
                    <article class="conquest-loadout-card @(usedCapacity > DiskCapacityLimit ? "invalid" : string.Empty)">
                        <div><span class="conquest-scope">Preset</span><h3>@loadout.Name</h3><p>@LoadoutDiskNames(loadout)</p></div>
                        <div class="conquest-loadout-actions"><strong>@usedCapacity / @DiskCapacityLimit</strong><span>cap</span><button class="text-button danger" type="button" @onclick="() => RemoveDiskLoadout(loadout.Id)">Eliminar</button></div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="conquest-panel">
        <div class="conquest-panel-heading">
            <div>
                <span class="section-kicker">Hazañas</span>
                <h2>Progreso y requisitos</h2>
            </div>
            <button class="secondary-button" @onclick="ToggleFeatBuilder">
                @(ShowFeatBuilder ? "Cerrar" : "+ Añadir hazaña")
            </button>
        </div>

        @if (ShowFeatBuilder)
        {
            <div class="conquest-feat-builder">
                <label class="conquest-wide">
                    <span>Nombre de la hazaña</span>
                    <input @bind="NewFeatName" placeholder="Ej. Gana 5 batallas con Jedi" />
                </label>
                <label>
                    <span>Ámbito</span>
                    <select @bind="NewFeatScope">
                        <option value="Global">Global</option>
                        <option value="Sector">Sector</option>
                        <option value="Boss">Jefe</option>
                    </select>
                </label>
                @if (NewFeatScope != "Global")
                {
                    <label>
                        <span>Sector</span>
                        <select @bind="NewFeatSector">
                            @for (int sector = 1; sector <= 5; sector++)
                            {
                                <option value="@sector">Sector @sector</option>
                            }
                        </select>
                    </label>
                }
                <label><span>Puntos</span><input type="number" min="1" @bind="NewFeatPoints" /></label>
                <label><span>Objetivo</span><input type="number" min="1" @bind="NewFeatTarget" /></label>
                <label><span>Progreso actual</span><input type="number" min="0" @bind="NewFeatProgress" /></label>
                <label><span>Progreso / batalla</span><input type="number" min="1" @bind="NewFeatProgressPerBattle" /></label>
                <label>
                    <span>Regla</span>
                    <select @bind="NewFeatRuleType">
                        <option value="Faction">Facción</option>
                        <option value="SpecificUnits">Unidad concreta</option>
                        <option value="AnyCharacter">Cualquier equipo</option>
                    </select>
                </label>
                @if (NewFeatRuleType == "Faction")
                {
                    <label>
                        <span>Facción</span>
                        <select @bind="NewFeatFaction">
                            <option value="">Selecciona facción…</option>
                            @foreach (string faction in FactionOptions)
                            {
                                <option value="@faction">@faction</option>
                            }
                        </select>
                    </label>
                }
                else if (NewFeatRuleType == "SpecificUnits")
                {
                    <label class="conquest-wide">
                        <span>Unidad</span>
                        <select @bind="NewFeatSpecificUnitId">
                            <option value="">Selecciona unidad…</option>
                            @foreach (PlayerApiClient.RosterUnitViewModel unit in CharacterOptions)
                            {
                                <option value="@unit.DefinitionId">@unit.Name · @ProgressLabel(unit)</option>
                            }
                        </select>
                    </label>
                }
                <label>
                    <span>Mínimo en el equipo</span>
                    <input type="number" min="1" max="5" @bind="NewFeatMinimumMatchingUnits" />
                </label>
                <div class="conquest-builder-action">
                    <button class="primary-button" @onclick="AddFeat" disabled="@(!CanAddFeat)">Añadir</button>
                </div>
            </div>
        }

        @if (Feats.Count == 0)
        {
            <div class="conquest-empty">
                <strong>Aún no hay hazañas.</strong>
                <p>Añade las globales y las del sector en el que estés. El optimizador empezará a cruzarlas entre sí.</p>
            </div>
        }
        else
        {
            <div class="conquest-feat-list">
                @foreach (FeatDraft feat in Feats.OrderBy(item => item.IsComplete).ThenBy(item => item.Sector ?? 0))
                {
                    <article class="conquest-feat-card @(feat.IsComplete ? "complete" : string.Empty)">
                        <div class="conquest-feat-main">
                            <div>
                                <span class="conquest-scope">@ScopeLabel(feat)</span>
                                <h3>@feat.Name</h3>
                                <p>@RuleLabel(feat)</p>
                            </div>
                            <span class="conquest-points">@feat.Points pts</span>
                        </div>
                        <div class="conquest-progress-row">
                            <label>
                                <span>Progreso</span>
                                <input type="number" min="0" max="@feat.Target" @bind="feat.Progress" />
                            </label>
                            <div class="conquest-progress-copy">
                                <strong>@Math.Min(feat.Progress, feat.Target) / @feat.Target</strong>
                                <span>@Math.Max(0, feat.Target - feat.Progress) restantes</span>
                            </div>
                            <button class="text-button danger" @onclick="() => RemoveFeat(feat.Id)">Eliminar</button>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="conquest-panel conquest-daily-panel">
        <div class="conquest-panel-heading">
            <div>
                <span class="section-kicker">Plan del día</span>
                <h2>Llega a tu caja objetivo con el menor gasto posible</h2>
                <p>Simula progreso, energía, stamina y discos combate a combate. Si configuras una recompensa objetivo, el motor se detiene en cuanto los puntos de hazañas completadas permiten alcanzarla.</p>
            </div>
            <div class="conquest-daily-controls">
                <label>
                    <span>Combates máximos</span>
                    <input type="number" min="1" max="20" @bind="DailyPlanBattles" />
                </label>
                <button class="primary-button" @onclick="BuildDailyPlanAsync" disabled="@(PlanningDay || Feats.Count == 0)">
                    @(PlanningDay ? "Planificando…" : "Generar plan diario")
                </button>
            </div>
        </div>

        <div class="conquest-daily-goal-grid">
            <label>
                <span>Energía disponible</span>
                <input type="number" min="0" @bind="AvailableEnergy" placeholder="Sin límite" />
                <small>Déjalo vacío para no limitar el plan por energía.</small>
            </label>
            <label>
                <span>Coste energía / combate</span>
                <input type="number" min="1" max="1000" @bind="EnergyCostPerBattle" />
                <small>Configurable: no asumimos un coste fijo universal.</small>
            </label>
            <label>
                <span>Puntos actuales</span>
                <input type="number" min="0" @bind="CurrentRewardPoints" />
                <small>Progreso real hacia la recompensa.</small>
            </label>
            <label>
                <span>Puntos objetivo</span>
                <input type="number" min="0" @bind="TargetRewardPoints" placeholder="Sin objetivo" />
                <small>Déjalo vacío para planificar solo por hazañas.</small>
            </label>
            <label class="conquest-daily-goal-name">
                <span>Nombre de la recompensa</span>
                <input @bind="RewardTargetName" placeholder="Ej. Caja roja" />
                <small>Etiqueta libre para identificar el objetivo.</small>
            </label>
            <div class="conquest-daily-goal-status">
                <span>Capacidad actual</span>
                <strong>@(EnergyBattleCapacity is int capacity ? $"{capacity} combates" : "Sin límite")</strong>
                <small>@(RewardPointsRemaining is int remaining ? $"Faltan {remaining} puntos" : "Sin objetivo de caja")</small>
            </div>
        </div>

        <p class="conquest-daily-note">Es una proyección: generar el plan guarda tu configuración actual, pero no aplica automáticamente los resultados, no descuenta stamina real y solo suma puntos de recompensa cuando una hazaña queda proyectada como completada.</p>

        <ConquestDailyPlanResults DailyPlan="@DailyPlan" Roster="@roster" />
    </section>

    <section class="conquest-panel conquest-optimizer">
        <div class="conquest-panel-heading">
            <div>
                <span class="section-kicker">Optimizador multi-hazaña + stamina + discos</span>
                <h2>¿Qué equipo y qué preset debería usar ahora?</h2>
                <p>Prioriza puntos de hazaña por batalla y, cuando la cobertura es comparable, pondera stamina, potencia y el preset de discos que mejor encaja.</p>
            </div>
            <button class="primary-button" @onclick="OptimizeAsync" disabled="@(Optimizing || Feats.Count == 0)">
                @(Optimizing ? "Calculando…" : "Optimizar equipos")
            </button>
        </div>

        <ConquestOptimizationResults Optimization="@Optimization" Roster="@roster" />
    </section>
}
