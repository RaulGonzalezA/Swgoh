@page "/gac/{AllyCode:long}"
@rendermode InteractiveServer

<PageTitle>Gran Arena · SWGOH Planner</PageTitle>

<section class="gac-page">
    <UiPageHeader Kicker="Grand Arena command center"
                  Title="Preparación de Gran Arena"
                  Description="@HeaderDescription"
                  BackHref="/"
                  BackText="Inicio">
        <Actions>
            @if (_result?.Scouting is not null)
            {
                <UiStatusPill Label="@_result.Scouting.Opponent.Format" Tone="accent" ShowDot="true" />
                <UiStatusPill Label="@_result.Scouting.Opponent.League" Tone="neutral" />
                @if (_result.Scouting.Opponent.RoundNumber is int round)
                {
                    <UiStatusPill Label="@($"Ronda {round}")" Tone="neutral" />
                }
            }
        </Actions>
    </UiPageHeader>

    @if (_player is not null)
    {
        <nav class="player-subnav" aria-label="Secciones del jugador">
            <a href="@($"/player/{AllyCode}")">Roster</a>
            <a class="active" href="@($"/gac/{AllyCode}")">War Room</a>
            <a href="@($"/gac/{AllyCode}/planner")">Planificador</a>
        </nav>
    }

    @if (_loading)
    {
        <UiLoadingState Title="Analizando enfrentamiento"
                        Description="Rival, roster, histórico y plan de batalla"
                        Class="gac-inline-state" />
    }
    else if (_error is not null)
    {
        <UiAlert Tone="danger"
                 Icon="!"
                 Title="No se ha podido preparar la Gran Arena"
                 Description="@_error" />
    }
    else if (_result?.Scouting is null)
    {
        <UiEmptyState Icon="G"
                      Title="No hay enfrentamiento disponible"
                      Description="@(_result?.Message ?? "No se ha detectado un evento activo de Gran Arena para este jugador.")">
            <Actions>
                <a class="secondary-button" href="@($"/player/{AllyCode}")">Revisar roster</a>
            </Actions>
        </UiEmptyState>
    }
    else
    {
        GacApiClient.CurrentGacScoutingViewModel scouting = _result.Scouting;
        GacApiClient.CurrentGacBattlePlanViewModel? plan = scouting.BattlePlan;

        <UiCard Kicker="Enfrentamiento"
                Title="@($"{_player?.Name ?? "Jugador"} vs {scouting.Opponent.OpponentName}")"
                Subtitle="Compara profundidad antes de comprometer tus piezas clave."
                Variant="accent"
                Class="gac-matchup-card">
            <ChildContent>
                <div class="gac-matchup">
                    <div class="gac-combatant gac-combatant-player">
                        <span>Tu roster</span>
                        <strong>@(_player?.Name ?? "Jugador")</strong>
                        @if (plan is not null)
                        {
                            <small>@CompactNumber(plan.Comparison.PlayerGalacticPower) GP</small>
                        }
                    </div>
                    <div class="gac-versus" aria-label="versus">
                        <strong>VS</strong>
                        <span>@scouting.Opponent.Format · @scouting.Opponent.League</span>
                    </div>
                    <div class="gac-combatant gac-combatant-opponent">
                        <span>Rival</span>
                        <strong>@scouting.Opponent.OpponentName</strong>
                        @if (plan is not null)
                        {
                            <small>@CompactNumber(plan.Comparison.OpponentGalacticPower) GP</small>
                        }
                        <small>#@FormatAllyCode(scouting.Opponent.OpponentAllyCode)</small>
                    </div>
                </div>
            </ChildContent>
        </UiCard>

        @if (scouting.Scouting is not null)
        {
            <div class="gac-scouting-metrics" aria-label="Histórico del rival">
                <UiMetric Label="Rondas analizadas"
                          Value="@scouting.Scouting.RoundsAnalyzed.ToString("N0")"
                          Hint="histórico disponible"
                          Tone="accent" />
                <UiMetric Label="Temporadas"
                          Value="@scouting.Scouting.SeasonsAnalyzed.ToString("N0")"
                          Hint="muestra histórica" />
                <UiMetric Label="Full clear"
                          Value="@(scouting.Scouting.FullClearRate is null ? "—" : Percent(scouting.Scouting.FullClearRate.Value))"
                          Hint="tasa observada" />
                <UiMetric Label="Primer ataque"
                          Value="@FormatDelay(scouting.Scouting.AverageFirstAttackDelayMinutes)"
                          Hint="retraso medio" />
            </div>
        }

        @if (plan is not null)
        {
            int urgentThreats = plan.Threats.Count(threat => threat.Priority is "Critical" or "High");
            int criticalThreats = plan.Threats.Count(threat => threat.Priority == "Critical");
            int observedCounters = plan.CounterSuggestions.Count(counter => counter.RecommendedTeam is { Count: > 0 } && counter.Uses is not null);
            int historicalDefenses = plan.DefensePredictions.Count(prediction => prediction.Source == "HistoricalPattern");

            <div class="gac-comparison-metrics" aria-label="Comparación de rosters">
                <UiMetric Label="Ventaja GP"
                          Value="@SignedCompact(plan.Comparison.GalacticPowerDelta)"
                          Hint="respecto al rival"
                          Tone="@(plan.Comparison.GalacticPowerDelta >= 0 ? "success" : "danger")" />
                <UiMetric Label="Leyendas galácticas"
                          Value="@($"{plan.Comparison.PlayerGalacticLegends} vs {plan.Comparison.OpponentGalacticLegends}")"
                          Hint="profundidad GL" />
                <UiMetric Label="R7+"
                          Value="@($"{plan.Comparison.PlayerRelic7Plus} vs {plan.Comparison.OpponentRelic7Plus}")"
                          Hint="profundidad alta" />
                <UiMetric Label="R9+"
                          Value="@($"{plan.Comparison.PlayerRelic9Plus} vs {plan.Comparison.OpponentRelic9Plus}")"
                          Hint="piezas premium" />
            </div>

            <UiCard Kicker="War Room"
                    Title="Plan de batalla"
                    Subtitle="Prioriza riesgos, anticipa la defensa rival y conserva respuestas para los enfrentamientos decisivos."
                    Variant="accent"
                    Class="gac-command-card">
                <ChildContent>
                    <nav class="gac-command-nav" aria-label="Plan de batalla">
                        <a href="#war-risks" class="gac-command-link gac-command-risk">
                            <span>Riesgos</span><strong>@urgentThreats</strong><small>@criticalThreats críticos</small>
                        </a>
                        <a href="#war-defense" class="gac-command-link">
                            <span>Defensa rival</span><strong>@plan.DefensePredictions.Count</strong><small>@historicalDefenses con histórico</small>
                        </a>
                        <a href="#war-attack" class="gac-command-link">
                            <span>Guardar ataque</span><strong>@plan.AttackReserves.Count</strong><small>reservas prioritarias</small>
                        </a>
                        <a href="#war-counters" class="gac-command-link gac-command-counter">
                            <span>Counters</span><strong>@plan.CounterSuggestions.Count</strong><small>@observedCounters observados</small>
                        </a>
                    </nav>
                </ChildContent>
            </UiCard>

            <section id="war-risks" class="gac-zone">
                <header class="gac-zone-heading">
                    <div><span class="ui-kicker">1 · Riesgos</span><h2>Qué puede complicar la ronda</h2><p>Empieza por las amenazas de mayor prioridad y revisa su preparación real antes de decidir.</p></div>
                    <span aria-hidden="true">01</span>
                </header>

                @if (plan.Warnings.Count > 0)
                {
                    <UiAlert Tone="warning" Icon="!" Title="Antes de fijar la estrategia" Class="gac-warning">
                        <ChildContent>
                            @foreach (string warning in plan.Warnings)
                            {
                                <p>@warning</p>
                            }
                        </ChildContent>
                    </UiAlert>
                }

                <UiCard Kicker="Prioridad del rival"
                        Title="Amenazas principales"
                        Subtitle="Las caras, reliquias, velocidad y mods son la lectura primaria; el score explica la prioridad."
                        Class="gac-zone-card">
                    <HeaderActions>
                        <UiStatusPill Label="@($"{plan.Threats.Count} amenazas")" Tone="warning" />
                    </HeaderActions>
                    <ChildContent>
                        <div class="gac-threat-grid">
                            @foreach (GacApiClient.BattleThreatViewModel threat in plan.Threats.Take(10))
                            {
                                PlayerApiClient.RosterUnitViewModel? visual = FindOpponentUnit(threat.Unit.DefinitionId);
                                <article class="gac-threat-card" @key="threat.Unit.DefinitionId">
                                    <button type="button" class="gac-portrait-button" @onclick="() => OpenThreatDetailAsync(threat, scouting.Opponent.OpponentAllyCode)">
                                        <RichUnitPortrait Name="@threat.Unit.Name"
                                                          ThumbnailName="@visual?.ThumbnailName"
                                                          RelicTier="@threat.Unit.RelicTier"
                                                          Speed="@visual?.Stats?.Speed"
                                                          EquippedMods="@visual?.Mods?.EquippedCount"
                                                          SixDotMods="@visual?.Mods?.SixDotCount"
                                                          ModSpeedBonus="@visual?.Mods?.SpeedBonus"
                                                          Compact="true" />
                                    </button>
                                    <div class="gac-threat-copy">
                                        <div class="gac-card-title">
                                            <strong>@threat.Unit.Name</strong>
                                            <UiStatusPill Label="@FriendlyPriority(threat.Priority)" Tone="@PriorityTone(threat.Priority)" />
                                        </div>
                                        <div class="gac-card-meta">
                                            <span>Score @threat.Score</span>
                                            <span>@CompactNumber(threat.Unit.GalacticPower) GP</span>
                                            <span>@FriendlyCategory(threat.Category)</span>
                                            @if (threat.Unit.OmicronCount > 0)
                                            {
                                                <span>@threat.Unit.OmicronCount O</span>
                                            }
                                        </div>
                                        <p>@threat.Reason</p>
                                        <button type="button" class="gac-detail-link" @onclick="() => OpenThreatDetailAsync(threat, scouting.Opponent.OpponentAllyCode)">Ver ficha rival →</button>
                                    </div>
                                </article>
                            }
                        </div>
                    </ChildContent>
                </UiCard>
            </section>

            <section id="war-defense" class="gac-zone">
                <header class="gac-zone-heading">
                    <div><span class="ui-kicker">2 · Defensa rival</span><h2>Qué esperamos encontrar</h2><p>Distingue patrones históricos de estimaciones basadas únicamente en la fuerza del roster.</p></div>
                    <span aria-hidden="true">02</span>
                </header>

                <UiCard Kicker="Predicción"
                        Title="Defensas probables"
                        Subtitle="Las probabilidades son evidencia histórica cuando existe; las heurísticas se muestran como tales."
                        Class="gac-zone-card">
                    <HeaderActions>
                        <UiStatusPill Label="@($"{plan.DefensePredictions.Count} predicciones")" Tone="accent" />
                    </HeaderActions>
                    <ChildContent>
                        @if (plan.DefensePredictions.Count == 0)
                        {
                            <UiEmptyState Icon="?" Title="Sin predicción suficiente" Description="No hay datos suficientes para anticipar defensas." />
                        }
                        else
                        {
                            <div class="gac-defense-grid">
                                @foreach (GacApiClient.DefensePredictionViewModel prediction in plan.DefensePredictions.Take(10))
                                {
                                    PlayerApiClient.RosterUnitViewModel? leader = FindOpponentUnit(prediction.LeaderDefinitionId);
                                    <article class="gac-defense-card" @key="prediction.LeaderDefinitionId">
                                        <div class="gac-defense-header">
                                            <div>
                                                <strong>@prediction.LeaderName</strong>
                                                <span>@(prediction.IsFleet ? "Flota" : "Escuadrón") · @FriendlyDefenseSource(prediction.Source)</span>
                                            </div>
                                            <UiStatusPill Label="@FriendlyConfidence(prediction.Confidence)" Tone="@ConfidenceTone(prediction.Confidence)" />
                                        </div>
                                        <div class="rich-squad gac-defense-squad">
                                            <RichUnitPortrait Name="@prediction.LeaderName"
                                                              ThumbnailName="@leader?.ThumbnailName"
                                                              RelicTier="@leader?.RelicTier"
                                                              Speed="@leader?.Stats?.Speed"
                                                              EquippedMods="@leader?.Mods?.EquippedCount"
                                                              SixDotMods="@leader?.Mods?.SixDotCount"
                                                              ModSpeedBonus="@leader?.Mods?.SpeedBonus"
                                                              IsLeader="true"
                                                              Compact="true"
                                                              ShowName="true" />
                                            @foreach (string memberName in prediction.MemberNames.Take(4))
                                            {
                                                PlayerApiClient.RosterUnitViewModel? member = FindOpponentUnitByName(memberName);
                                                <RichUnitPortrait Name="@memberName"
                                                                  ThumbnailName="@member?.ThumbnailName"
                                                                  RelicTier="@member?.RelicTier"
                                                                  Speed="@member?.Stats?.Speed"
                                                                  EquippedMods="@member?.Mods?.EquippedCount"
                                                                  SixDotMods="@member?.Mods?.SixDotCount"
                                                                  ModSpeedBonus="@member?.Mods?.SpeedBonus"
                                                                  Compact="true"
                                                                  ShowName="true" />
                                            }
                                        </div>
                                        @if (prediction.Probability is not null)
                                        {
                                            <div class="gac-probability">
                                                <span>Probabilidad observada</span>
                                                <strong>@Percent(prediction.Probability.Value)</strong>
                                                <div><span style="width:@Percent(prediction.Probability.Value)"></span></div>
                                            </div>
                                        }
                                    </article>
                                }
                            </div>
                        }
                    </ChildContent>
                </UiCard>
            </section>

            <section id="war-attack" class="gac-zone">
                <header class="gac-zone-heading">
                    <div><span class="ui-kicker">3 · Guardar para ataque</span><h2>No gastes estas piezas demasiado pronto</h2><p>Mantén flexibilidad para responder a las amenazas más duras del rival.</p></div>
                    <span aria-hidden="true">03</span>
                </header>

                <UiCard Kicker="Reserva táctica"
                        Title="Reservas de ataque"
                        Subtitle="Piezas que conviene mantener disponibles hasta conocer mejor el tablero."
                        Class="gac-zone-card">
                    <HeaderActions>
                        <UiStatusPill Label="@($"{plan.AttackReserves.Count} reservas")" Tone="accent" />
                    </HeaderActions>
                    <ChildContent>
                        @if (plan.AttackReserves.Count == 0)
                        {
                            <UiEmptyState Icon="R" Title="Sin reservas prioritarias" Description="No hay reservas tácticas calculadas para este enfrentamiento." />
                        }
                        else
                        {
                            <div class="gac-reserve-grid">
                                @foreach (GacApiClient.AttackReserveViewModel reserve in plan.AttackReserves.Take(12))
                                {
                                    PlayerApiClient.RosterUnitViewModel? visual = FindOwnUnit(reserve.Unit.DefinitionId);
                                    <article class="gac-reserve-card" @key="reserve.Unit.DefinitionId">
                                        <button type="button" class="gac-portrait-button" @onclick="() => OpenReserveDetailAsync(reserve)">
                                            <RichUnitPortrait Name="@reserve.Unit.Name"
                                                              ThumbnailName="@visual?.ThumbnailName"
                                                              RelicTier="@reserve.Unit.RelicTier"
                                                              Speed="@visual?.Stats?.Speed"
                                                              EquippedMods="@visual?.Mods?.EquippedCount"
                                                              SixDotMods="@visual?.Mods?.SixDotCount"
                                                              ModSpeedBonus="@visual?.Mods?.SpeedBonus"
                                                              Compact="true" />
                                        </button>
                                        <div class="gac-reserve-copy">
                                            <div class="gac-card-title">
                                                <strong>@reserve.Unit.Name</strong>
                                                <UiStatusPill Label="@FriendlyPriority(reserve.Priority)" Tone="@PriorityTone(reserve.Priority)" />
                                            </div>
                                            <span>@FriendlyRole(reserve.Role) · @CompactNumber(reserve.Unit.GalacticPower) GP · @UnitProgress(reserve.Unit)</span>
                                            <p>@reserve.Reason</p>
                                            <button type="button" class="gac-detail-link" @onclick="() => OpenReserveDetailAsync(reserve)">Ver ficha de ataque →</button>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </ChildContent>
                </UiCard>
            </section>

            <section id="war-counters" class="gac-zone gac-zone-last">
                <header class="gac-zone-heading">
                    <div><span class="ui-kicker">4 · Counters</span><h2>Respuestas para abrir el tablero</h2><p>Reconoce los equipos por sus retratos y usa el texto como explicación de evidencia y riesgo.</p></div>
                    <span aria-hidden="true">04</span>
                </header>

                <UiCard Kicker="Ataque"
                        Title="Counters recomendados"
                        Subtitle="Los equipos observados muestran evidencia real; las anclas heurísticas siguen marcadas como estimaciones."
                        Class="gac-zone-card">
                    <HeaderActions>
                        <UiStatusPill Label="@($"{plan.CounterSuggestions.Count} counters")" Tone="success" />
                    </HeaderActions>
                    <ChildContent>
                        @if (plan.CounterSuggestions.Count == 0)
                        {
                            <UiEmptyState Icon="→" Title="Sin counters suficientes" Description="Todavía no hay evidencia suficiente para generar recomendaciones." />
                        }
                        else
                        {
                            <div class="gac-counter-grid">
                                @foreach (GacApiClient.CounterSuggestionViewModel counter in plan.CounterSuggestions.Take(10))
                                {
                                    bool observed = counter.RecommendedTeam is { Count: > 0 } && counter.Uses is not null;
                                    IReadOnlyCollection<GacApiClient.BattleUnitViewModel> counterTeam = counter.RecommendedTeam is { Count: > 0 }
                                        ? counter.RecommendedTeam
                                        : counter.CandidateAnchors;
                                    PlayerApiClient.RosterUnitViewModel? targetVisual = FindOpponentUnit(counter.Threat.DefinitionId);

                                    <article class="gac-counter-card @(observed ? "gac-counter-observed" : string.Empty)">
                                        <div class="gac-counter-target">
                                            <span>Contra</span>
                                            <button type="button" class="gac-portrait-button" @onclick="() => OpenCounterTargetDetailAsync(counter, scouting.Opponent.OpponentAllyCode)">
                                                <RichUnitPortrait Name="@counter.Threat.Name"
                                                                  ThumbnailName="@targetVisual?.ThumbnailName"
                                                                  RelicTier="@counter.Threat.RelicTier"
                                                                  Speed="@targetVisual?.Stats?.Speed"
                                                                  EquippedMods="@targetVisual?.Mods?.EquippedCount"
                                                                  SixDotMods="@targetVisual?.Mods?.SixDotCount"
                                                                  ModSpeedBonus="@targetVisual?.Mods?.SpeedBonus"
                                                                  Compact="true"
                                                                  ShowName="true" />
                                            </button>
                                            <div class="gac-counter-badges">
                                                <UiStatusPill Label="@FriendlyConfidence(counter.Confidence)" Tone="@ConfidenceTone(counter.Confidence)" />
                                                <UiStatusPill Label="@FriendlySource(counter.Source)" Tone="neutral" />
                                            </div>
                                        </div>

                                        <div class="gac-counter-arrow" aria-hidden="true">→</div>

                                        <div class="gac-counter-team">
                                            <span>@(observed ? "Equipo observado disponible" : "Anclas sugeridas")</span>
                                            <div class="rich-squad gac-counter-squad">
                                                @foreach (GacApiClient.BattleUnitViewModel unit in counterTeam)
                                                {
                                                    PlayerApiClient.RosterUnitViewModel? visual = FindOwnUnit(unit.DefinitionId);
                                                    <button type="button" class="gac-portrait-button" @onclick="() => OpenCounterUnitDetailAsync(unit, counter)">
                                                        <RichUnitPortrait Name="@unit.Name"
                                                                          ThumbnailName="@visual?.ThumbnailName"
                                                                          RelicTier="@unit.RelicTier"
                                                                          Speed="@visual?.Stats?.Speed"
                                                                          EquippedMods="@visual?.Mods?.EquippedCount"
                                                                          SixDotMods="@visual?.Mods?.SixDotCount"
                                                                          ModSpeedBonus="@visual?.Mods?.SpeedBonus"
                                                                          DatacronWarning="@counter.RequiresDatacronVerification"
                                                                          Compact="true"
                                                                          ShowName="true" />
                                                    </button>
                                                }
                                            </div>
                                            <p>@counter.Rationale</p>
                                            @if (counter.RequiresDatacronVerification)
                                            {
                                                <UiStatusPill Label="DC? Verifica aplicabilidad" Tone="warning" ShowDot="true" />
                                            }
                                        </div>

                                        <div class="gac-counter-stats">
                                            @if (counter.WinRate is not null)
                                            {
                                                <div><strong>@Percent(counter.WinRate.Value)</strong><span>victorias</span></div>
                                            }
                                            @if (counter.OneShotRate is not null)
                                            {
                                                <div><strong>@Percent(counter.OneShotRate.Value)</strong><span>one-shot</span></div>
                                            }
                                            @if (counter.Uses is not null)
                                            {
                                                <div><strong>@counter.Uses</strong><span>muestras</span></div>
                                            }
                                            @if (counter.AverageBanners is not null)
                                            {
                                                <div><strong>@counter.AverageBanners.Value.ToString("0.#")</strong><span>banners</span></div>
                                            }
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </ChildContent>
                </UiCard>
            </section>
        }
    }
</section>

<UnitDetailDrawer Unit="_selectedRosterUnit"
                  Summary="_selectedUnitSummary"
                  Eyebrow="_detailEyebrow"
                  ContextTitle="_detailContextTitle"
                  Context="_detailContext"
                  TacticalNotes="_detailNotes"
                  RosterAllyCode="_detailRosterAllyCode"
                  GacAllyCode="AllyCode"
                  IsLoading="_detailLoading"
                  OnClose="CloseUnitDetails" />
