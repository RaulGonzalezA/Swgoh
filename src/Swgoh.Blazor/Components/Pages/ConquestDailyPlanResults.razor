@using Microsoft.AspNetCore.Components
@using Swgoh.Blazor.Clients

@if (DailyPlan is not null)
{
    <div class="conquest-daily-summary conquest-daily-summary-energy">
        <div><span>Combates</span><strong>@DailyPlan.PlannedBattles / @DailyPlan.RequestedBattles</strong><small>secuencia propuesta</small></div>
        <div><span>Energía</span><strong>@DailyPlan.EnergySpent</strong><small>@(DailyPlan.EnergyRemaining is int energyRemaining ? $"quedan {energyRemaining}" : "sin límite configurado")</small></div>
        <div><span>Puntos</span><strong>@DailyPlan.StartingRewardPoints → @DailyPlan.ProjectedRewardPoints</strong><small>+@DailyPlan.ProjectedRewardPointsGained proyectados</small></div>
        <div><span>Objetivo</span><strong>@(DailyPlan.TargetRewardPoints?.ToString() ?? "—")</strong><small>@(string.IsNullOrWhiteSpace(DailyPlan.RewardTargetName) ? "sin recompensa nombrada" : DailyPlan.RewardTargetName)</small></div>
        <div><span>Eficiencia</span><strong>@DailyPlan.RewardPointsPerEnergy.ToString("0.###")</strong><small>puntos desbloqueados / energía</small></div>
        <div><span>Fin del plan</span><strong>@DailyPlan.PlannedBattles</strong><small>@DailyStopReason(DailyPlan.StopReason)</small></div>
    </div>

    @if (DailyPlan.Steps.Count == 0)
    {
        <div class="conquest-empty"><strong>No hay combates planificables.</strong><p>@DailyStopReason(DailyPlan.StopReason)</p></div>
    }
    else
    {
        <div class="conquest-daily-timeline">
            @foreach (ConquestDailyPlanApiClient.DailyPlanStepViewModel step in DailyPlan.Steps)
            {
                <article class="conquest-daily-step @(step.RewardTargetReached ? "target-reached" : string.Empty)">
                    <div class="conquest-daily-step-index"><span>Combate</span><strong>@step.BattleNumber</strong></div>
                    <div class="conquest-daily-step-content">
                        <div class="conquest-daily-step-heading">
                            <div><h3>@step.FeatProgress.Count hazaña(s) avanzan</h3><p>@step.Rationale</p></div>
                            <div class="conquest-daily-step-badges">
                                <span>⚡ @step.EnergyCost</span>
                                @if (step.RewardPointsEarned > 0)
                                {
                                    <span class="reward">+@step.RewardPointsEarned pts</span>
                                }
                                @if (step.RewardTargetReached)
                                {
                                    <span class="target">★ Objetivo alcanzado</span>
                                }
                                @if (step.ChangesTeamFromPrevious)
                                {
                                    <span class="rotate">↻ Cambiar equipo</span>
                                }
                                @if (step.ChangesLoadoutFromPrevious)
                                {
                                    <span class="rotate">◈ Cambiar preset</span>
                                }
                                @if (step.ReserveRiskUnits > 0)
                                {
                                    <span>⚠ @step.ReserveRiskUnits bajo reserva</span>
                                }
                            </div>
                        </div>

                        <div class="rich-squad conquest-daily-team" aria-label="Equipo del combate @step.BattleNumber">
                            @{ bool dailyLeader = true; }
                            @foreach (ConquestDailyPlanApiClient.UnitViewModel unit in step.Team)
                            {
                                PlayerApiClient.RosterUnitViewModel? rosterUnit = FindRosterUnit(unit.DefinitionId);
                                <div class="conquest-stamina-portrait">
                                    <RichUnitPortrait Name="@unit.Name"
                                                      ThumbnailName="@unit.ThumbnailName"
                                                      RelicTier="@unit.RelicTier"
                                                      Speed="@(unit.Speed ?? rosterUnit?.Stats?.Speed)"
                                                      EquippedMods="@(rosterUnit?.Mods?.EquippedCount ?? rosterUnit?.EquippedModCount)"
                                                      SixDotMods="@rosterUnit?.Mods?.SixDotCount"
                                                      ModSpeedBonus="@rosterUnit?.Mods?.SpeedBonus"
                                                      IsLeader="@dailyLeader" />
                                    <span class="conquest-stamina-badge @StaminaCss(unit.CurrentStamina)">@unit.CurrentStamina% → @unit.ExpectedPostBattleStamina%</span>
                                </div>
                                dailyLeader = false;
                            }
                        </div>

                        @if (step.DiskLoadout is not null)
                        {
                            <div class="conquest-daily-loadout">
                                <div><span>Preset de discos</span><strong>@step.DiskLoadout.LoadoutName</strong><small>@step.DiskLoadout.CapacityUsed / @step.DiskLoadout.CapacityLimit cap · bonus @step.DiskLoadout.PlannerBonus.ToString("0.#")</small></div>
                                <div class="conquest-daily-disk-chips">
                                    @foreach (ConquestDailyPlanApiClient.DataDiskViewModel disk in step.DiskLoadout.Disks)
                                    {
                                        <span>@disk.Name</span>
                                    }
                                </div>
                            </div>
                        }

                        <div class="conquest-daily-feats">
                            @foreach (ConquestDailyPlanApiClient.FeatProgressViewModel feat in step.FeatProgress)
                            {
                                <div class="conquest-daily-feat @(feat.CompletedByBattle ? "complete" : string.Empty)">
                                    <strong>@feat.FeatName</strong>
                                    <span>@feat.BeforeProgress → @feat.AfterProgress / @feat.Target @(feat.CompletedByBattle ? $"· completada · +{feat.RewardPointsGranted} pts" : string.Empty)</span>
                                </div>
                            }
                        </div>
                        <div class="conquest-daily-meta">
                            <span>score <strong>@step.Score.ToString("0.#")</strong></span>
                            <span>valor hazañas <strong>@step.FeatEfficiency.ToString("0.##")</strong></span>
                            <span>stamina <strong>@step.AverageStaminaBefore.ToString("0")% → @step.AverageStaminaAfter.ToString("0")%</strong></span>
                            <span>energía acumulada <strong>@step.CumulativeEnergySpent</strong></span>
                            <span>puntos proyectados <strong>@step.ProjectedRewardPointsAfterBattle</strong></span>
                            <span>pts/energía <strong>@step.RewardPointsPerEnergy.ToString("0.###")</strong></span>
                        </div>
                    </div>
                </article>
            }
        </div>
    }

    @if (DailyPlan.RecoveryPriority.Count > 0)
    {
        <div class="conquest-daily-recovery">
            <h3>Déjalos recuperar después del plan</h3>
            <div class="conquest-daily-recovery-list">
                @foreach (ConquestDailyPlanApiClient.RecoveryUnitViewModel recovery in DailyPlan.RecoveryPriority)
                {
                    PlayerApiClient.RosterUnitViewModel? rosterUnit = FindRosterUnit(recovery.DefinitionId);
                    <article class="conquest-daily-recovery-card">
                        <RichUnitPortrait Name="@recovery.Name"
                                          ThumbnailName="@recovery.ThumbnailName"
                                          RelicTier="@(rosterUnit?.RelicTier ?? 0)"
                                          Speed="@rosterUnit?.Stats?.Speed"
                                          EquippedMods="@(rosterUnit?.Mods?.EquippedCount ?? rosterUnit?.EquippedModCount)"
                                          SixDotMods="@rosterUnit?.Mods?.SixDotCount"
                                          ModSpeedBonus="@rosterUnit?.Mods?.SpeedBonus"
                                          Compact="true" />
                        <div class="conquest-daily-recovery-copy"><strong>@recovery.Name</strong><span>@recovery.FinalStamina% · reserva @recovery.ReserveFloorPercent%</span></div>
                    </article>
                }
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public ConquestDailyPlanApiClient.DailyPlanViewModel? DailyPlan { get; set; }

    [Parameter]
    public IReadOnlyCollection<PlayerApiClient.RosterUnitViewModel> Roster { get; set; } = [];

    private PlayerApiClient.RosterUnitViewModel? FindRosterUnit(string definitionId) =>
        Roster.FirstOrDefault(unit => string.Equals(unit.DefinitionId, definitionId, StringComparison.OrdinalIgnoreCase));

    private static string StaminaCss(int stamina) => stamina switch
    {
        >= 80 => "high",
        >= 60 => "medium",
        >= 40 => "low",
        _ => "critical"
    };

    private static string DailyStopReason(string value) => value switch
    {
        "RewardTargetReached" => "Objetivo de recompensa alcanzado",
        "EnergyBudgetExhausted" => "Sin energía suficiente",
        "AllFeatsCompleted" => "Hazañas proyectadas completadas",
        "NoUsableCharacters" => "Esperando stamina",
        "NoViableTeam" => "Sin otro equipo viable",
        "RosterUnavailable" => "Roster no disponible",
        _ => "Límite diario alcanzado"
    };
}
