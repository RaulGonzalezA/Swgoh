@page "/player/{AllyCode:long}"
@rendermode InteractiveServer
@inject PlayerApiClient PlayerClient
@inject GacApiClient GacClient

<PageTitle>@(_player is null ? "Roster" : $"{_player.Name} · Roster") · SWGOH Planner</PageTitle>

<section class="roster-page">
    <UiPageHeader Kicker="Roster explorer"
                  Title="@(_player?.Name ?? "Roster del jugador")"
                  Description="@RosterDescription"
                  BackHref="/"
                  BackText="Inicio">
        <Actions>
            @if (_analysis is not null)
            {
                <UiStatusPill Label="@($"R7+ · {_analysis.Relic7Plus}")" Tone="accent" ShowDot="true" />
                <UiStatusPill Label="@($"{_analysis.Omicrons} omicrons")" Tone="neutral" />
            }
        </Actions>
    </UiPageHeader>

    @if (_player is not null)
    {
        <nav class="player-subnav" aria-label="Secciones del jugador">
            <a class="active" href="@($"/player/{AllyCode}")">Roster</a>
            <a href="@($"/gac/{AllyCode}")">Gran Arena</a>
        </nav>
    }

    @if (_loadingProfile)
    {
        <UiLoadingState Title="Cargando roster…"
                        Description="Perfil, análisis y contexto de Gran Arena"
                        Class="roster-inline-state" />
    }
    else if (_error is not null)
    {
        <UiAlert Tone="danger"
                 Icon="!"
                 Title="No se ha podido cargar el roster"
                 Description="@_error" />
    }
    else if (_player is null)
    {
        <UiEmptyState Icon="?"
                      Title="Jugador no encontrado"
                      Description="Vuelve al inicio y comprueba el Ally Code.">
            <Actions>
                <a class="primary-button" href="/">Volver al inicio</a>
            </Actions>
        </UiEmptyState>
    }
    else
    {
        @if (_analysis is not null)
        {
            <div class="roster-metrics" aria-label="Resumen del roster">
                <UiMetric Label="Personajes"
                          Value="@(_analysis.CharacterCount.ToString("N0"))"
                          Hint="@($"{CompactNumber(_analysis.CharacterGalacticPower)} GP")"
                          Tone="accent" />
                <UiMetric Label="Naves"
                          Value="@(_analysis.ShipCount.ToString("N0"))"
                          Hint="@($"{CompactNumber(_analysis.ShipGalacticPower)} GP")" />
                <UiMetric Label="Reliquias"
                          Value="@(_analysis.RelicCharacters.ToString("N0"))"
                          Hint="@($"{_analysis.Relic9Plus} R9+ · {_analysis.Relic10} R10")" />
                <UiMetric Label="Habilidades"
                          Value="@($"{_analysis.Omicrons} O")"
                          Hint="@($"{_analysis.Zetas} zetas")" />
                <UiMetric Label="Mods completos"
                          Value="@(_analysis.FullyModdedCharacters.ToString("N0"))"
                          Hint="@($"{_analysis.UnmoddedCharacters} sin mods")"
                          Tone="success" />
            </div>
        }

        <UiCard Kicker="Explorar"
                Title="Filtra el roster"
                Subtitle="Busca por nombre, tipo, reliquia o habilidades sin perder el contexto táctico de cada unidad."
                Class="roster-filter-card">
            <HeaderActions>
                @if (_roster is not null)
                {
                    <UiStatusPill Label="@($"{_roster.Total:N0} resultados")" Tone="accent" />
                }
            </HeaderActions>
            <ChildContent>
                <form class="roster-filters" @onsubmit="LoadFirstPageAsync" @onsubmit:preventDefault>
                    <label class="roster-search" for="unitSearch">
                        <span>Buscar</span>
                        <input id="unitSearch" placeholder="Nombre de personaje o nave…" @bind="_search" />
                    </label>
                    <label for="unitType">
                        <span>Tipo</span>
                        <select id="unitType" @bind="_type">
                            <option value="All">Todo</option>
                            <option value="Character">Personajes</option>
                            <option value="Ship">Naves</option>
                        </select>
                    </label>
                    <label for="minRelic">
                        <span>Reliquia mínima</span>
                        <select id="minRelic" @bind="_minRelic">
                            <option value="">Cualquiera</option>
                            <option value="1">R1+</option>
                            <option value="5">R5+</option>
                            <option value="7">R7+</option>
                            <option value="8">R8+</option>
                            <option value="9">R9+</option>
                            <option value="10">R10</option>
                        </select>
                    </label>
                    <label for="abilityFilter">
                        <span>Habilidad</span>
                        <select id="abilityFilter" @bind="_abilityFilter">
                            <option value="All">Todas</option>
                            <option value="Zeta">Con zeta</option>
                            <option value="Omicron">Con omicron</option>
                        </select>
                    </label>
                    <label for="sortBy">
                        <span>Ordenar</span>
                        <select id="sortBy" @bind="_orderBy">
                            <option value="GalacticPower">Poder galáctico</option>
                            <option value="RelicTier">Reliquia</option>
                            <option value="Rarity">Estrellas</option>
                            <option value="GearTier">Gear</option>
                            <option value="Name">Nombre</option>
                        </select>
                    </label>
                    <label for="sortDirection">
                        <span>Dirección</span>
                        <select id="sortDirection" @bind="_direction">
                            <option value="Descending">Mayor primero</option>
                            <option value="Ascending">Menor primero</option>
                        </select>
                    </label>
                    <div class="roster-filter-actions">
                        <button class="secondary-button" type="submit" disabled="@_loadingRoster">Aplicar</button>
                        @if (HasActiveFilters)
                        {
                            <button class="ghost-button" type="button" @onclick="ResetFiltersAsync" disabled="@_loadingRoster">Limpiar</button>
                        }
                    </div>
                </form>

                @if (_roster is not null)
                {
                    <div class="roster-filter-summary">
                        <span>Vista actual</span>
                        <strong>@ActiveFilterSummary</strong>
                    </div>
                }
            </ChildContent>
        </UiCard>

        @if (_loadingRoster)
        {
            <UiLoadingState Title="Actualizando resultados…"
                            Description="Aplicando filtros y ordenación"
                            Class="roster-inline-state" />
        }
        else if (_roster is null || _roster.Items.Count == 0)
        {
            <UiEmptyState Icon="⌕"
                          Title="Sin resultados"
                          Description="No hay unidades que coincidan con estos filtros. Limpia alguno o prueba otra búsqueda.">
                <Actions>
                    @if (HasActiveFilters)
                    {
                        <button class="secondary-button" type="button" @onclick="ResetFiltersAsync">Limpiar filtros</button>
                    }
                </Actions>
            </UiEmptyState>
        }
        else
        {
            <header class="roster-section-heading">
                <div>
                    <span class="ui-kicker">Colección</span>
                    <h2>Unidades del roster</h2>
                </div>
                <p>Abre una ficha para ver progreso y contexto de Gran Arena.</p>
            </header>

            <div class="roster-collection-grid">
                @foreach (PlayerApiClient.RosterUnitViewModel unit in _roster.Items)
                {
                    <RosterUnitCard Unit="unit" OpenDetails="OpenUnitDetails" @key="unit.Id" />
                }
            </div>

            <nav class="roster-pagination" aria-label="Paginación del roster">
                <button class="ghost-button" type="button" @onclick="PreviousPageAsync" disabled="@(_roster.Page <= 1 || _loadingRoster)">← Anterior</button>
                <span>Página <strong>@_roster.Page</strong> de <strong>@_roster.TotalPages</strong></span>
                <button class="ghost-button" type="button" @onclick="NextPageAsync" disabled="@(_roster.Page >= _roster.TotalPages || _loadingRoster)">Siguiente →</button>
            </nav>
        }
    }
</section>

<UnitDetailDrawer Unit="_selectedUnit"
                  Eyebrow="Ficha de roster"
                  ContextTitle="Uso en la Gran Arena actual"
                  Context="El contexto se calcula a partir del plan de batalla ya generado por la aplicación."
                  TacticalNotes="SelectedUnitTacticalNotes"
                  RosterAllyCode="AllyCode"
                  GacAllyCode="AllyCode"
                  OnClose="CloseUnitDetails" />

@code {
    [Parameter]
    public long AllyCode { get; set; }

    private PlayerApiClient.PlayerViewModel? _player;
    private PlayerApiClient.PlayerRosterAnalysisViewModel? _analysis;
    private PlayerApiClient.RosterPageViewModel? _roster;
    private GacApiClient.CurrentGacBattlePlanViewModel? _currentGacPlan;
    private PlayerApiClient.RosterUnitViewModel? _selectedUnit;
    private string _search = string.Empty;
    private string _type = "All";
    private string _minRelic = string.Empty;
    private string _abilityFilter = "All";
    private string _orderBy = "GalacticPower";
    private string _direction = "Descending";
    private string? _error;
    private bool _loadingProfile = true;
    private bool _loadingRoster;
    private int _page = 1;

    private string RosterDescription => _player is null
        ? "Explora personajes, naves, mods y contexto táctico desde un único roster."
        : $"{_player.GalacticPower:N0} GP · {_player.RosterCount:N0} unidades · #{FormatAllyCode(_player.AllyCode)}";

    private IReadOnlyCollection<string> SelectedUnitTacticalNotes =>
        _selectedUnit is null ? [] : BuildUnitTacticalNotes(_selectedUnit);

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_search) ||
        _type != "All" ||
        !string.IsNullOrWhiteSpace(_minRelic) ||
        _abilityFilter != "All" ||
        _orderBy != "GalacticPower" ||
        _direction != "Descending";

    private string ActiveFilterSummary
    {
        get
        {
            var parts = new List<string>();
            if (_type != "All")
            {
                parts.Add(_type == "Ship" ? "naves" : "personajes");
            }

            if (!string.IsNullOrWhiteSpace(_minRelic))
            {
                parts.Add($"R{_minRelic}+");
            }

            if (_abilityFilter != "All")
            {
                parts.Add(_abilityFilter == "Zeta" ? "con zeta" : "con omicron");
            }

            parts.Add(SortLabel());
            return string.Join(" · ", parts);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _loadingProfile = true;
        _error = null;
        _selectedUnit = null;
        _currentGacPlan = null;
        try
        {
            _player = await PlayerClient.GetAsync(AllyCode);
            if (_player is null)
            {
                return;
            }

            _analysis = await PlayerClient.GetAnalysisAsync(AllyCode);
            await LoadRosterAsync();
            await LoadCurrentGacContextAsync();
        }
        catch (HttpRequestException)
        {
            _error = "La API no está disponible en este momento.";
        }
        finally
        {
            _loadingProfile = false;
        }
    }

    private async Task LoadCurrentGacContextAsync()
    {
        try
        {
            GacApiClient.CurrentGacResult result = await GacClient.GetCurrentOpponentAsync(AllyCode);
            _currentGacPlan = result.Scouting?.BattlePlan;
        }
        catch (HttpRequestException)
        {
            _currentGacPlan = null;
        }
    }

    private async Task LoadFirstPageAsync()
    {
        _page = 1;
        await LoadRosterAsync();
    }

    private async Task ResetFiltersAsync()
    {
        _search = string.Empty;
        _type = "All";
        _minRelic = string.Empty;
        _abilityFilter = "All";
        _orderBy = "GalacticPower";
        _direction = "Descending";
        _page = 1;
        await LoadRosterAsync();
    }

    private async Task PreviousPageAsync()
    {
        if (_page <= 1)
        {
            return;
        }

        _page--;
        await LoadRosterAsync();
    }

    private async Task NextPageAsync()
    {
        if (_roster is null || _page >= _roster.TotalPages)
        {
            return;
        }

        _page++;
        await LoadRosterAsync();
    }

    private async Task LoadRosterAsync()
    {
        _loadingRoster = true;
        _error = null;
        try
        {
            bool? hasZeta = _abilityFilter == "Zeta" ? true : null;
            bool? hasOmicron = _abilityFilter == "Omicron" ? true : null;
            _roster = await PlayerClient.GetRosterAsync(
                AllyCode,
                page: _page,
                pageSize: 24,
                search: _search,
                type: _type,
                minRelic: ParseOptionalInt(_minRelic),
                hasZeta: hasZeta,
                hasOmicron: hasOmicron,
                orderBy: _orderBy,
                direction: _direction);
        }
        catch (HttpRequestException)
        {
            _error = "No se ha podido consultar el roster.";
        }
        finally
        {
            _loadingRoster = false;
        }
    }

    private void OpenUnitDetails(PlayerApiClient.RosterUnitViewModel unit) => _selectedUnit = unit;

    private void CloseUnitDetails() => _selectedUnit = null;

    private IReadOnlyCollection<string> BuildUnitTacticalNotes(PlayerApiClient.RosterUnitViewModel unit)
    {
        if (_currentGacPlan is null)
        {
            return ["No hay un plan de Gran Arena activo disponible para cruzar esta unidad."];
        }

        var notes = new List<string>();

        foreach (GacApiClient.AttackReserveViewModel reserve in _currentGacPlan.AttackReserves
                     .Where(reserve => SameUnit(reserve.Unit.DefinitionId, unit.DefinitionId))
                     .Take(2))
        {
            notes.Add($"Reserva de ataque · {FriendlyRole(reserve.Role)} · prioridad {FriendlyPriority(reserve.Priority)}. {reserve.Reason}");
        }

        foreach (GacApiClient.CounterSuggestionViewModel counter in _currentGacPlan.CounterSuggestions
                     .Where(counter => CounterUsesUnit(counter, unit.DefinitionId))
                     .Take(3))
        {
            string evidence = counter.Uses is null
                ? $"{FriendlyConfidence(counter.Confidence)} · {FriendlySource(counter.Source)}"
                : $"{counter.Uses} muestras · {FriendlyConfidence(counter.Confidence)} · {FriendlySource(counter.Source)}";
            notes.Add($"Counter contra {counter.Threat.Name} · {evidence}.");
        }

        if (notes.Count == 0)
        {
            notes.Add("No aparece como reserva prioritaria ni como pieza de los counters recomendados para el enfrentamiento actual.");
        }

        return notes;
    }

    private static bool CounterUsesUnit(GacApiClient.CounterSuggestionViewModel counter, string definitionId) =>
        (counter.RecommendedTeam?.Any(unit => SameUnit(unit.DefinitionId, definitionId)) ?? false) ||
        counter.CandidateAnchors.Any(unit => SameUnit(unit.DefinitionId, definitionId));

    private static bool SameUnit(string left, string right) =>
        string.Equals(left, right, StringComparison.OrdinalIgnoreCase);

    private string SortLabel()
    {
        string field = _orderBy switch
        {
            "RelicTier" => "reliquia",
            "Rarity" => "estrellas",
            "GearTier" => "gear",
            "Name" => "nombre",
            _ => "GP"
        };
        return $"{field} {(_direction == "Ascending" ? "↑" : "↓")}";
    }

    private static string FriendlySource(string source) => source switch
    {
        "GlobalHistoricalCounterData" => "histórico global",
        "HistoricalCounterPattern" => "histórico del rival",
        "ObservedCounterStatistics" => "histórico observado",
        "StoredGacHistory" => "histórico GAC",
        "RosterStrengthHeuristic" => "estimación por roster",
        _ => source
    };

    private static string FriendlyPriority(string priority) => priority switch
    {
        "Critical" => "crítica",
        "High" => "alta",
        "Medium" => "media",
        "Watch" => "vigilar",
        "Low" => "baja",
        _ => priority
    };

    private static string FriendlyRole(string role) => role switch
    {
        "GlAnswer" => "respuesta GL",
        "GacSpecialist" => "especialista GAC",
        "FleetAnchor" => "ancla de flota",
        "HighPowerFlex" => "comodín de alto GP",
        _ => role
    };

    private static string FriendlyConfidence(string confidence) => confidence switch
    {
        "High" => "confianza alta",
        "Medium" => "confianza media",
        "Low" => "confianza baja",
        _ => confidence
    };

    private static int? ParseOptionalInt(string value) =>
        int.TryParse(value, out int parsed) ? parsed : null;

    private static string CompactNumber(long value) => value switch
    {
        >= 1_000_000 => $"{value / 1_000_000d:0.##}M",
        >= 1_000 => $"{value / 1_000d:0.#}K",
        _ => value.ToString("N0")
    };

    private static string FormatAllyCode(long allyCode)
    {
        string value = allyCode.ToString("000000000");
        return $"{value[..3]}-{value[3..6]}-{value[6..]}";
    }
}
