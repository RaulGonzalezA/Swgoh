@page "/player/{AllyCode:long}"
@rendermode InteractiveServer
@inject PlayerApiClient PlayerClient

<PageTitle>@(_player is null ? "Roster" : $"{_player.Name} · Roster") · SWGOH Planner</PageTitle>

<div class="page-heading-row roster-heading">
    <div>
        <a class="back-link" href="/">← Dashboard</a>
        <span class="eyebrow">Roster explorer</span>
        <h1>@(_player?.Name ?? "Roster del jugador")</h1>
        @if (_player is not null)
        {
            <p class="page-lead">@_player.GalacticPower.ToString("N0") GP · @_player.RosterCount unidades · #@FormatAllyCode(_player.AllyCode)</p>
        }
    </div>
    @if (_analysis is not null)
    {
        <div class="heading-stat">
            <span>R7+</span>
            <strong>@_analysis.Relic7Plus</strong>
            <small>@_analysis.Omicrons omicrons</small>
        </div>
    }
</div>

@if (_player is not null)
{
    <nav class="player-subnav" aria-label="Secciones del jugador">
        <a class="active" href="@($"/player/{AllyCode}")">Roster</a>
        <a href="@($"/gac/{AllyCode}")">Gran Arena</a>
    </nav>
}

@if (_loadingProfile)
{
    <div class="loading-panel"><span class="spinner"></span> Cargando roster…</div>
}
else if (_error is not null)
{
    <div class="status-card status-error" role="alert">
        <span class="status-icon">!</span>
        <div><strong>No se ha podido cargar el roster</strong><p>@_error</p></div>
    </div>
}
else if (_player is null)
{
    <div class="status-card"><span class="status-icon">?</span><div><strong>Jugador no encontrado</strong><p>Vuelve al dashboard y comprueba el Ally Code.</p></div></div>
}
else
{
    @if (_analysis is not null)
    {
        <section class="roster-overview" aria-label="Resumen del roster">
            <div>
                <span>Personajes</span>
                <strong>@_analysis.CharacterCount</strong>
                <small>@CompactNumber(_analysis.CharacterGalacticPower) GP</small>
            </div>
            <div>
                <span>Naves</span>
                <strong>@_analysis.ShipCount</strong>
                <small>@CompactNumber(_analysis.ShipGalacticPower) GP</small>
            </div>
            <div>
                <span>Reliquias</span>
                <strong>@_analysis.RelicCharacters</strong>
                <small>@_analysis.Relic9Plus R9+ · @_analysis.Relic10 R10</small>
            </div>
            <div>
                <span>Habilidades</span>
                <strong>@_analysis.Omicrons O</strong>
                <small>@_analysis.Zetas zetas</small>
            </div>
            <div>
                <span>Mods completos</span>
                <strong>@_analysis.FullyModdedCharacters</strong>
                <small>@_analysis.UnmoddedCharacters sin mods</small>
            </div>
        </section>
    }

    <section class="roster-toolbar roster-toolbar-v2">
        <form class="roster-filters roster-filters-v2" @onsubmit="LoadFirstPageAsync" @onsubmit:preventDefault>
            <div class="filter-search filter-search-wide">
                <label for="unitSearch">Buscar</label>
                <input id="unitSearch" placeholder="Nombre de personaje o nave…" @bind="_search" />
            </div>
            <div class="filter-select">
                <label for="unitType">Tipo</label>
                <select id="unitType" @bind="_type">
                    <option value="All">Todo</option>
                    <option value="Character">Personajes</option>
                    <option value="Ship">Naves</option>
                </select>
            </div>
            <div class="filter-select">
                <label for="minRelic">Reliquia mínima</label>
                <select id="minRelic" @bind="_minRelic">
                    <option value="">Cualquiera</option>
                    <option value="1">R1+</option>
                    <option value="5">R5+</option>
                    <option value="7">R7+</option>
                    <option value="8">R8+</option>
                    <option value="9">R9+</option>
                    <option value="10">R10</option>
                </select>
            </div>
            <div class="filter-select">
                <label for="abilityFilter">Habilidad</label>
                <select id="abilityFilter" @bind="_abilityFilter">
                    <option value="All">Todas</option>
                    <option value="Zeta">Con zeta</option>
                    <option value="Omicron">Con omicron</option>
                </select>
            </div>
            <div class="filter-select">
                <label for="sortBy">Ordenar</label>
                <select id="sortBy" @bind="_orderBy">
                    <option value="GalacticPower">Poder galáctico</option>
                    <option value="RelicTier">Reliquia</option>
                    <option value="Rarity">Estrellas</option>
                    <option value="GearTier">Gear</option>
                    <option value="Name">Nombre</option>
                </select>
            </div>
            <div class="filter-select filter-direction">
                <label for="sortDirection">Dirección</label>
                <select id="sortDirection" @bind="_direction">
                    <option value="Descending">Mayor primero</option>
                    <option value="Ascending">Menor primero</option>
                </select>
            </div>
            <div class="filter-actions">
                <button class="secondary-button" type="submit" disabled="@_loadingRoster">Aplicar</button>
                @if (HasActiveFilters)
                {
                    <button class="ghost-button" type="button" @onclick="ResetFiltersAsync" disabled="@_loadingRoster">Limpiar</button>
                }
            </div>
        </form>

        <div class="roster-result-summary">
            @if (_roster is not null)
            {
                <strong>@_roster.Total.ToString("N0")</strong>
                <span>resultados</span>
                <small>@ActiveFilterSummary</small>
            }
        </div>
    </section>

    @if (_loadingRoster)
    {
        <div class="loading-panel"><span class="spinner"></span> Actualizando resultados…</div>
    }
    else if (_roster is null || _roster.Items.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-icon">⌕</span>
            <h2>Sin resultados</h2>
            <p>No hay unidades que coincidan con estos filtros. Limpia alguno o prueba otra búsqueda.</p>
            @if (HasActiveFilters)
            {
                <button class="secondary-button" type="button" @onclick="ResetFiltersAsync">Limpiar filtros</button>
            }
        </div>
    }
    else
    {
        <div class="collection-heading-row">
            <div>
                <span class="section-kicker">Colección</span>
                <h2>Unidades del roster</h2>
            </div>
            <small>Los retratos usan el asset de Game Data cuando está disponible.</small>
        </div>

        <div class="roster-grid roster-grid-v2 roster-collection-grid">
            @foreach (PlayerApiClient.RosterUnitViewModel unit in _roster.Items)
            {
                string? portraitUrl = GetPortraitUrl(unit.ThumbnailName);
                <article class="unit-card unit-card-v2 unit-card-collection" @key="unit.Id">
                    <div class="unit-portrait-shell @(unit.IsShip ? "unit-portrait-ship" : string.Empty)">
                        <span class="unit-portrait-fallback" aria-hidden="true">@Initial(unit.Name)</span>
                        @if (portraitUrl is not null)
                        {
                            <img class="unit-portrait"
                                 src="@portraitUrl"
                                 alt="Retrato de @unit.Name"
                                 loading="lazy"
                                 decoding="async"
                                 referrerpolicy="no-referrer"
                                 onerror="this.style.display='none'" />
                        }
                        <span class="unit-kind-chip">@(unit.IsShip ? "Nave" : "Personaje")</span>
                        @if (unit.RelicTier > 0)
                        {
                            <span class="portrait-progress portrait-relic">R@unit.RelicTier</span>
                        }
                        else
                        {
                            <span class="portrait-progress">G@unit.GearTier</span>
                        }
                    </div>

                    <div class="unit-main unit-collection-main">
                        <div class="unit-title-row">
                            <h2 title="@unit.Name">@unit.Name</h2>
                        </div>
                        <div class="unit-stars" aria-label="@unit.Rarity estrellas">@RarityLabel(unit.Rarity)</div>
                        <div class="unit-meta unit-meta-v2">
                            <span class="gp-value">@unit.GalacticPower.ToString("N0") GP</span>
                            @if (!unit.IsShip)
                            {
                                <span class="mod-chip @(unit.EquippedModCount >= 6 ? "mod-chip-complete" : string.Empty)">@unit.EquippedModCount/6 mods</span>
                            }
                            @if (unit.ZetaCount > 0)
                            {
                                <span class="ability-chip">Z @unit.ZetaCount</span>
                            }
                            @if (unit.OmicronCount > 0)
                            {
                                <span class="ability-chip ability-chip-omi">O @unit.OmicronCount</span>
                            }
                        </div>
                        @if (unit.Factions.Count > 0)
                        {
                            <div class="faction-row">
                                @foreach (string faction in unit.Factions.Take(2))
                                {
                                    <span title="@faction">@faction</span>
                                }
                                @if (unit.Factions.Count > 2)
                                {
                                    <span>+@(unit.Factions.Count - 2)</span>
                                }
                            </div>
                        }
                    </div>
                </article>
            }
        </div>

        <nav class="pagination" aria-label="Paginación del roster">
            <button class="ghost-button" @onclick="PreviousPageAsync" disabled="@(_roster.Page <= 1 || _loadingRoster)">← Anterior</button>
            <span>Página <strong>@_roster.Page</strong> de <strong>@_roster.TotalPages</strong></span>
            <button class="ghost-button" @onclick="NextPageAsync" disabled="@(_roster.Page >= _roster.TotalPages || _loadingRoster)">Siguiente →</button>
        </nav>
    }
}

@code {
    private const string AssetBaseUrl = "https://swgoh.gg/static/img/assets/";

    [Parameter]
    public long AllyCode { get; set; }

    private PlayerApiClient.PlayerViewModel? _player;
    private PlayerApiClient.PlayerRosterAnalysisViewModel? _analysis;
    private PlayerApiClient.RosterPageViewModel? _roster;
    private string _search = string.Empty;
    private string _type = "All";
    private string _minRelic = string.Empty;
    private string _abilityFilter = "All";
    private string _orderBy = "GalacticPower";
    private string _direction = "Descending";
    private string? _error;
    private bool _loadingProfile = true;
    private bool _loadingRoster;
    private int _page = 1;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_search) ||
        _type != "All" ||
        !string.IsNullOrWhiteSpace(_minRelic) ||
        _abilityFilter != "All" ||
        _orderBy != "GalacticPower" ||
        _direction != "Descending";

    private string ActiveFilterSummary
    {
        get
        {
            var parts = new List<string>();
            if (_type != "All")
            {
                parts.Add(_type == "Ship" ? "naves" : "personajes");
            }

            if (!string.IsNullOrWhiteSpace(_minRelic))
            {
                parts.Add($"R{_minRelic}+");
            }

            if (_abilityFilter != "All")
            {
                parts.Add(_abilityFilter == "Zeta" ? "con zeta" : "con omicron");
            }

            parts.Add(SortLabel());
            return string.Join(" · ", parts);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _loadingProfile = true;
        _error = null;
        try
        {
            _player = await PlayerClient.GetAsync(AllyCode);
            if (_player is null)
            {
                return;
            }

            _analysis = await PlayerClient.GetAnalysisAsync(AllyCode);
            await LoadRosterAsync();
        }
        catch (HttpRequestException)
        {
            _error = "La API no está disponible en este momento.";
        }
        finally
        {
            _loadingProfile = false;
        }
    }

    private async Task LoadFirstPageAsync()
    {
        _page = 1;
        await LoadRosterAsync();
    }

    private async Task ResetFiltersAsync()
    {
        _search = string.Empty;
        _type = "All";
        _minRelic = string.Empty;
        _abilityFilter = "All";
        _orderBy = "GalacticPower";
        _direction = "Descending";
        _page = 1;
        await LoadRosterAsync();
    }

    private async Task PreviousPageAsync()
    {
        if (_page <= 1)
        {
            return;
        }

        _page--;
        await LoadRosterAsync();
    }

    private async Task NextPageAsync()
    {
        if (_roster is null || _page >= _roster.TotalPages)
        {
            return;
        }

        _page++;
        await LoadRosterAsync();
    }

    private async Task LoadRosterAsync()
    {
        _loadingRoster = true;
        _error = null;
        try
        {
            bool? hasZeta = _abilityFilter == "Zeta" ? true : null;
            bool? hasOmicron = _abilityFilter == "Omicron" ? true : null;
            _roster = await PlayerClient.GetRosterAsync(
                AllyCode,
                page: _page,
                pageSize: 24,
                search: _search,
                type: _type,
                minRelic: ParseOptionalInt(_minRelic),
                hasZeta: hasZeta,
                hasOmicron: hasOmicron,
                orderBy: _orderBy,
                direction: _direction);
        }
        catch (HttpRequestException)
        {
            _error = "No se ha podido consultar el roster.";
        }
        finally
        {
            _loadingRoster = false;
        }
    }

    private string SortLabel()
    {
        string field = _orderBy switch
        {
            "RelicTier" => "reliquia",
            "Rarity" => "estrellas",
            "GearTier" => "gear",
            "Name" => "nombre",
            _ => "GP"
        };
        return $"{field} {(_direction == "Ascending" ? "↑" : "↓")}";
    }

    private static string? GetPortraitUrl(string? thumbnailName)
    {
        if (string.IsNullOrWhiteSpace(thumbnailName))
        {
            return null;
        }

        string assetName = thumbnailName.Trim();
        if (!assetName.EndsWith(".png", StringComparison.OrdinalIgnoreCase))
        {
            assetName += ".png";
        }

        return AssetBaseUrl + Uri.EscapeDataString(assetName);
    }

    private static int? ParseOptionalInt(string value) =>
        int.TryParse(value, out int parsed) ? parsed : null;

    private static string Initial(string name) => string.IsNullOrWhiteSpace(name)
        ? "?"
        : char.ToUpperInvariant(name.Trim()[0]).ToString();

    private static string RarityLabel(int rarity) => new('★', Math.Clamp(rarity, 0, 7));

    private static string CompactNumber(long value) => value switch
    {
        >= 1_000_000 => $"{value / 1_000_000d:0.##}M",
        >= 1_000 => $"{value / 1_000d:0.#}K",
        _ => value.ToString("N0")
    };

    private static string FormatAllyCode(long allyCode)
    {
        string value = allyCode.ToString("000000000");
        return $"{value[..3]}-{value[3..6]}-{value[6..]}";
    }
}
