@page "/investments/{AllyCode:long}"
@using Swgoh.Blazor.Clients
@inject InvestmentApiClient InvestmentClient

<PageTitle>Investment Optimizer · SWGOH Assistant</PageTitle>

<section class="investment-shell">
    @if (_loading)
    {
        <div class="investment-state">Cruzando impacto, coste e inventario de GAC, RotE, Conquista, Era y Coliseo…</div>
    }
    else if (_error is not null)
    {
        <div class="investment-state error">@_error</div>
    }
    else if (_optimization is null)
    {
        <div class="investment-state">No hay un jugador importado con ese ally code.</div>
    }
    else
    {
        <header class="investment-hero">
            <div>
                <span class="section-kicker">Investment Optimizer global</span>
                <h1>¿Dónde merece la pena invertir ahora?</h1>
                <p>Combina impacto transversal, coste teórico y tu snapshot real para destacar los objetivos cuyos materiales de reliquia ya tienes más cubiertos.</p>
            </div>
            <button class="secondary-button" type="button" @onclick="ReloadAsync" disabled="@_loading">Recalcular</button>
        </header>

        <div class="investment-summary">
            <article><span>Recomendaciones</span><strong>@_optimization.Recommendations.Count</strong><small>ordenadas por valor real</small></article>
            <article><span>Materiales listos</span><strong>@_optimization.MaterialsReadyRecommendations</strong><small>relic mats cubiertos</small></article>
            <article><span>Con inventario</span><strong>@_optimization.InventoryAdjustedRecommendations</strong><small>ranking ajustado a recursos</small></article>
            <article><span>Roster</span><strong>@AgeLabel(_optimization.RosterUpdatedAtUtc)</strong><small>frescura de los datos base</small></article>
        </div>

        <InvestmentTargetPlan AllyCode="AllyCode" />
        <FarmingPlanPanel AllyCode="AllyCode" RefreshToken="_farmingRefreshToken" />
        <DailyFarmingPlanPanel AllyCode="AllyCode" RefreshToken="_farmingRefreshToken" />

        @if (_inventory is not null)
        {
            <section class="inventory-panel">
                <div class="inventory-header">
                    <div>
                        <span class="section-kicker">Inventario real</span>
                        <h2>Materiales disponibles</h2>
                        <p>El proveedor público del juego no expone materiales privados. Guarda aquí un snapshot real y el optimizador descontará estas cantidades de los requisitos de reliquia conocidos.</p>
                    </div>
                    <div class="inventory-meta">
                        @if (_inventory.HasSnapshot && _inventory.CapturedAtUtc is DateTimeOffset captured)
                        {
                            <strong>@AgeLabel(captured)</strong>
                            <small>@(_inventory.Source ?? "manual")</small>
                        }
                        else
                        {
                            <strong>Sin snapshot</strong>
                            <small>se usa coste relativo</small>
                        }
                    </div>
                </div>

                <div class="inventory-source">
                    <label for="inventory-source">Origen</label>
                    <input id="inventory-source" maxlength="80" @bind="_inventory.Source" placeholder="manual, captura del juego…" />
                </div>

                @foreach (var group in _inventory.Resources.OrderBy(resource => resource.SortOrder).GroupBy(resource => resource.Kind))
                {
                    <div class="inventory-group">
                        <h3>@InventoryKindLabel(group.Key)</h3>
                        <div class="inventory-grid">
                            @foreach (InvestmentApiClient.InventoryResourceViewModel resource in group)
                            {
                                <label class="inventory-resource">
                                    <span>@resource.Name</span>
                                    <input type="number" min="0" step="1" @bind="resource.Quantity" />
                                </label>
                            }
                        </div>
                    </div>
                }

                <div class="inventory-actions">
                    <button class="secondary-button" type="button" @onclick="SaveInventoryAsync" disabled="@_inventorySaving">
                        @(_inventorySaving ? "Guardando…" : "Guardar inventario y recalcular")
                    </button>
                    @if (!string.IsNullOrWhiteSpace(_inventoryMessage))
                    {
                        <span>@_inventoryMessage</span>
                    }
                </div>
            </section>
        }

        <section class="investment-modules" aria-label="Cobertura por módulo">
            @foreach (InvestmentApiClient.ModuleStatusViewModel module in _optimization.Modules)
            {
                <button type="button" class="investment-module @(module.Available ? "available" : "unavailable") @(_selectedModule == module.Module ? "selected" : string.Empty)" title="@module.Message" @onclick="() => ToggleModule(module.Module)">
                    <span>@ModuleLabel(module.Module)</span><strong>@module.SignalCount</strong><small>@(module.Available ? "señales" : "no disponible")</small>
                </button>
            }
            @if (_selectedModule is not null)
            {
                <button type="button" class="investment-clear-filter" @onclick="ClearModuleFilter">Ver todas</button>
            }
        </section>

        <div class="investment-explainer">
            <strong>Valor real</strong>
            <span>Cuando hay inventario, el ranking combina impacto/coste con cobertura de relic mats. Tenerlos cubiertos mejora la prioridad, pero no afirma que dispongas también de todo el gear, fragmentos u otros prerrequisitos no visibles.</span>
        </div>

        @if (FilteredRecommendations.Count == 0)
        {
            <div class="investment-state compact">No hay recomendaciones para el filtro seleccionado.</div>
        }
        else
        {
            <div class="investment-list">
                @foreach (InvestmentApiClient.RecommendationViewModel recommendation in FilteredRecommendations)
                {
                    <article class="investment-card priority-@PriorityCss(recommendation.Priority)">
                        <div class="investment-rank">#@recommendation.Rank</div>
                        <div class="investment-unit">
                            @if (!string.IsNullOrWhiteSpace(recommendation.ThumbnailName))
                            {
                                <img src="@($"/unit-assets/{Uri.EscapeDataString(recommendation.ThumbnailName)}")" alt="" loading="lazy" />
                            }
                            else
                            {
                                <span class="investment-unit-fallback">@Initials(recommendation.Name)</span>
                            }
                            <div>
                                <span class="investment-priority">@recommendation.Priority · impacto @recommendation.Score.ToString("0.#")</span>
                                <h2>@recommendation.Name</h2>
                                <p class="investment-action">@recommendation.SuggestedAction</p>
                                <div class="investment-value-row">
                                    <span><strong>@(recommendation.UsesRealInventory ? "Valor real" : "Valor")</strong> @recommendation.InventoryAdjustedValueScore.ToString("0.#") · @recommendation.ValueRating</span>
                                    @if (recommendation.ImpactPerCost is decimal efficiency)
                                    {
                                        <span><strong>Impacto/coste</strong> @efficiency.ToString("0.##")</span>
                                    }
                                </div>

                                @if (recommendation.Inventory is not null)
                                {
                                    <div class="inventory-fit @(recommendation.Inventory.MaterialsReady ? "ready" : "missing")">
                                        <strong>@(recommendation.Inventory.MaterialsReady ? "Relic mats cubiertos" : $"Cobertura {recommendation.Inventory.Coverage:P0}")</strong>
                                        <small>@recommendation.Inventory.Summary</small>
                                        @if (!recommendation.Inventory.MaterialsReady)
                                        {
                                            <div class="missing-resources">
                                                @foreach (InvestmentApiClient.ResourceNeedViewModel need in recommendation.Inventory.Resources.Where(need => need.Missing > 0).Take(6))
                                                {
                                                    <span><strong>@need.ResourceName:</strong> faltan @need.Missing.ToString("N0") · tienes @need.Available.ToString("N0") / @need.Required.ToString("N0")</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else if (recommendation.EstimatedCost is not null)
                                {
                                    <div class="investment-cost">
                                        <strong>Coste @recommendation.EstimatedCost.CostBand · índice @recommendation.EstimatedCost.CostIndex.ToString("0.#")</strong>
                                        <small>@recommendation.EstimatedCost.Summary</small>
                                    </div>
                                }
                                else
                                {
                                    <div class="investment-cost strategic"><strong>Coste no cuantificado</strong><small>Prioridad estratégica sin objetivo concreto de reliquia/estrellas.</small></div>
                                }

                                <p class="investment-benefit">@recommendation.BenefitSummary</p>
                                <div class="investment-badges">
                                    @foreach (InvestmentApiClient.ModuleImpactViewModel impact in recommendation.Impacts)
                                    {
                                        <span>@ModuleLabel(impact.Module)</span>
                                    }
                                    @if (recommendation.ModuleCount >= 2)
                                    {
                                        <span class="cross-module">+ transversal</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="investment-impact-list">
                            @foreach (InvestmentApiClient.ModuleImpactViewModel impact in recommendation.Impacts)
                            {
                                <div class="investment-impact">
                                    <div><strong>@ModuleLabel(impact.Module)</strong><span>+@impact.Score.ToString("0.#")</span></div>
                                    <p>@impact.Reason</p>
                                    @if (impact.ConcreteTarget)
                                    {
                                        <small>@ImpactTarget(impact)</small>
                                    }
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    }
</section>

@code {
    [Parameter] public long AllyCode { get; set; }
    private bool _loading = true;
    private bool _inventorySaving;
    private long _farmingRefreshToken;
    private string? _error;
    private string? _inventoryMessage;
    private InvestmentApiClient.OptimizationViewModel? _optimization;
    private InvestmentApiClient.InventoryViewModel? _inventory;
    private InvestmentApiClient.InvestmentModuleViewModel? _selectedModule;

    private IReadOnlyCollection<InvestmentApiClient.RecommendationViewModel> FilteredRecommendations =>
        _optimization is null ? [] : _selectedModule is null ? _optimization.Recommendations : [.. _optimization.Recommendations.Where(item => item.Impacts.Any(impact => impact.Module == _selectedModule))];

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task ReloadAsync()
    {
        await LoadAsync();
        _farmingRefreshToken++;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _inventoryMessage = null;
        try
        {
            Task<InvestmentApiClient.OptimizationViewModel?> optimizationTask = InvestmentClient.GetCurrentAsync(AllyCode);
            Task<InvestmentApiClient.InventoryViewModel> inventoryTask = InvestmentClient.GetInventoryAsync(AllyCode);
            await Task.WhenAll(optimizationTask, inventoryTask);
            _optimization = await optimizationTask;
            _inventory = await inventoryTask;
        }
        catch (Exception exception)
        {
            _error = $"No se pudo calcular el Investment Optimizer: {exception.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveInventoryAsync()
    {
        if (_inventory is null || _inventorySaving)
        {
            return;
        }

        _inventorySaving = true;
        _inventoryMessage = null;
        try
        {
            _inventory = await InvestmentClient.SaveInventoryAsync(AllyCode, _inventory);
            _optimization = await InvestmentClient.GetCurrentAsync(AllyCode);
            _farmingRefreshToken++;
            _inventoryMessage = "Inventario guardado. Ranking y plan de farmeo recalculados con tus materiales reales.";
        }
        catch (Exception exception)
        {
            _inventoryMessage = $"No se pudo guardar el inventario: {exception.Message}";
        }
        finally
        {
            _inventorySaving = false;
        }
    }

    private void ToggleModule(InvestmentApiClient.InvestmentModuleViewModel module) => _selectedModule = _selectedModule == module ? null : module;
    private void ClearModuleFilter() => _selectedModule = null;

    private static string ModuleLabel(InvestmentApiClient.InvestmentModuleViewModel module) => module switch
    {
        InvestmentApiClient.InvestmentModuleViewModel.Gac => "GAC",
        InvestmentApiClient.InvestmentModuleViewModel.RiseOfEmpire => "RotE",
        InvestmentApiClient.InvestmentModuleViewModel.Conquest => "Conquista",
        InvestmentApiClient.InvestmentModuleViewModel.Era => "Era",
        InvestmentApiClient.InvestmentModuleViewModel.Coliseum => "Coliseo",
        _ => module.ToString()
    };

    private static string InventoryKindLabel(InvestmentApiClient.InventoryResourceKindViewModel kind) => kind switch
    {
        InvestmentApiClient.InventoryResourceKindViewModel.Currency => "Moneda",
        InvestmentApiClient.InventoryResourceKindViewModel.RelicMaterial => "Materiales de reliquia",
        InvestmentApiClient.InventoryResourceKindViewModel.SignalData => "Signal Data",
        _ => kind.ToString()
    };

    private static string ImpactTarget(InvestmentApiClient.ModuleImpactViewModel impact)
    {
        var values = new List<string>(2);
        if (impact.TargetRelicTier is int relic) values.Add($"Objetivo R{relic}");
        if (impact.TargetStars is int stars) values.Add($"Objetivo {stars}★");
        return string.Join(" · ", values);
    }

    private static string PriorityCss(string priority) => priority switch { "Crítica" => "critical", "Alta" => "high", "Media" => "medium", _ => "opportunity" };
    private static string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));

    private static string AgeLabel(DateTimeOffset updatedAtUtc)
    {
        TimeSpan age = DateTimeOffset.UtcNow - updatedAtUtc;
        if (age < TimeSpan.FromMinutes(1)) return "ahora";
        if (age < TimeSpan.FromHours(1)) return $"{Math.Max(1, (int)age.TotalMinutes)} min";
        if (age < TimeSpan.FromDays(1)) return $"{Math.Max(1, (int)age.TotalHours)} h";
        return $"{Math.Max(1, (int)age.TotalDays)} d";
    }
}
