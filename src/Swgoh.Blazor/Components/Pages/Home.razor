@page "/"
@implements IDisposable
@rendermode InteractiveServer
@using Swgoh.Blazor.State
@inject PlayerApiClient PlayerClient
@inject GacPlannerApiClient PlannerClient
@inject ConquestApiClient ConquestClient
@inject ConquestDailyPlanApiClient DailyPlanClient
@inject PlayerSessionState Session
@inject PlayerContextService PlayerContext

<PageTitle>Qué hago ahora · SWGOH Assistant</PageTitle>

@if (_loading && _player is null)
{
    <UiLoadingState Title="Buscando tu siguiente acción"
                    Description="Roster, GAC, Conquista, stamina, energía y objetivo de recompensa" />
}
else if (_player is null)
{
    <section class="home-onboarding">
        <div class="home-onboarding-copy">
            <span class="ui-kicker">SWGOH Assistant</span>
            <h1>Abre el juego sabiendo qué hacer primero.</h1>
            <p>
                El asistente cruza tu ronda de Gran Arena con el plan diario de Conquista para darte una única
                acción prioritaria, no otro dashboard que tengas que interpretar.
            </p>
        </div>

        <UiCard Kicker="Empezar" Title="Conecta tu perfil" Variant="accent">
            <form class="home-player-form" @onsubmit="LoadAsync" @onsubmit:preventDefault>
                <label>
                    Ally Code
                    <input inputmode="numeric" autocomplete="off" placeholder="123 456 789" @bind="_allyCode" />
                </label>
                <button class="primary-button" type="submit" disabled="@_loading">
                    @(_loading ? "Analizando…" : "Decirme qué hacer")
                </button>
            </form>
            @if (_error is not null)
            {
                <p class="home-inline-error" role="alert">@_error</p>
            }
        </UiCard>
    </section>
}
else
{
    <section class="home-assistant">
        <UiPageHeader Kicker="Asistente operativo"
                      Title="@($"Hola, {_player.Name}")"
                      Description="@HeaderDescription">
            <Actions>
                <button class="ghost-button" type="button" @onclick="ShowPlayerPicker">Cambiar jugador</button>
            </Actions>
        </UiPageHeader>

        @if (_gacLoading)
        {
            <UiLoadingState Title="Buscando rival de Gran Arena…"
                            Description="Puedes consultar tu perfil mientras se completa la búsqueda. Los resultados aparecerán automáticamente." />
        }
        else if (_gacMessage is not null)
        {
            <p role="status">@_gacMessage</p>
        }

        @if (_showPlayerPicker)
        {
            <UiCard Kicker="Jugador activo" Title="Cambiar Ally Code" Compact="true" Class="home-player-picker">
                <form class="home-player-form" @onsubmit="LoadAsync" @onsubmit:preventDefault>
                    <label>
                        Nuevo Ally Code
                        <input inputmode="numeric" autocomplete="off" @bind="_allyCode" />
                    </label>
                    <button class="primary-button" type="submit" disabled="@_loading">Cargar</button>
                    <button class="ghost-button" type="button" @onclick="HidePlayerPicker">Cancelar</button>
                </form>
                @if (_error is not null)
                {
                    <p class="home-inline-error" role="alert">@_error</p>
                }
            </UiCard>
        }

        <UiActionCard Kicker="Qué hago ahora"
                      Title="@PrimaryActionTitle"
                      Description="@PrimaryActionDescription"
                      Tone="@PrimaryActionTone"
                      Badge="@PrimaryActionBadge"
                      Href="@PrimaryActionHref"
                      ActionText="@PrimaryActionText">
            @switch (PrimaryAction)
            {
                case HomeActionKind.GacExecute:
                    @if (PlannedGacAttack is not null)
                    {
                        GacPlannerApiClient.AttackViewModel attack = PlannedGacAttack;
                        GacPlannerApiClient.VisibleDefenseViewModel? defense = PlannedGacDefense;
                        <div class="home-action-matchup">
                            <div class="home-action-side">
                                <span>Defensa rival</span>
                                <h3>@(defense?.Label ?? defense?.Squad.Leader.Name ?? "Defensa visible")</h3>
                                @if (defense is not null)
                                {
                                    <div class="home-action-squad">
                                        @{ bool rivalLeader = true; }
                                        @foreach (GacPlannerApiClient.PlannerUnitViewModel unit in defense.Squad.AllUnits)
                                        {
                                            <RichUnitPortrait Name="@unit.Name"
                                                              ThumbnailName="@unit.ThumbnailName"
                                                              RelicTier="@unit.RelicTier"
                                                              IsLeader="@rivalLeader"
                                                              Compact="true" />
                                            rivalLeader = false;
                                        }
                                    </div>
                                }
                            </div>
                            <span class="home-action-arrow" aria-hidden="true">→</span>
                            <div class="home-action-side">
                                <span>Tu ataque · intento #@attack.Attempt</span>
                                <h3>@attack.Team.Name</h3>
                                <div class="home-action-squad">
                                    @{ bool ownLeader = true; }
                                    @foreach (GacPlannerApiClient.PlannerUnitViewModel unit in attack.Team.Squad.AllUnits)
                                    {
                                        <RichUnitPortrait Name="@unit.Name"
                                                          ThumbnailName="@unit.ThumbnailName"
                                                          RelicTier="@unit.RelicTier"
                                                          IsLeader="@ownLeader"
                                                          Compact="true" />
                                        ownLeader = false;
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="home-action-facts">
                            <span>Zona <strong>@(defense?.Zone ?? "—")</strong></span>
                            <span>Rival <strong>@(_planner?.Opponent.OpponentName ?? "—")</strong></span>
                            <span>Después <strong>registrar resultado y recalcular</strong></span>
                        </div>
                    }
                    break;

                case HomeActionKind.GacPlan:
                    @if (TopGacRecommendation is not null)
                    {
                        GacPlannerApiClient.OptimizationRecommendationViewModel recommendation = TopGacRecommendation;
                        GacPlannerApiClient.TeamPresetViewModel? team = GacRecommendedPreset;
                        GacPlannerApiClient.VisibleDefenseViewModel? defense = GacRecommendedDefense;
                        <div class="home-action-matchup">
                            <div class="home-action-side">
                                <span>Objetivo</span>
                                <h3>@recommendation.DefenseName</h3>
                                @if (defense is not null)
                                {
                                    <div class="home-action-squad">
                                        @{ bool rivalLeader = true; }
                                        @foreach (GacPlannerApiClient.PlannerUnitViewModel unit in defense.Squad.AllUnits)
                                        {
                                            <RichUnitPortrait Name="@unit.Name"
                                                              ThumbnailName="@unit.ThumbnailName"
                                                              RelicTier="@unit.RelicTier"
                                                              IsLeader="@rivalLeader"
                                                              Compact="true" />
                                            rivalLeader = false;
                                        }
                                    </div>
                                }
                            </div>
                            <span class="home-action-arrow" aria-hidden="true">→</span>
                            <div class="home-action-side">
                                <span>Counter recomendado</span>
                                <h3>@recommendation.TeamName</h3>
                                @if (team is not null)
                                {
                                    <div class="home-action-squad">
                                        @{ bool ownLeader = true; }
                                        @foreach (GacPlannerApiClient.PlannerUnitViewModel unit in team.Squad.AllUnits)
                                        {
                                            <RichUnitPortrait Name="@unit.Name"
                                                              ThumbnailName="@unit.ThumbnailName"
                                                              RelicTier="@unit.RelicTier"
                                                              IsLeader="@ownLeader"
                                                              Compact="true" />
                                            ownLeader = false;
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="home-action-facts">
                            <span>Score <strong>@recommendation.Score.ToString("0.#")</strong></span>
                            <span>Confianza <strong>@ConfidenceLabel(recommendation.Confidence)</strong></span>
                            @if (recommendation.WinRate is decimal winRate)
                            {
                                <span>Histórico <strong>@Percent(winRate)</strong></span>
                            }
                            @if (recommendation.PersonalSamples > 0)
                            {
                                <span>Tu histórico <strong>@recommendation.PersonalWins/@recommendation.PersonalSamples</strong></span>
                            }
                        </div>
                    }
                    break;

                case HomeActionKind.ConquestRewardPush:
                case HomeActionKind.ConquestBattles:
                    @if (_dailyPlan is not null)
                    {
                        <div class="home-action-sequence">
                            <span>Secuencia inmediata</span>
                            <div class="home-battle-list">
                                @foreach (ConquestDailyPlanApiClient.DailyPlanStepViewModel step in _dailyPlan.Steps.Take(ImmediateConquestBattles))
                                {
                                    <div class="home-battle-row">
                                        <span class="home-battle-number">@step.BattleNumber</span>
                                        <div>
                                            <strong>@string.Join(" · ", step.Team.Take(3).Select(unit => unit.Name))</strong>
                                            <small>@step.FeatProgress.Count hazaña(s) avanzan · +@step.RewardPointsEarned pts</small>
                                        </div>
                                        <span class="home-battle-stamina">STA @step.AverageStaminaBefore.ToString("0") → @step.AverageStaminaAfter.ToString("0")</span>
                                    </div>
                                }
                            </div>
                        </div>
                        @if (_dailyPlan.Steps.FirstOrDefault() is ConquestDailyPlanApiClient.DailyPlanStepViewModel firstStep)
                        {
                            <div class="home-action-squad">
                                @{ bool conquestLeader = true; }
                                @foreach (ConquestDailyPlanApiClient.UnitViewModel unit in firstStep.Team)
                                {
                                    <RichUnitPortrait Name="@unit.Name"
                                                      ThumbnailName="@unit.ThumbnailName"
                                                      RelicTier="@unit.RelicTier"
                                                      Speed="@unit.Speed"
                                                      IsLeader="@conquestLeader"
                                                      Compact="true" />
                                    conquestLeader = false;
                                }
                            </div>
                        }
                        <div class="home-action-facts">
                            <span>Energía <strong>@EnergySummary</strong></span>
                            <span>Stamina media <strong>@ConquestStaminaSummary</strong></span>
                            @if (RewardPointsMissing > 0)
                            {
                                <span>Para @RewardTargetLabel <strong>@RewardPointsMissing pts</strong></span>
                            }
                        </div>
                    }
                    break;

                case HomeActionKind.ConquestWaitStamina:
                    <div class="home-action-recovery">
                        <span>Prioridad de recuperación</span>
                        <div class="home-action-recovery-grid">
                            @foreach (ConquestDailyPlanApiClient.RecoveryUnitViewModel unit in (_dailyPlan?.RecoveryPriority ?? []).Take(5))
                            {
                                <div class="home-recovery-unit">
                                    <strong>@unit.Name</strong>
                                    <small>@unit.FinalStamina% stamina · reserva @unit.ReserveFloorPercent%</small>
                                </div>
                            }
                        </div>
                    </div>
                    break;

                case HomeActionKind.ConquestWaitEnergy:
                    <div class="home-action-facts">
                        <span>Energía disponible <strong>@(_dailyPlan?.AvailableEnergy?.ToString() ?? "sin dato")</strong></span>
                        <span>Coste por combate <strong>@(_dailyPlan?.EnergyCostPerBattle ?? _conquest?.EnergyCostPerBattle ?? 0)</strong></span>
                        @if (RewardPointsMissing > 0)
                        {
                            <span>Objetivo pendiente <strong>@RewardPointsMissing pts</strong></span>
                        }
                    </div>
                    break;

                case HomeActionKind.ConquestOptimize:
                    @if (TopConquestRecommendation is not null)
                    {
                        ConquestApiClient.TeamViewModel recommendation = TopConquestRecommendation;
                        <div class="home-action-squad">
                            @{ bool conquestLeader = true; }
                            @foreach (ConquestApiClient.UnitViewModel unit in recommendation.Team)
                            {
                                <RichUnitPortrait Name="@unit.Name"
                                                  ThumbnailName="@unit.ThumbnailName"
                                                  RelicTier="@unit.RelicTier"
                                                  Speed="@unit.Speed"
                                                  IsLeader="@conquestLeader"
                                                  Compact="true" />
                                conquestLeader = false;
                            }
                        </div>
                        <div class="home-action-facts">
                            <span>Hazañas <strong>@recommendation.AdvancesFeats.Count</strong></span>
                            <span>Stamina <strong>@recommendation.AverageStamina.ToString("0") → @recommendation.ExpectedPostBattleAverageStamina.ToString("0")</strong></span>
                            <span>Score <strong>@recommendation.Score.ToString("0.#")</strong></span>
                        </div>
                    }
                    break;

                default:
                    <div class="home-action-facts">
                        <span>GAC <strong>@(_planner is null ? "sin ronda" : $"{GacPendingDefenses} pendientes")</strong></span>
                        <span>Conquista <strong>@(_conquest is null ? "sin plan" : $"{_conquest.EarnedFeatPoints} pts")</strong></span>
                        <span>Roster <strong>@RelativeUpdated(_player.UpdatedAtUtc)</strong></span>
                    </div>
                    break;
            }
        </UiActionCard>

        <InvestmentTargetPlan AllyCode="_player.AllyCode" Compact="true" />

        @if (ActionQueue.Count > 0)
        {
            <section class="home-queue" aria-labelledby="home-queue-title">
                <div class="home-section-heading">
                    <div>
                        <span class="ui-kicker">Después</span>
                        <h2 id="home-queue-title">Lo siguiente, sin perder el foco</h2>
                    </div>
                    <p>Solo mostramos tareas que pueden cambiar una decisión.</p>
                </div>
                <div class="home-queue-list">
                    @{ int queueIndex = 1; }
                    @foreach (HomeQueueItem item in ActionQueue)
                    {
                        <a class="home-queue-item" href="@item.Href">
                            <span class="home-queue-index">@queueIndex.ToString("00")</span>
                            <span><strong>@item.Title</strong><small>@item.Description</small></span>
                            <span class="home-queue-arrow" aria-hidden="true">→</span>
                        </a>
                        queueIndex++;
                    }
                </div>
            </section>
        }

        <section aria-labelledby="home-context-title">
            <div class="home-section-heading">
                <div>
                    <span class="ui-kicker">Contexto mínimo</span>
                    <h2 id="home-context-title">Lo necesario para confiar en la prioridad</h2>
                </div>
                <p class="home-data-note">Perfil @_player.GalacticPower.ToString("N0") GP · actualizado @RelativeUpdated(_player.UpdatedAtUtc)</p>
            </div>
            <div class="home-context-strip">
                <UiMetric Label="Gran Arena" Value="@GacContextValue" Hint="@GacContextHint" Tone="accent" />
                <UiMetric Label="Conquista" Value="@ConquestContextValue" Hint="@ConquestContextHint" Tone="success" />
                <UiMetric Label="Datos" Value="@DataContextValue" Hint="@DataContextHint" Tone="@DataMetricTone" />
            </div>
        </section>
    </section>
}
